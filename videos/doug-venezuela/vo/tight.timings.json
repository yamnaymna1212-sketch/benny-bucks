[
 {
  "line": 0,
  "text": "Why Doug pay four dollars for gas in America...",
  "start": 0.0,
  "end": 2.62
 },
 {
  "line": 1,
  "text": "but thirteen cents in Venezuela?",
  "start": 2.79,
  "end": 4.7
 },
 {
  "line": 2,
  "text": "Same gas.",
  "start": 4.87,
  "end": 5.74
 },
 {
  "line": 3,
  "text": "This is Doug.",
  "start": 6.14,
  "end": 7.09
 },
 {
  "line": 4,
  "text": "Doug drive snowmobile.",
  "start": 7.26,
  "end": 8.55
 },
 {
  "line": 5,
  "text": "Snowmobile drink gas.",
  "start": 8.72,
  "end": 10.44
 },
 {
  "line": 6,
  "text": "Every day.",
  "start": 10.61,
  "end": 11.11
 },
 {
  "line": 7,
  "text": "Gas come from oil.",
  "start": 11.28,
  "end": 12.4
 },
 {
  "line": 8,
  "text": "Oil come from ground.",
  "start": 12.57,
  "end": 13.77
 },
 {
  "line": 9,
  "text": "Venezuela sit on biggest oil pile in the world.",
  "start": 13.94,
  "end": 17.11
 },
 {
  "line": 10,
  "text": "Bigger than America.",
  "start": 17.28,
  "end": 18.17
 },
 {
  "line": 11,
  "text": "But Venezuela do one more trick.",
  "start": 18.34,
  "end": 20.4
 },
 {
  "line": 12,
  "text": "Gas cost a lot to make.",
  "start": 20.57,
  "end": 21.92
 },
 {
  "line": 13,
  "text": "Boss Bear sell it for almost nothing.",
  "start": 22.09,
  "end": 24.16
 },
 {
  "line": 14,
  "text": "Boss Bear pay the rest.",
  "start": 24.33,
  "end": 25.58
 },
 {
  "line": 15,
  "text": "This is called subsidy.",
  "start": 25.75,
  "end": 26.89
 },
 {
  "line": 16,
  "text": "In America,",
  "start": 27.29,
  "end": 27.94
 },
 {
  "line": 17,
  "text": "no Boss Bear.",
  "start": 28.11,
  "end": 28.89
 },
 {
  "line": 18,
  "text": "Larry own refinery.",
  "start": 29.06,
  "end": 30.24
 },
 {
  "line": 19,
  "text": "Larry want profit.#0 Larry want profit.#1",
  "start": 30.41,
  "end": 31.4
 },
 {
  "line": 20,
  "text": "And Tax Gull take a piece.",
  "start": 31.57,
  "end": 32.93
 },
 {
  "line": 21,
  "text": "Every gallon.",
  "start": 33.1,
  "end": 33.84
 },
 {
  "line": 22,
  "text": "Doug poor.",
  "start": 34.01,
  "end": 34.62
 },
 {
  "line": 23,
  "text": "In real life, American gas is about four forty.#0 In real life, American gas is about four forty.#1",
  "start": 35.07,
  "end": 38.23
 },
 {
  "line": 24,
  "text": "Venezuela is thirteen cents.",
  "start": 38.4,
  "end": 39.5
 },
 {
  "line": 25,
  "text": "Doug move to Venezuela.",
  "start": 39.67,
  "end": 41.03
 },
 {
  "line": 26,
  "text": "Doug fill whole tank for two dollars.",
  "start": 41.2,
  "end": 43.33
 },
 {
  "line": 27,
  "text": "Doug happy.",
  "start": 43.5,
  "end": 44.09
 },
 {
  "line": 28,
  "text": "Then Doug see the line.",
  "start": 44.54,
  "end": 45.73
 },
 {
  "line": 29,
  "text": "Boss Bear pay for everyone's gas.",
  "start": 45.9,
  "end": 47.75
 },
 {
  "line": 30,
  "text": "Boss Bear run out of money.",
  "start": 47.92,
  "end": 49.07
 },
 {
  "line": 31,
  "text": "Refinery break.",
  "start": 49.24,
  "end": 50.12
 },
 {
  "line": 32,
  "text": "Cheap gas.",
  "start": 50.29,
  "end": 51.01
 },
 {
  "line": 33,
  "text": "No gas.",
  "start": 51.18,
  "end": 51.87
 },
 {
  "line": 34,
  "text": "Doug angry.",
  "start": 52.04,
  "end": 52.78
 },
 {
  "line": 35,
  "text": "Three days later,",
  "start": 53.23,
  "end": 54.01
 },
 {
  "line": 36,
  "text": "Doug get gas.",
  "start": 54.18,
  "end": 55.18
 },
 {
  "line": 37,
  "text": "Then Doug remember.",
  "start": 55.35,
  "end": 56.28
 },
 {
  "line": 38,
  "text": "Venezuela have no snow.",
  "start": 56.45,
  "end": 58.06
 },
 {
  "line": 39,
  "text": "Would you wait in line for thirteen-cent gas?",
  "start": 58.23,
  "end": 60.33
 },
 {
  "line": 40,
  "text": "Tell Doug in the comments.",
  "start": 60.5,
  "end": 61.7
 }
]