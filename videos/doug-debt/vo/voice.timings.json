[
 {
  "voice": "am_puck",
  "text": "Why? Poor Doug: minus 1,800 dollars!",
  "start": 0.0,
  "end": 2.45
 },
 {
  "voice": "am_puck",
  "text": "Rich Doug: plus 3,000 dollars!",
  "start": 2.48,
  "end": 4.26
 },
 {
  "voice": "am_puck",
  "text": "Both use credit cards!",
  "start": 4.34,
  "end": 5.44
 },
 {
  "voice": "am_puck",
  "text": "This is Doug. Doug have one credit card!",
  "start": 5.47,
  "end": 7.25
 },
 {
  "voice": "am_puck",
  "text": "Card is magic! Doug buy now. Doug pay later!",
  "start": 7.28,
  "end": 9.27
 },
 {
  "voice": "am_puck",
  "text": "Poor Doug buy TV! Buy sled! Buy everything!",
  "start": 9.3,
  "end": 11.51
 },
 {
  "voice": "am_puck",
  "text": "Doug feel rich!",
  "start": 11.54,
  "end": 12.37
 },
 {
  "voice": "am_puck",
  "text": "Then bill come. 8,200 dollars!",
  "start": 12.4,
  "end": 14.62
 },
 {
  "voice": "am_puck",
  "text": "Doug pay only minimum. 200 dollars.",
  "start": 14.65,
  "end": 16.78
 },
 {
  "voice": "am_puck",
  "text": "Minimum look small. Minimum is trap!",
  "start": 16.81,
  "end": 18.52
 },
 {
  "voice": "am_puck",
  "text": "Fox the banker smile.",
  "start": 18.55,
  "end": 19.58
 },
 {
  "voice": "am_puck",
  "text": "Because card charge 22 percent interest!",
  "start": 19.61,
  "end": 21.76
 },
 {
  "voice": "am_puck",
  "text": "If Doug not pay all, debt grow!",
  "start": 21.79,
  "end": 23.04
 },
 {
  "voice": "am_puck",
  "text": "Doug pay, pay, pay! Debt still there!",
  "start": 23.07,
  "end": 24.61
 },
 {
  "voice": "am_puck",
  "text": "Every year, 1,800 dollars go to Fox. For nothing!",
  "start": 24.64,
  "end": 27.98
 },
 {
  "voice": "am_puck",
  "text": "That is 180 fish! Gone!",
  "start": 28.01,
  "end": 29.49
 },
 {
  "voice": "am_puck",
  "text": "This is called interest!",
  "start": 29.52,
  "end": 30.55
 },
 {
  "voice": "am_puck",
  "text": "Doug poor.",
  "start": 30.58,
  "end": 31.17
 },
 {
  "voice": "am_puck",
  "text": "Now rich Doug! Gold card!",
  "start": 31.37,
  "end": 32.52
 },
 {
  "voice": "am_puck",
  "text": "Rich Doug buy food, gas, travel. 150,000 dollars a year!",
  "start": 32.55,
  "end": 36.32
 },
 {
  "voice": "am_puck",
  "text": "But rich Doug pay full bill. Every single month!",
  "start": 36.35,
  "end": 38.58
 },
 {
  "voice": "am_puck",
  "text": "Zero interest! Fox get nothing!",
  "start": 38.61,
  "end": 40.08
 },
 {
  "voice": "am_puck",
  "text": "And card pay Doug back. 2 percent!",
  "start": 40.11,
  "end": 41.69
 },
 {
  "voice": "am_puck",
  "text": "3,000 dollars! Free!",
  "start": 41.72,
  "end": 42.95
 },
 {
  "voice": "am_puck",
  "text": "That is 300 fish! For shopping!",
  "start": 42.98,
  "end": 44.72
 },
 {
  "voice": "am_puck",
  "text": "This is called cash back!",
  "start": 44.75,
  "end": 45.8
 },
 {
  "voice": "am_puck",
  "text": "Doug happy.",
  "start": 45.83,
  "end": 46.49
 },
 {
  "voice": "am_puck",
  "text": "In real life, Americans owe 6,610 dollars on credit cards, on average!",
  "start": 46.69,
  "end": 51.73
 },
 {
  "voice": "am_puck",
  "text": "Average card rate? About 22 percent!",
  "start": 51.76,
  "end": 53.79
 },
 {
  "voice": "am_puck",
  "text": "So poor Doug pay Fox. And Fox pay rich Doug!",
  "start": 53.82,
  "end": 56.18
 },
 {
  "voice": "am_puck",
  "text": "Same Fox. Different Doug!",
  "start": 56.21,
  "end": 57.48
 },
 {
  "voice": "am_puck",
  "text": "Card is not the problem. Minimum is the problem!",
  "start": 57.51,
  "end": 59.85
 },
 {
  "voice": "am_puck",
  "text": "Would you pay full bill, or minimum? Comment below!",
  "start": 59.88,
  "end": 62.15
 }
]