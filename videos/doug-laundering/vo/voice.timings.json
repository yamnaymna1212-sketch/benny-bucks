[
 {
  "voice": "am_michael",
  "text": "How money laundering make Doug poor?",
  "start": 0.0,
  "end": 1.83
 },
 {
  "voice": "am_michael",
  "text": "Doug had one million dollars.",
  "start": 1.95,
  "end": 3.66
 },
 {
  "voice": "am_michael",
  "text": "This is Doug.",
  "start": 3.78,
  "end": 4.69
 },
 {
  "voice": "am_michael",
  "text": "Doug have big bag of fish.",
  "start": 4.76,
  "end": 6.31
 },
 {
  "voice": "am_michael",
  "text": "Fish come from Larry.",
  "start": 6.38,
  "end": 7.63
 },
 {
  "voice": "am_michael",
  "text": "Larry sell stolen sleds.",
  "start": 7.7,
  "end": 9.32
 },
 {
  "voice": "am_michael",
  "text": "Fish is dirty.",
  "start": 9.39,
  "end": 10.41
 },
 {
  "voice": "am_michael",
  "text": "Not dirty dirty.",
  "start": 10.48,
  "end": 11.59
 },
 {
  "voice": "am_michael",
  "text": "Crime dirty.",
  "start": 11.66,
  "end": 12.53
 },
 {
  "voice": "am_michael",
  "text": "Doug go to bank.",
  "start": 12.6,
  "end": 13.66
 },
 {
  "voice": "am_michael",
  "text": "Fox ask: where fish come from?",
  "start": 13.73,
  "end": 15.61
 },
 {
  "voice": "am_michael",
  "text": "Doug cannot say. Doug sweat.",
  "start": 15.68,
  "end": 17.38
 },
 {
  "voice": "am_michael",
  "text": "So Doug open snowmobile wash.",
  "start": 17.45,
  "end": 19.61
 },
 {
  "voice": "am_michael",
  "text": "Nobody come.",
  "start": 19.68,
  "end": 20.61
 },
 {
  "voice": "am_michael",
  "text": "But every night, Doug write:",
  "start": 20.68,
  "end": 22.11
 },
 {
  "voice": "am_michael",
  "text": "one hundred customers today.",
  "start": 22.18,
  "end": 23.89
 },
 {
  "voice": "am_michael",
  "text": "Dirty fish go in cash box.",
  "start": 23.96,
  "end": 25.8
 },
 {
  "voice": "am_michael",
  "text": "Clean fish come out.",
  "start": 25.87,
  "end": 27.02
 },
 {
  "voice": "am_michael",
  "text": "Now fish have a story.",
  "start": 27.09,
  "end": 28.41
 },
 {
  "voice": "am_michael",
  "text": "Bank say: thank you, penguin.",
  "start": 28.48,
  "end": 30.09
 },
 {
  "voice": "am_michael",
  "text": "This is called money laundering.",
  "start": 30.16,
  "end": 31.9
 },
 {
  "voice": "am_michael",
  "text": "Washing money. Not snowmobiles.",
  "start": 31.97,
  "end": 34.03
 },
 {
  "voice": "am_michael",
  "text": "Doug rich.",
  "start": 34.15,
  "end": 34.97
 },
 {
  "voice": "am_michael",
  "text": "In real life, about three hundred billion dollars of crime money is made in America every year.",
  "start": 35.32,
  "end": 41.27
 },
 {
  "voice": "am_michael",
  "text": "And it all needs washing.",
  "start": 41.34,
  "end": 42.83
 },
 {
  "voice": "am_michael",
  "text": "Doug buy mansion.",
  "start": 42.9,
  "end": 43.99
 },
 {
  "voice": "am_michael",
  "text": "Doug buy gold sled.",
  "start": 44.06,
  "end": 45.41
 },
 {
  "voice": "am_michael",
  "text": "Life is good.",
  "start": 45.48,
  "end": 46.43
 },
 {
  "voice": "am_michael",
  "text": "Then Tax Gull look at the wash.",
  "start": 46.5,
  "end": 48.27
 },
 {
  "voice": "am_michael",
  "text": "Zero soap. Zero water.",
  "start": 48.34,
  "end": 50.16
 },
 {
  "voice": "am_michael",
  "text": "One million dollars.",
  "start": 50.23,
  "end": 51.49
 },
 {
  "voice": "am_michael",
  "text": "Tax Gull take mansion. Take gold sled. Take every fish.",
  "start": 51.56,
  "end": 55.05
 },
 {
  "voice": "am_michael",
  "text": "Doug washed fish.",
  "start": 55.12,
  "end": 56.26
 },
 {
  "voice": "am_michael",
  "text": "Now Doug wash dishes. In jail.",
  "start": 56.33,
  "end": 58.34
 },
 {
  "voice": "am_michael",
  "text": "Doug poor.",
  "start": 58.46,
  "end": 59.22
 },
 {
  "voice": "am_michael",
  "text": "What business would Doug pick next?",
  "start": 59.57,
  "end": 61.39
 },
 {
  "voice": "am_michael",
  "text": "Tell Doug in the comments.",
  "start": 61.46,
  "end": 62.81
 }
]