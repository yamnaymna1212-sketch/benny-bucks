[
 {
  "voice": "am_puck",
  "text": "Doug fill tank in America.",
  "start": 0.0,
  "end": 1.28
 },
 {
  "voice": "am_puck",
  "text": "Sixty-six dollars.",
  "start": 1.4,
  "end": 2.48
 },
 {
  "voice": "am_puck",
  "text": "Doug friend fill tank in Venezuela.",
  "start": 2.78,
  "end": 4.45
 },
 {
  "voice": "am_puck",
  "text": "Two dollars.",
  "start": 4.57,
  "end": 5.28
 },
 {
  "voice": "am_puck",
  "text": "So what the real difference?",
  "start": 5.58,
  "end": 6.68
 },
 {
  "voice": "am_puck",
  "text": "Three reasons.",
  "start": 6.88,
  "end": 7.63
 },
 {
  "voice": "am_puck",
  "text": "Reason one.",
  "start": 7.98,
  "end": 8.69
 },
 {
  "voice": "am_puck",
  "text": "Gas come from oil. Oil come from ground.",
  "start": 8.84,
  "end": 10.72
 },
 {
  "voice": "am_puck",
  "text": "Venezuela sit on biggest oil pile in the world.",
  "start": 10.87,
  "end": 13.3
 },
 {
  "voice": "am_puck",
  "text": "Bigger than America.",
  "start": 13.4,
  "end": 14.32
 },
 {
  "voice": "am_puck",
  "text": "Lot of oil. Close to home. Gas cheap to get.",
  "start": 14.47,
  "end": 16.63
 },
 {
  "voice": "am_puck",
  "text": "Reason two.",
  "start": 16.93,
  "end": 17.74
 },
 {
  "voice": "am_puck",
  "text": "Boss Bear run Venezuela.",
  "start": 17.89,
  "end": 19.14
 },
 {
  "voice": "am_puck",
  "text": "Gas cost real money.",
  "start": 19.26,
  "end": 20.36
 },
 {
  "voice": "am_puck",
  "text": "Boss Bear say: pay two dollars. I pay rest.",
  "start": 20.46,
  "end": 22.84
 },
 {
  "voice": "am_puck",
  "text": "This is called subsidy.",
  "start": 22.99,
  "end": 24.14
 },
 {
  "voice": "am_puck",
  "text": "Doug jealous.",
  "start": 24.44,
  "end": 25.19
 },
 {
  "voice": "am_puck",
  "text": "Reason three.",
  "start": 25.64,
  "end": 26.43
 },
 {
  "voice": "am_puck",
  "text": "In America, no Boss Bear. Doug pay full price.",
  "start": 26.58,
  "end": 29.11
 },
 {
  "voice": "am_puck",
  "text": "Larry own refinery. Larry want profit.",
  "start": 29.23,
  "end": 31.35
 },
 {
  "voice": "am_puck",
  "text": "Doug pay for oil, refinery, truck, and tax.",
  "start": 31.47,
  "end": 33.75
 },
 {
  "voice": "am_puck",
  "text": "Tax Gull take a piece. Every gallon.",
  "start": 33.9,
  "end": 35.8
 },
 {
  "voice": "am_puck",
  "text": "Doug poor.",
  "start": 36.0,
  "end": 36.61
 },
 {
  "voice": "am_puck",
  "text": "In real life, America gas is about four forty a gallon.",
  "start": 37.06,
  "end": 40.11
 },
 {
  "voice": "am_puck",
  "text": "Venezuela is around thirteen cents.",
  "start": 40.21,
  "end": 41.98
 },
 {
  "voice": "am_puck",
  "text": "Over thirty times cheaper.",
  "start": 42.28,
  "end": 43.51
 },
 {
  "voice": "am_puck",
  "text": "Friend happy. Then friend see the line.",
  "start": 43.81,
  "end": 45.51
 },
 {
  "voice": "am_puck",
  "text": "Boss Bear pay for everyone. Boss Bear run out of fish.",
  "start": 45.66,
  "end": 48.42
 },
 {
  "voice": "am_puck",
  "text": "No fish. No fix. Refinery break.",
  "start": 48.57,
  "end": 50.56
 },
 {
  "voice": "am_puck",
  "text": "Cheap gas. No gas.",
  "start": 50.76,
  "end": 51.82
 },
 {
  "voice": "am_puck",
  "text": "Friend angry.",
  "start": 52.12,
  "end": 52.85
 },
 {
  "voice": "am_puck",
  "text": "Doug pay sixty-six. But no line.",
  "start": 53.25,
  "end": 55.14
 },
 {
  "voice": "am_puck",
  "text": "Doug happy.",
  "start": 55.44,
  "end": 56.14
 },
 {
  "voice": "am_puck",
  "text": "Same tank. Different world.",
  "start": 56.54,
  "end": 57.82
 },
 {
  "voice": "am_puck",
  "text": "Would you take cheap gas with a line, or pay more and go? Tell Doug.",
  "start": 58.12,
  "end": 61.41
 }
]