[
 {
  "voice": "am_puck",
  "text": "Why does this car cost thirteen bucks to fill up...",
  "start": 0.0,
  "end": 2.28
 },
 {
  "voice": "am_puck",
  "text": "and this one a hundred twenty-eight?",
  "start": 2.31,
  "end": 3.54
 },
 {
  "voice": "am_puck",
  "text": "Same three hundred miles.",
  "start": 3.59,
  "end": 4.76
 },
 {
  "voice": "am_puck",
  "text": "This is Doug. Doug want fast car.",
  "start": 4.88,
  "end": 6.53
 },
 {
  "voice": "am_puck",
  "text": "Larry sell two cars. Same speed.",
  "start": 6.59,
  "end": 8.43
 },
 {
  "voice": "am_puck",
  "text": "Red car drink gas.",
  "start": 8.49,
  "end": 9.52
 },
 {
  "voice": "am_puck",
  "text": "Gas cost five dollars a gallon.",
  "start": 9.56,
  "end": 11.04
 },
 {
  "voice": "am_puck",
  "text": "White car drink electricity. From the wall. Like phone.",
  "start": 11.1,
  "end": 13.72
 },
 {
  "voice": "am_puck",
  "text": "Doug fill red car.",
  "start": 13.78,
  "end": 14.75
 },
 {
  "voice": "am_puck",
  "text": "One hundred twenty-eight dollars.",
  "start": 14.79,
  "end": 16.12
 },
 {
  "voice": "am_puck",
  "text": "Doug poor.",
  "start": 16.32,
  "end": 16.92
 },
 {
  "voice": "am_puck",
  "text": "Why? Gas engine burn gas.",
  "start": 17.22,
  "end": 18.62
 },
 {
  "voice": "am_puck",
  "text": "Boom, boom, boom.",
  "start": 18.66,
  "end": 19.47
 },
 {
  "voice": "am_puck",
  "text": "Four dollars of gas... only one dollar push the wheels.",
  "start": 19.53,
  "end": 21.95
 },
 {
  "voice": "am_puck",
  "text": "Three dollars become heat.",
  "start": 21.99,
  "end": 23.18
 },
 {
  "voice": "am_puck",
  "text": "Engine get hot. Doug pay for hot.",
  "start": 23.24,
  "end": 24.95
 },
 {
  "voice": "am_puck",
  "text": "Electric motor waste almost nothing.",
  "start": 25.01,
  "end": 26.76
 },
 {
  "voice": "am_puck",
  "text": "Almost all push the wheels.",
  "start": 26.8,
  "end": 28.0
 },
 {
  "voice": "am_puck",
  "text": "This is called efficiency.",
  "start": 28.06,
  "end": 29.21
 },
 {
  "voice": "am_puck",
  "text": "And Tax Gull take a piece of every gallon.",
  "start": 29.33,
  "end": 31.27
 },
 {
  "voice": "am_puck",
  "text": "In real life, this car get thirteen miles per gallon.",
  "start": 31.33,
  "end": 33.85
 },
 {
  "voice": "am_puck",
  "text": "Electric car go about four miles on one kilowatt-hour.",
  "start": 33.89,
  "end": 36.87
 },
 {
  "voice": "am_puck",
  "text": "White car cost forty thousand dollars.",
  "start": 36.93,
  "end": 38.8
 },
 {
  "voice": "am_puck",
  "text": "Red car cost four hundred thousand.",
  "start": 38.84,
  "end": 40.56
 },
 {
  "voice": "am_puck",
  "text": "Doug pick white car.",
  "start": 40.62,
  "end": 41.58
 },
 {
  "voice": "am_puck",
  "text": "Doug charge at home, in igloo.",
  "start": 41.64,
  "end": 42.99
 },
 {
  "voice": "am_puck",
  "text": "Thirteen dollars.",
  "start": 43.03,
  "end": 43.86
 },
 {
  "voice": "am_puck",
  "text": "Doug happy.",
  "start": 44.06,
  "end": 44.77
 },
 {
  "voice": "am_puck",
  "text": "Every month, Doug save about three hundred fifty dollars.",
  "start": 45.07,
  "end": 47.76
 },
 {
  "voice": "am_puck",
  "text": "Then Doug use fast charger on road trip.",
  "start": 47.82,
  "end": 49.74
 },
 {
  "voice": "am_puck",
  "text": "Price triple. Forty dollars.",
  "start": 49.78,
  "end": 51.16
 },
 {
  "voice": "am_puck",
  "text": "Still cheaper than red car.",
  "start": 51.22,
  "end": 52.47
 },
 {
  "voice": "am_puck",
  "text": "Then winter come.",
  "start": 52.55,
  "end": 53.3
 },
 {
  "voice": "am_puck",
  "text": "Cold battery lose up to forty percent range.",
  "start": 53.34,
  "end": 55.54
 },
 {
  "voice": "am_puck",
  "text": "Doug charge again. And again.",
  "start": 55.6,
  "end": 57.0
 },
 {
  "voice": "am_puck",
  "text": "Doug live in snow.",
  "start": 57.06,
  "end": 57.91
 },
 {
  "voice": "am_puck",
  "text": "Doug angry.",
  "start": 58.11,
  "end": 58.8
 },
 {
  "voice": "am_puck",
  "text": "Team battery or team gas?",
  "start": 59.1,
  "end": 60.37
 },
 {
  "voice": "am_puck",
  "text": "Tell Doug in the comments.",
  "start": 60.41,
  "end": 61.48
 }
]