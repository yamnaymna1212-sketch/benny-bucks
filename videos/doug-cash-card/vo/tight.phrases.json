[
 {
  "line": 1,
  "text": "What is the difference between paying ten dollars with cash...",
  "start": 0.04,
  "end": 2.45
 },
 {
  "line": 1,
  "text": "and ten dollars with card?",
  "start": 2.6,
  "end": 3.83
 },
 {
  "line": 2,
  "text": "Same ten dollars.",
  "start": 4.2,
  "end": 5.03
 },
 {
  "line": 3,
  "text": "This is Doug.",
  "start": 5.18,
  "end": 6.06
 },
 {
  "line": 3,
  "text": "Doug have three hairs.",
  "start": 6.21,
  "end": 7.37
 },
 {
  "line": 3,
  "text": "Doug need haircut.",
  "start": 7.52,
  "end": 8.64
 },
 {
  "line": 4,
  "text": "Puffin cut Doug hair.",
  "start": 8.79,
  "end": 9.85
 },
 {
  "line": 4,
  "text": "Doug pay ten dollars.",
  "start": 10.0,
  "end": 11.27
 },
 {
  "line": 4,
  "text": "Cash.",
  "start": 11.42,
  "end": 11.79
 },
 {
  "line": 5,
  "text": "Puffin go buy fish at Seal shop.",
  "start": 11.94,
  "end": 13.52
 },
 {
  "line": 5,
  "text": "Puffin pay same ten dollars.",
  "start": 13.67,
  "end": 15.1
 },
 {
  "line": 6,
  "text": "Seal go wash sled at Larry car wash.",
  "start": 15.25,
  "end": 17.03
 },
 {
  "line": 6,
  "text": "Seal pay same ten dollars.",
  "start": 17.18,
  "end": 18.59
 },
 {
  "line": 7,
  "text": "Twenty people later...",
  "start": 18.74,
  "end": 19.58
 },
 {
  "line": 7,
  "text": "still ten dollars.",
  "start": 19.73,
  "end": 20.67
 },
 {
  "line": 8,
  "text": "Cash go round and round.",
  "start": 20.82,
  "end": 21.92
 },
 {
  "line": 8,
  "text": "Cash never shrink.",
  "start": 22.07,
  "end": 23.13
 },
 {
  "line": 9,
  "text": "Now Doug pay with card.",
  "start": 23.28,
  "end": 24.56
 },
 {
  "line": 10,
  "text": "Beep.",
  "start": 24.71,
  "end": 24.98
 },
 {
  "line": 10,
  "text": "Puffin get only nine dollars seventy-six.",
  "start": 25.13,
  "end": 26.67
 },
 {
  "line": 11,
  "text": "Twenty-four cents go to Fox the Banker.",
  "start": 26.82,
  "end": 28.17
 },
 {
  "line": 12,
  "text": "Puffin pay Seal with card.",
  "start": 28.32,
  "end": 29.36
 },
 {
  "line": 12,
  "text": "Beep.",
  "start": 29.51,
  "end": 29.88
 },
 {
  "line": 12,
  "text": "Fox take a cut.",
  "start": 30.03,
  "end": 30.72
 },
 {
  "line": 13,
  "text": "Seal pay Larry with card.",
  "start": 30.87,
  "end": 31.95
 },
 {
  "line": 13,
  "text": "Beep.",
  "start": 32.1,
  "end": 32.29
 },
 {
  "line": 13,
  "text": "Fox take a cut.",
  "start": 32.44,
  "end": 33.22
 },
 {
  "line": 14,
  "text": "Every beep, ten dollars get smaller.",
  "start": 33.37,
  "end": 34.96
 },
 {
  "line": 15,
  "text": "After twenty beeps?",
  "start": 35.11,
  "end": 35.99
 },
 {
  "line": 15,
  "text": "Ten dollars become six dollars twenty.",
  "start": 36.14,
  "end": 38.13
 },
 {
  "line": 16,
  "text": "Where is three dollars eighty?",
  "start": 38.28,
  "end": 39.59
 },
 {
  "line": 16,
  "text": "In Fox pocket.",
  "start": 39.74,
  "end": 40.68
 },
 {
  "line": 17,
  "text": "This is called swipe fee.",
  "start": 40.83,
  "end": 42.05
 },
 {
  "line": 18,
  "text": "Doug.",
  "start": 42.2,
  "end": 42.57
 },
 {
  "line": 19,
  "text": "In real life, America pay one hundred ninety-eight billion dollars in swipe fees.",
  "start": 43.04,
  "end": 46.63
 },
 {
  "line": 19,
  "text": "In one year.",
  "start": 46.78,
  "end": 47.47
 },
 {
  "line": 20,
  "text": "That is about fifty dollars every month.",
  "start": 47.62,
  "end": 49.28
 },
 {
  "line": 20,
  "text": "For every person.",
  "start": 49.43,
  "end": 50.03
 },
 {
  "line": 21,
  "text": "Fox not cut hair.",
  "start": 50.18,
  "end": 51.09
 },
 {
  "line": 21,
  "text": "Fox not sell fish.",
  "start": 51.24,
  "end": 52.2
 },
 {
  "line": 21,
  "text": "Fox not wash sled.",
  "start": 52.35,
  "end": 53.45
 },
 {
  "line": 22,
  "text": "Fox just say beep.",
  "start": 53.6,
  "end": 54.92
 },
 {
  "line": 23,
  "text": "Now Doug understand why bank love card...",
  "start": 55.07,
  "end": 57.05
 },
 {
  "line": 23,
  "text": "and hate cash.",
  "start": 57.2,
  "end": 57.81
 },
 {
  "line": 24,
  "text": "Doug pay cash.",
  "start": 57.96,
  "end": 59.03
 },
 {
  "line": 24,
  "text": "Doug keep three hairs.",
  "start": 59.18,
  "end": 60.33
 },
 {
  "line": 25,
  "text": "Cash or card?",
  "start": 60.48,
  "end": 61.46
 },
 {
  "line": 25,
  "text": "Which one you use?",
  "start": 61.61,
  "end": 62.31
 },
 {
  "line": 25,
  "text": "Tell Doug in the comments.",
  "start": 62.46,
  "end": 63.67
 }
]