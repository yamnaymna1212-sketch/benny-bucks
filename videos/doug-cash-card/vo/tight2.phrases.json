[
 {
  "line": 1,
  "text": "What is the difference between paying ten dollars with cash...",
  "start": 0.04,
  "end": 2.45
 },
 {
  "line": 1,
  "text": "and ten dollars with card?",
  "start": 2.6,
  "end": 3.83
 },
 {
  "line": 2,
  "text": "Same ten dollars.",
  "start": 4.2,
  "end": 5.03
 },
 {
  "line": 3,
  "text": "This is Doug.",
  "start": 5.18,
  "end": 6.06
 },
 {
  "line": 3,
  "text": "Doug have three hairs.",
  "start": 6.21,
  "end": 7.37
 },
 {
  "line": 3,
  "text": "Doug need haircut.",
  "start": 7.52,
  "end": 8.64
 },
 {
  "line": 4,
  "text": "Puffin cut Doug hair.",
  "start": 8.79,
  "end": 9.85
 },
 {
  "line": 4,
  "text": "Doug pay ten dollars.",
  "start": 10.0,
  "end": 11.27
 },
 {
  "line": 4,
  "text": "Cash.",
  "start": 11.42,
  "end": 11.79
 },
 {
  "line": 5,
  "text": "Puffin go buy fish at Seal shop.",
  "start": 11.94,
  "end": 13.52
 },
 {
  "line": 5,
  "text": "Puffin pay same ten dollars.",
  "start": 13.67,
  "end": 15.1
 },
 {
  "line": 6,
  "text": "Seal go wash sled at Larry car wash.",
  "start": 15.25,
  "end": 17.03
 },
 {
  "line": 6,
  "text": "Seal pay same ten dollars.",
  "start": 17.18,
  "end": 18.59
 },
 {
  "line": 7,
  "text": "Twenty people later...",
  "start": 18.74,
  "end": 19.58
 },
 {
  "line": 7,
  "text": "still ten dollars.",
  "start": 19.73,
  "end": 20.67
 },
 {
  "line": 8,
  "text": "Cash go round and round.",
  "start": 20.82,
  "end": 21.92
 },
 {
  "line": 8,
  "text": "Cash never shrink.",
  "start": 22.07,
  "end": 23.13
 },
 {
  "line": 9,
  "text": "Now Doug pay with card.",
  "start": 23.28,
  "end": 24.56
 },
 {
  "line": 10,
  "text": "Beep.",
  "start": 24.71,
  "end": 24.98
 },
 {
  "line": 10,
  "text": "Puffin get only nine dollars seventy-six.",
  "start": 25.13,
  "end": 26.67
 },
 {
  "line": 11,
  "text": "Twenty-four cents go to Fox the Banker.",
  "start": 26.82,
  "end": 28.17
 },
 {
  "line": 12,
  "text": "Puffin pay Seal with card.",
  "start": 28.32,
  "end": 29.36
 },
 {
  "line": 12,
  "text": "Beep.",
  "start": 29.51,
  "end": 29.88
 },
 {
  "line": 12,
  "text": "Fox take a cut.",
  "start": 30.03,
  "end": 30.72
 },
 {
  "line": 13,
  "text": "Seal pay Larry with card.",
  "start": 30.87,
  "end": 31.95
 },
 {
  "line": 13,
  "text": "Beep.",
  "start": 32.1,
  "end": 32.29
 },
 {
  "line": 13,
  "text": "Fox take a cut.",
  "start": 32.44,
  "end": 33.22
 },
 {
  "line": 14,
  "text": "Every beep, Fox take a little more.",
  "start": 33.37,
  "end": 34.97
 },
 {
  "line": 15,
  "text": "After twenty beeps?",
  "start": 35.12,
  "end": 35.9
 },
 {
  "line": 15,
  "text": "Fox collect three dollars eighty.",
  "start": 36.05,
  "end": 37.29
 },
 {
  "line": 16,
  "text": "Where is three dollars eighty?",
  "start": 37.44,
  "end": 38.74
 },
 {
  "line": 16,
  "text": "In Fox pocket.",
  "start": 38.89,
  "end": 39.83
 },
 {
  "line": 17,
  "text": "This is called swipe fee.",
  "start": 39.98,
  "end": 41.2
 },
 {
  "line": 18,
  "text": "Doug.",
  "start": 41.35,
  "end": 41.73
 },
 {
  "line": 19,
  "text": "In real life, America pay one hundred ninety-eight billion dollars in swipe fees.",
  "start": 42.2,
  "end": 45.78
 },
 {
  "line": 19,
  "text": "In one year.",
  "start": 45.93,
  "end": 46.63
 },
 {
  "line": 20,
  "text": "That is about fifty dollars every month.",
  "start": 46.78,
  "end": 48.44
 },
 {
  "line": 20,
  "text": "For every person.",
  "start": 48.59,
  "end": 49.19
 },
 {
  "line": 21,
  "text": "Fox not cut hair.",
  "start": 49.34,
  "end": 50.24
 },
 {
  "line": 21,
  "text": "Fox not sell fish.",
  "start": 50.39,
  "end": 51.35
 },
 {
  "line": 21,
  "text": "Fox not wash sled.",
  "start": 51.5,
  "end": 52.6
 },
 {
  "line": 22,
  "text": "Fox just say beep.",
  "start": 52.75,
  "end": 54.07
 },
 {
  "line": 23,
  "text": "Now Doug understand why bank love card...",
  "start": 54.22,
  "end": 56.2
 },
 {
  "line": 23,
  "text": "and hate cash.",
  "start": 56.35,
  "end": 56.97
 },
 {
  "line": 24,
  "text": "Doug pay cash.",
  "start": 57.12,
  "end": 58.19
 },
 {
  "line": 24,
  "text": "Doug keep three hairs.",
  "start": 58.34,
  "end": 59.48
 },
 {
  "line": 25,
  "text": "Cash or card?",
  "start": 59.63,
  "end": 60.61
 },
 {
  "line": 25,
  "text": "Which one you use?",
  "start": 60.76,
  "end": 61.46
 },
 {
  "line": 25,
  "text": "Tell Doug in the comments.",
  "start": 61.61,
  "end": 62.85
 }
]