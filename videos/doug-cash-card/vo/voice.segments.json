[
 {
  "start": 0.04,
  "end": 2.38,
  "text": "What is the difference between paying ten dollars with cash..."
 },
 {
  "start": 2.52,
  "end": 3.72,
  "text": "and ten dollars with card?"
 },
 {
  "start": 4.08,
  "end": 4.88,
  "text": "Same ten dollars."
 },
 {
  "start": 5.03,
  "end": 5.88,
  "text": "This is Doug."
 },
 {
  "start": 6.03,
  "end": 7.16,
  "text": "Doug have three hairs."
 },
 {
  "start": 7.3,
  "end": 8.39,
  "text": "Doug need haircut."
 },
 {
  "start": 8.53,
  "end": 9.56,
  "text": "Puffin cut Doug hair."
 },
 {
  "start": 9.71,
  "end": 10.94,
  "text": "Doug pay ten dollars."
 },
 {
  "start": 11.09,
  "end": 11.45,
  "text": "Cash."
 },
 {
  "start": 11.59,
  "end": 13.13,
  "text": "Puffin go buy fish at Seal shop."
 },
 {
  "start": 13.27,
  "end": 14.66,
  "text": "Puffin pay same ten dollars."
 },
 {
  "start": 14.81,
  "end": 16.53,
  "text": "Seal go wash sled at Larry car wash."
 },
 {
  "start": 16.68,
  "end": 18.05,
  "text": "Seal pay same ten dollars."
 },
 {
  "start": 18.19,
  "end": 19.01,
  "text": "Twenty people later..."
 },
 {
  "start": 19.16,
  "end": 20.07,
  "text": "still ten dollars."
 },
 {
  "start": 20.21,
  "end": 21.28,
  "text": "Cash go round and round."
 },
 {
  "start": 21.43,
  "end": 22.46,
  "text": "Cash never shrink."
 },
 {
  "start": 22.6,
  "end": 23.84,
  "text": "Now Doug pay with card."
 },
 {
  "start": 23.99,
  "end": 24.25,
  "text": "Beep."
 },
 {
  "start": 24.4,
  "end": 25.89,
  "text": "Puffin get only nine dollars seventy-six."
 },
 {
  "start": 26.04,
  "end": 27.35,
  "text": "Twenty-four cents go to Fox the Banker."
 },
 {
  "start": 27.5,
  "end": 28.5,
  "text": "Puffin pay Seal with card."
 },
 {
  "start": 28.65,
  "end": 29.01,
  "text": "Beep."
 },
 {
  "start": 29.16,
  "end": 29.83,
  "text": "Fox take a cut."
 },
 {
  "start": 29.97,
  "end": 31.02,
  "text": "Seal pay Larry with card."
 },
 {
  "start": 31.17,
  "end": 31.35,
  "text": "Beep."
 },
 {
  "start": 31.5,
  "end": 32.25,
  "text": "Fox take a cut."
 },
 {
  "start": 32.4,
  "end": 33.95,
  "text": "Every beep, Fox take a little more."
 },
 {
  "start": 34.1,
  "end": 34.85,
  "text": "After twenty beeps?"
 },
 {
  "start": 35.0,
  "end": 36.2,
  "text": "Fox collect three dollars eighty."
 },
 {
  "start": 36.35,
  "end": 37.61,
  "text": "Where is three dollars eighty?"
 },
 {
  "start": 37.76,
  "end": 38.67,
  "text": "In Fox pocket."
 },
 {
  "start": 38.82,
  "end": 40.0,
  "text": "This is called swipe fee."
 },
 {
  "start": 40.15,
  "end": 40.51,
  "text": "Doug."
 },
 {
  "start": 40.97,
  "end": 44.45,
  "text": "In real life, America pay one hundred ninety-eight billion dollars in swipe fees."
 },
 {
  "start": 44.59,
  "end": 45.27,
  "text": "In one year."
 },
 {
  "start": 45.42,
  "end": 47.03,
  "text": "That is about fifty dollars every month."
 },
 {
  "start": 47.17,
  "end": 47.76,
  "text": "For every person."
 },
 {
  "start": 47.9,
  "end": 48.78,
  "text": "Fox not cut hair."
 },
 {
  "start": 48.92,
  "end": 49.85,
  "text": "Fox not sell fish."
 },
 {
  "start": 50.0,
  "end": 51.07,
  "text": "Fox not wash sled."
 },
 {
  "start": 51.21,
  "end": 52.5,
  "text": "Fox just say beep."
 },
 {
  "start": 52.64,
  "end": 54.56,
  "text": "Now Doug understand why bank love card..."
 },
 {
  "start": 54.71,
  "end": 55.31,
  "text": "and hate cash."
 },
 {
  "start": 55.46,
  "end": 56.5,
  "text": "Doug pay cash."
 },
 {
  "start": 56.64,
  "end": 57.75,
  "text": "Doug keep three hairs."
 },
 {
  "start": 57.89,
  "end": 58.84,
  "text": "Cash or card?"
 },
 {
  "start": 58.99,
  "end": 59.67,
  "text": "Which one you use?"
 },
 {
  "start": 59.82,
  "end": 61.02,
  "text": "Tell Doug in the comments."
 }
]