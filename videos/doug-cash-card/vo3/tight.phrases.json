[
 {
  "line": 1,
  "text": "What is the difference between paying ten dollars with cash... and ten dollars with card?",
  "start": 0.04,
  "end": 4.18
 },
 {
  "line": 2,
  "text": "Same ten dollars.",
  "start": 4.55,
  "end": 5.46
 },
 {
  "line": 3,
  "text": "For Doug.",
  "start": 5.61,
  "end": 6.07
 },
 {
  "line": 4,
  "text": "But not for Puffin.",
  "start": 6.22,
  "end": 6.98
 },
 {
  "line": 5,
  "text": "This is Doug.",
  "start": 7.13,
  "end": 7.76
 },
 {
  "line": 6,
  "text": "Doug have three hairs.",
  "start": 7.91,
  "end": 9.0
 },
 {
  "line": 7,
  "text": "Doug need haircut.",
  "start": 9.15,
  "end": 9.89
 },
 {
  "line": 8,
  "text": "Puffin cut Doug hair.",
  "start": 10.04,
  "end": 11.11
 },
 {
  "line": 9,
  "text": "Doug pay ten dollars.",
  "start": 11.26,
  "end": 12.32
 },
 {
  "line": 10,
  "text": "Cash.",
  "start": 12.47,
  "end": 12.85
 },
 {
  "line": 11,
  "text": "Puffin keep all ten dollars.",
  "start": 13.0,
  "end": 14.56
 },
 {
  "line": 12,
  "text": "Next week, Doug pay with card.",
  "start": 14.71,
  "end": 16.48
 },
 {
  "line": 13,
  "text": "Beep.",
  "start": 16.63,
  "end": 16.87
 },
 {
  "line": 14,
  "text": "Puffin get nine dollars seventy-six.",
  "start": 17.02,
  "end": 19.01
 },
 {
  "line": 15,
  "text": "Twenty-four cents is the swipe fee.",
  "start": 19.16,
  "end": 21.21
 },
 {
  "line": 16,
  "text": "It go to the card bank and the card network.",
  "start": 21.36,
  "end": 23.43
 },
 {
  "line": 17,
  "text": "Fox the Banker.",
  "start": 23.58,
  "end": 24.29
 },
 {
  "line": 18,
  "text": "Is Fox lazy?",
  "start": 24.44,
  "end": 25.16
 },
 {
  "line": 19,
  "text": "No.",
  "start": 25.31,
  "end": 25.58
 },
 {
  "line": 20,
  "text": "Fox stop thieves.",
  "start": 25.73,
  "end": 26.66
 },
 {
  "line": 21,
  "text": "Fox give money back if card is stolen.",
  "start": 26.81,
  "end": 28.63
 },
 {
  "line": 22,
  "text": "Fox let Doug buy now, pay later.",
  "start": 28.78,
  "end": 30.49
 },
 {
  "line": 23,
  "text": "So Puffin pay a little for every beep.",
  "start": 30.64,
  "end": 32.68
 },
 {
  "line": 24,
  "text": "But Puffin is smart.",
  "start": 32.83,
  "end": 33.83
 },
 {
  "line": 25,
  "text": "Puffin raise the haircut price.",
  "start": 33.98,
  "end": 35.42
 },
 {
  "line": 26,
  "text": "For everybody.",
  "start": 35.57,
  "end": 36.15
 },
 {
  "line": 27,
  "text": "Cash people too.",
  "start": 36.3,
  "end": 37.03
 },
 {
  "line": 28,
  "text": "Doug.",
  "start": 37.18,
  "end": 37.43
 },
 {
  "line": 29,
  "text": "And card people get points.",
  "start": 37.9,
  "end": 39.13
 },
 {
  "line": 30,
  "text": "Cash back.",
  "start": 39.28,
  "end": 39.86
 },
 {
  "line": 31,
  "text": "Little gifts.",
  "start": 40.01,
  "end": 40.68
 },
 {
  "line": 32,
  "text": "Who pay for the gifts?",
  "start": 40.83,
  "end": 41.74
 },
 {
  "line": 33,
  "text": "Partly... the cash people.",
  "start": 41.89,
  "end": 43.21
 },
 {
  "line": 34,
  "text": "In real life, American stores paid one hundred ninety-eight billion dollars in swipe fees in twenty twenty-five.",
  "start": 43.36,
  "end": 49.7
 },
 {
  "line": 35,
  "text": "And Federal Reserve researchers found cash payers help pay for card rewards.",
  "start": 49.85,
  "end": 54.03
 },
 {
  "line": 36,
  "text": "Card is not evil.",
  "start": 54.18,
  "end": 55.03
 },
 {
  "line": 37,
  "text": "Cash is not magic.",
  "start": 55.18,
  "end": 56.14
 },
 {
  "line": 38,
  "text": "Cash: no fee for Puffin.",
  "start": 56.29,
  "end": 57.93
 },
 {
  "line": 39,
  "text": "Card: safe and fast for Doug.",
  "start": 58.08,
  "end": 60.05
 },
 {
  "line": 40,
  "text": "Cash or card?",
  "start": 60.2,
  "end": 61.03
 },
 {
  "line": 41,
  "text": "Which one you use?",
  "start": 61.18,
  "end": 61.91
 },
 {
  "line": 42,
  "text": "Tell Doug in the comments.",
  "start": 62.06,
  "end": 63.25
 }
]