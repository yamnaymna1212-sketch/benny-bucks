[
 {
  "line": 1,
  "text": "What is the difference between paying ten dollars with cash... and ten dollars with card?",
  "start": 0.0,
  "end": 4.21
 },
 {
  "line": 2,
  "text": "Same ten dollars.",
  "start": 4.51,
  "end": 5.49
 },
 {
  "line": 3,
  "text": "For Doug.",
  "start": 5.57,
  "end": 6.11
 },
 {
  "line": 4,
  "text": "But not for Puffin.",
  "start": 6.19,
  "end": 7.01
 },
 {
  "line": 5,
  "text": "This is Doug.",
  "start": 7.09,
  "end": 7.79
 },
 {
  "line": 6,
  "text": "Doug have three hairs.",
  "start": 7.87,
  "end": 9.04
 },
 {
  "line": 7,
  "text": "Doug need haircut.",
  "start": 9.12,
  "end": 9.93
 },
 {
  "line": 8,
  "text": "Puffin cut Doug hair.",
  "start": 10.01,
  "end": 11.14
 },
 {
  "line": 9,
  "text": "Doug pay ten dollars.",
  "start": 11.22,
  "end": 12.36
 },
 {
  "line": 10,
  "text": "Cash.",
  "start": 12.44,
  "end": 12.89
 },
 {
  "line": 11,
  "text": "Puffin keep all ten dollars.",
  "start": 12.97,
  "end": 14.59
 },
 {
  "line": 12,
  "text": "Next week, Doug pay with card.",
  "start": 14.67,
  "end": 16.52
 },
 {
  "line": 13,
  "text": "Beep.",
  "start": 16.6,
  "end": 16.91
 },
 {
  "line": 14,
  "text": "Puffin get nine dollars seventy-six.",
  "start": 16.99,
  "end": 19.05
 },
 {
  "line": 15,
  "text": "Twenty-four cents is the swipe fee.",
  "start": 19.13,
  "end": 21.24
 },
 {
  "line": 16,
  "text": "It go to the card bank and the card network.",
  "start": 21.32,
  "end": 23.47
 },
 {
  "line": 17,
  "text": "Fox the Banker.",
  "start": 23.55,
  "end": 24.33
 },
 {
  "line": 18,
  "text": "Is Fox lazy?",
  "start": 24.41,
  "end": 25.2
 },
 {
  "line": 19,
  "text": "No.",
  "start": 25.28,
  "end": 25.62
 },
 {
  "line": 20,
  "text": "Fox stop thieves.",
  "start": 25.7,
  "end": 26.69
 },
 {
  "line": 21,
  "text": "Fox give money back if card is stolen.",
  "start": 26.77,
  "end": 28.67
 },
 {
  "line": 22,
  "text": "Fox let Doug buy now, pay later.",
  "start": 28.75,
  "end": 30.52
 },
 {
  "line": 23,
  "text": "So Puffin pay a little for every beep.",
  "start": 30.6,
  "end": 32.71
 },
 {
  "line": 24,
  "text": "But Puffin is smart.",
  "start": 32.79,
  "end": 33.86
 },
 {
  "line": 25,
  "text": "Puffin raise the haircut price.",
  "start": 33.94,
  "end": 35.45
 },
 {
  "line": 26,
  "text": "For everybody.",
  "start": 35.53,
  "end": 36.18
 },
 {
  "line": 27,
  "text": "Cash people too.",
  "start": 36.26,
  "end": 37.06
 },
 {
  "line": 28,
  "text": "Doug.",
  "start": 37.14,
  "end": 37.47
 },
 {
  "line": 29,
  "text": "And card people get points.",
  "start": 37.87,
  "end": 39.17
 },
 {
  "line": 30,
  "text": "Cash back.",
  "start": 39.25,
  "end": 39.89
 },
 {
  "line": 31,
  "text": "Little gifts.",
  "start": 39.97,
  "end": 40.72
 },
 {
  "line": 32,
  "text": "Who pay for the gifts?",
  "start": 40.8,
  "end": 41.77
 },
 {
  "line": 33,
  "text": "Partly... the cash people.",
  "start": 41.85,
  "end": 43.24
 },
 {
  "line": 34,
  "text": "In real life, American stores paid one hundred ninety-eight billion dollars in swipe fees in twenty twenty-five.",
  "start": 43.32,
  "end": 49.73
 },
 {
  "line": 35,
  "text": "And Federal Reserve researchers found cash payers help pay for card rewards.",
  "start": 49.81,
  "end": 54.07
 },
 {
  "line": 36,
  "text": "Card is not evil.",
  "start": 54.15,
  "end": 55.07
 },
 {
  "line": 37,
  "text": "Cash is not magic.",
  "start": 55.15,
  "end": 56.17
 },
 {
  "line": 38,
  "text": "Cash: no fee for Puffin.",
  "start": 56.25,
  "end": 57.96
 },
 {
  "line": 39,
  "text": "Card: safe and fast for Doug.",
  "start": 58.04,
  "end": 60.08
 },
 {
  "line": 40,
  "text": "Cash or card?",
  "start": 60.16,
  "end": 61.07
 },
 {
  "line": 41,
  "text": "Which one you use?",
  "start": 61.15,
  "end": 61.94
 },
 {
  "line": 42,
  "text": "Tell Doug in the comments.",
  "start": 62.02,
  "end": 63.29
 }
]