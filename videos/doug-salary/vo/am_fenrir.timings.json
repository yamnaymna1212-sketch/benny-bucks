[
 {
  "voice": "am_fenrir",
  "text": "Why two penguins make same salary,",
  "start": 0.0,
  "end": 1.82
 },
 {
  "voice": "am_fenrir",
  "text": "but one stay poor,",
  "start": 1.86,
  "end": 2.86
 },
 {
  "voice": "am_fenrir",
  "text": "and one become millionaire?",
  "start": 2.9,
  "end": 4.05
 },
 {
  "voice": "am_fenrir",
  "text": "This is Doug.",
  "start": 4.25,
  "end": 4.98
 },
 {
  "voice": "am_fenrir",
  "text": "This is Ricky. Doug brother.",
  "start": 5.06,
  "end": 6.56
 },
 {
  "voice": "am_fenrir",
  "text": "Same job. Same salary.",
  "start": 6.66,
  "end": 8.09
 },
 {
  "voice": "am_fenrir",
  "text": "Both need car.",
  "start": 8.19,
  "end": 9.07
 },
 {
  "voice": "am_fenrir",
  "text": "Doug buy new car. Four thousand four hundred fish.",
  "start": 9.17,
  "end": 11.91
 },
 {
  "voice": "am_fenrir",
  "text": "Doug no have four thousand four hundred fish.",
  "start": 12.01,
  "end": 14.26
 },
 {
  "voice": "am_fenrir",
  "text": "So Doug get loan.",
  "start": 14.36,
  "end": 15.34
 },
 {
  "voice": "am_fenrir",
  "text": "Sixty-five fish every month. Seven years.",
  "start": 15.4,
  "end": 17.75
 },
 {
  "voice": "am_fenrir",
  "text": "Doug happy.",
  "start": 17.85,
  "end": 18.59
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky buy old car. One thousand fish. Cash.",
  "start": 18.89,
  "end": 21.47
 },
 {
  "voice": "am_fenrir",
  "text": "Doug laugh at Ricky car.",
  "start": 21.57,
  "end": 22.74
 },
 {
  "voice": "am_fenrir",
  "text": "But Ricky also take sixty-five fish every month.",
  "start": 22.84,
  "end": 25.47
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky no give fish to bank.",
  "start": 25.55,
  "end": 26.85
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky put fish in stock market.",
  "start": 26.91,
  "end": 28.45
 },
 {
  "voice": "am_fenrir",
  "text": "Doug fish go to bank.",
  "start": 28.55,
  "end": 29.64
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky fish go to work.",
  "start": 29.7,
  "end": 30.87
 },
 {
  "voice": "am_fenrir",
  "text": "Every year, Doug car worth less.",
  "start": 30.97,
  "end": 32.58
 },
 {
  "voice": "am_fenrir",
  "text": "Every year, Ricky fish make baby fish.",
  "start": 32.66,
  "end": 34.63
 },
 {
  "voice": "am_fenrir",
  "text": "Baby fish make more fish.",
  "start": 34.69,
  "end": 35.94
 },
 {
  "voice": "am_fenrir",
  "text": "This is called compound interest.",
  "start": 36.06,
  "end": 37.63
 },
 {
  "voice": "am_fenrir",
  "text": "Doug poor.",
  "start": 37.78,
  "end": 38.42
 },
 {
  "voice": "am_fenrir",
  "text": "In real life, a forty-four thousand dollar car loan for seven years,",
  "start": 38.77,
  "end": 42.76
 },
 {
  "voice": "am_fenrir",
  "text": "is about six hundred fifty dollars a month.",
  "start": 42.8,
  "end": 44.98
 },
 {
  "voice": "am_fenrir",
  "text": "Invest that in stocks, about seven percent a year.",
  "start": 45.08,
  "end": 47.6
 },
 {
  "voice": "am_fenrir",
  "text": "Seven years: seventy thousand dollars.",
  "start": 47.7,
  "end": 49.72
 },
 {
  "voice": "am_fenrir",
  "text": "Thirty-five years: one point one million.",
  "start": 49.8,
  "end": 51.89
 },
 {
  "voice": "am_fenrir",
  "text": "Year seven. Doug make last payment.",
  "start": 52.04,
  "end": 53.78
 },
 {
  "voice": "am_fenrir",
  "text": "Doug car break.",
  "start": 53.84,
  "end": 54.74
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky buy new car. Cash. With baby fish.",
  "start": 54.86,
  "end": 57.13
 },
 {
  "voice": "am_fenrir",
  "text": "Doug buy new car. With new loan.",
  "start": 57.23,
  "end": 58.86
 },
 {
  "voice": "am_fenrir",
  "text": "Team Doug, or team Ricky?",
  "start": 59.01,
  "end": 60.29
 }
]