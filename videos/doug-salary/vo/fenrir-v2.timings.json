[
 {
  "voice": "am_fenrir",
  "text": "Why two penguins make same salary,",
  "start": 0.0,
  "end": 1.88
 },
 {
  "voice": "am_fenrir",
  "text": "but only one buy his dream car?",
  "start": 1.92,
  "end": 3.65
 },
 {
  "voice": "am_fenrir",
  "text": "This is Doug. This is Ricky. Brothers.",
  "start": 3.85,
  "end": 5.83
 },
 {
  "voice": "am_fenrir",
  "text": "Same job. Same salary.",
  "start": 5.93,
  "end": 7.44
 },
 {
  "voice": "am_fenrir",
  "text": "Seventy thousand dollars a year.",
  "start": 7.5,
  "end": 9.17
 },
 {
  "voice": "am_fenrir",
  "text": "Both need a car.",
  "start": 9.27,
  "end": 10.21
 },
 {
  "voice": "am_fenrir",
  "text": "Doug buy new car. Forty-four thousand dollars.",
  "start": 10.31,
  "end": 12.99
 },
 {
  "voice": "am_fenrir",
  "text": "With a loan.",
  "start": 13.05,
  "end": 13.74
 },
 {
  "voice": "am_fenrir",
  "text": "Loan is six hundred fifty dollars every month.",
  "start": 13.84,
  "end": 16.4
 },
 {
  "voice": "am_fenrir",
  "text": "For seven years.",
  "start": 16.46,
  "end": 17.41
 },
 {
  "voice": "am_fenrir",
  "text": "New car have warranty. Few repairs.",
  "start": 17.51,
  "end": 19.56
 },
 {
  "voice": "am_fenrir",
  "text": "Doug happy.",
  "start": 19.66,
  "end": 20.41
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky buy used car. Ten thousand dollars. Cash.",
  "start": 20.71,
  "end": 23.54
 },
 {
  "voice": "am_fenrir",
  "text": "Used car cost less.",
  "start": 23.64,
  "end": 24.83
 },
 {
  "voice": "am_fenrir",
  "text": "But used car can break more.",
  "start": 24.89,
  "end": 26.38
 },
 {
  "voice": "am_fenrir",
  "text": "Repairs cost money.",
  "start": 26.44,
  "end": 27.51
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky put his extra money in stocks every month.",
  "start": 27.61,
  "end": 30.17
 },
 {
  "voice": "am_fenrir",
  "text": "Stocks can go up.",
  "start": 30.27,
  "end": 31.3
 },
 {
  "voice": "am_fenrir",
  "text": "Stocks can also go down.",
  "start": 31.36,
  "end": 32.78
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky nervous.",
  "start": 32.88,
  "end": 33.74
 },
 {
  "voice": "am_fenrir",
  "text": "Money that grow on its own money,",
  "start": 34.04,
  "end": 35.58
 },
 {
  "voice": "am_fenrir",
  "text": "is called compound interest.",
  "start": 35.62,
  "end": 37.04
 },
 {
  "voice": "am_fenrir",
  "text": "Every year, cars lose value.",
  "start": 37.16,
  "end": 38.81
 },
 {
  "voice": "am_fenrir",
  "text": "This is called depreciation.",
  "start": 38.87,
  "end": 40.36
 },
 {
  "voice": "am_fenrir",
  "text": "In real life, average new car loan is about forty-four thousand dollars,",
  "start": 40.48,
  "end": 44.99
 },
 {
  "voice": "am_fenrir",
  "text": "at about six percent.",
  "start": 45.03,
  "end": 46.18
 },
 {
  "voice": "am_fenrir",
  "text": "After seven years, Doug car is paid off.",
  "start": 46.28,
  "end": 48.55
 },
 {
  "voice": "am_fenrir",
  "text": "Doug own the car.",
  "start": 48.61,
  "end": 49.49
 },
 {
  "voice": "am_fenrir",
  "text": "If stocks grow seven percent a year,",
  "start": 49.59,
  "end": 51.51
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky have about seventy thousand dollars,",
  "start": 51.55,
  "end": 53.69
 },
 {
  "voice": "am_fenrir",
  "text": "minus his repairs.",
  "start": 53.73,
  "end": 54.84
 },
 {
  "voice": "am_fenrir",
  "text": "If stocks fall, Ricky have less.",
  "start": 54.94,
  "end": 56.56
 },
 {
  "voice": "am_fenrir",
  "text": "Same salary.",
  "start": 56.71,
  "end": 57.56
 },
 {
  "voice": "am_fenrir",
  "text": "Different choices.",
  "start": 57.62,
  "end": 58.57
 },
 {
  "voice": "am_fenrir",
  "text": "Different numbers.",
  "start": 58.63,
  "end": 59.52
 }
]