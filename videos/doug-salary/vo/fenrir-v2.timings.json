[
 {
  "voice": "am_fenrir",
  "text": "Why two penguins make same salary,",
  "start": 0.0,
  "end": 1.93
 },
 {
  "voice": "am_fenrir",
  "text": "but one buy his dream car,",
  "start": 1.97,
  "end": 3.41
 },
 {
  "voice": "am_fenrir",
  "text": "and one buy a bike?",
  "start": 3.45,
  "end": 4.54
 },
 {
  "voice": "am_fenrir",
  "text": "This is Doug. This is Ricky. Brothers.",
  "start": 4.74,
  "end": 6.75
 },
 {
  "voice": "am_fenrir",
  "text": "Same job. Same salary.",
  "start": 6.85,
  "end": 8.39
 },
 {
  "voice": "am_fenrir",
  "text": "Seventy thousand dollars a year.",
  "start": 8.45,
  "end": 10.15
 },
 {
  "voice": "am_fenrir",
  "text": "Both need to go to work.",
  "start": 10.25,
  "end": 11.51
 },
 {
  "voice": "am_fenrir",
  "text": "Doug buy new car. Forty-four thousand dollars.",
  "start": 11.61,
  "end": 14.33
 },
 {
  "voice": "am_fenrir",
  "text": "With a loan.",
  "start": 14.39,
  "end": 15.1
 },
 {
  "voice": "am_fenrir",
  "text": "Loan is six hundred fifty dollars every month.",
  "start": 15.2,
  "end": 17.79
 },
 {
  "voice": "am_fenrir",
  "text": "For seven years.",
  "start": 17.85,
  "end": 18.83
 },
 {
  "voice": "am_fenrir",
  "text": "Car is fast. Car is warm.",
  "start": 18.93,
  "end": 20.62
 },
 {
  "voice": "am_fenrir",
  "text": "Doug happy.",
  "start": 20.72,
  "end": 21.49
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky buy a bike. Four hundred dollars. Cash.",
  "start": 21.79,
  "end": 24.28
 },
 {
  "voice": "am_fenrir",
  "text": "Bike is cheap.",
  "start": 24.38,
  "end": 25.26
 },
 {
  "voice": "am_fenrir",
  "text": "But bike is slow. And snow is cold.",
  "start": 25.32,
  "end": 27.43
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky freezing.",
  "start": 27.53,
  "end": 28.45
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky put his extra money in stocks every month.",
  "start": 28.75,
  "end": 31.41
 },
 {
  "voice": "am_fenrir",
  "text": "Stocks can go up.",
  "start": 31.51,
  "end": 32.58
 },
 {
  "voice": "am_fenrir",
  "text": "Stocks can also go down.",
  "start": 32.64,
  "end": 34.12
 },
 {
  "voice": "am_fenrir",
  "text": "Money that grow on its own money,",
  "start": 34.24,
  "end": 35.83
 },
 {
  "voice": "am_fenrir",
  "text": "is called compound interest.",
  "start": 35.87,
  "end": 37.33
 },
 {
  "voice": "am_fenrir",
  "text": "Every year, cars lose value.",
  "start": 37.45,
  "end": 39.12
 },
 {
  "voice": "am_fenrir",
  "text": "This is called depreciation.",
  "start": 39.18,
  "end": 40.68
 },
 {
  "voice": "am_fenrir",
  "text": "In real life, average new car loan is about forty-four thousand dollars,",
  "start": 40.8,
  "end": 45.42
 },
 {
  "voice": "am_fenrir",
  "text": "at about six percent.",
  "start": 45.46,
  "end": 46.64
 },
 {
  "voice": "am_fenrir",
  "text": "After seven years, Doug car is paid off.",
  "start": 46.74,
  "end": 49.02
 },
 {
  "voice": "am_fenrir",
  "text": "Doug own the car.",
  "start": 49.08,
  "end": 50.01
 },
 {
  "voice": "am_fenrir",
  "text": "If stocks grow seven percent a year,",
  "start": 50.11,
  "end": 52.11
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky have about seventy thousand dollars.",
  "start": 52.15,
  "end": 54.34
 },
 {
  "voice": "am_fenrir",
  "text": "If stocks fall, Ricky have less.",
  "start": 54.44,
  "end": 56.12
 },
 {
  "voice": "am_fenrir",
  "text": "Same salary.",
  "start": 56.27,
  "end": 57.14
 },
 {
  "voice": "am_fenrir",
  "text": "Different choices.",
  "start": 57.2,
  "end": 58.17
 },
 {
  "voice": "am_fenrir",
  "text": "Different numbers.",
  "start": 58.23,
  "end": 59.15
 }
]