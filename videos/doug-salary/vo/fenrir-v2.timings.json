[
 {
  "voice": "am_fenrir",
  "text": "Why two penguins make same salary,",
  "start": 0.0,
  "end": 1.88
 },
 {
  "voice": "am_fenrir",
  "text": "but one buy his dream car,",
  "start": 1.92,
  "end": 3.29
 },
 {
  "voice": "am_fenrir",
  "text": "and one buy old car?",
  "start": 3.33,
  "end": 4.42
 },
 {
  "voice": "am_fenrir",
  "text": "This is Doug. This is Ricky. Brothers.",
  "start": 4.62,
  "end": 6.61
 },
 {
  "voice": "am_fenrir",
  "text": "Same job. Same salary.",
  "start": 6.71,
  "end": 8.22
 },
 {
  "voice": "am_fenrir",
  "text": "Seventy thousand dollars a year.",
  "start": 8.28,
  "end": 9.94
 },
 {
  "voice": "am_fenrir",
  "text": "Both need a car.",
  "start": 10.04,
  "end": 10.99
 },
 {
  "voice": "am_fenrir",
  "text": "Doug buy new car. Forty-four thousand dollars.",
  "start": 11.09,
  "end": 13.77
 },
 {
  "voice": "am_fenrir",
  "text": "With a loan.",
  "start": 13.83,
  "end": 14.51
 },
 {
  "voice": "am_fenrir",
  "text": "Loan is six hundred fifty dollars every month.",
  "start": 14.61,
  "end": 17.17
 },
 {
  "voice": "am_fenrir",
  "text": "For seven years.",
  "start": 17.23,
  "end": 18.18
 },
 {
  "voice": "am_fenrir",
  "text": "New car have warranty. Few repairs.",
  "start": 18.28,
  "end": 20.34
 },
 {
  "voice": "am_fenrir",
  "text": "Doug happy.",
  "start": 20.44,
  "end": 21.18
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky buy used car. Ten thousand dollars. Cash.",
  "start": 21.48,
  "end": 24.31
 },
 {
  "voice": "am_fenrir",
  "text": "Used car cost less.",
  "start": 24.41,
  "end": 25.6
 },
 {
  "voice": "am_fenrir",
  "text": "But used car can break more.",
  "start": 25.66,
  "end": 27.16
 },
 {
  "voice": "am_fenrir",
  "text": "Repairs cost money.",
  "start": 27.22,
  "end": 28.28
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky put his extra money in stocks every month.",
  "start": 28.38,
  "end": 30.94
 },
 {
  "voice": "am_fenrir",
  "text": "Stocks can go up.",
  "start": 31.04,
  "end": 32.07
 },
 {
  "voice": "am_fenrir",
  "text": "Stocks can also go down.",
  "start": 32.13,
  "end": 33.56
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky nervous.",
  "start": 33.66,
  "end": 34.52
 },
 {
  "voice": "am_fenrir",
  "text": "Money that grow on its own money,",
  "start": 34.82,
  "end": 36.35
 },
 {
  "voice": "am_fenrir",
  "text": "is called compound interest.",
  "start": 36.39,
  "end": 37.82
 },
 {
  "voice": "am_fenrir",
  "text": "Every year, cars lose value.",
  "start": 37.94,
  "end": 39.58
 },
 {
  "voice": "am_fenrir",
  "text": "This is called depreciation.",
  "start": 39.64,
  "end": 41.14
 },
 {
  "voice": "am_fenrir",
  "text": "In real life, average new car loan is about forty-four thousand dollars,",
  "start": 41.26,
  "end": 45.76
 },
 {
  "voice": "am_fenrir",
  "text": "at about six percent.",
  "start": 45.8,
  "end": 46.95
 },
 {
  "voice": "am_fenrir",
  "text": "After seven years, Doug car is paid off.",
  "start": 47.05,
  "end": 49.33
 },
 {
  "voice": "am_fenrir",
  "text": "Doug own the car.",
  "start": 49.39,
  "end": 50.27
 },
 {
  "voice": "am_fenrir",
  "text": "If stocks grow seven percent a year,",
  "start": 50.37,
  "end": 52.28
 },
 {
  "voice": "am_fenrir",
  "text": "Ricky have about seventy thousand dollars,",
  "start": 52.32,
  "end": 54.46
 },
 {
  "voice": "am_fenrir",
  "text": "minus his repairs.",
  "start": 54.5,
  "end": 55.61
 },
 {
  "voice": "am_fenrir",
  "text": "If stocks fall, Ricky have less.",
  "start": 55.71,
  "end": 57.33
 },
 {
  "voice": "am_fenrir",
  "text": "Same salary.",
  "start": 57.48,
  "end": 58.33
 },
 {
  "voice": "am_fenrir",
  "text": "Different choices.",
  "start": 58.39,
  "end": 59.34
 },
 {
  "voice": "am_fenrir",
  "text": "Different numbers.",
  "start": 59.41,
  "end": 60.29
 }
]