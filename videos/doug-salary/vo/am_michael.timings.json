[
 {
  "voice": "am_michael",
  "text": "Why two penguins make same salary,",
  "start": 0.0,
  "end": 1.88
 },
 {
  "voice": "am_michael",
  "text": "but one stay poor,",
  "start": 1.92,
  "end": 2.95
 },
 {
  "voice": "am_michael",
  "text": "and one become millionaire?",
  "start": 2.99,
  "end": 4.25
 },
 {
  "voice": "am_michael",
  "text": "This is Doug.",
  "start": 4.45,
  "end": 5.23
 },
 {
  "voice": "am_michael",
  "text": "This is Ricky. Doug brother.",
  "start": 5.31,
  "end": 6.78
 },
 {
  "voice": "am_michael",
  "text": "Same job. Same salary.",
  "start": 6.88,
  "end": 8.4
 },
 {
  "voice": "am_michael",
  "text": "Both need car.",
  "start": 8.5,
  "end": 9.46
 },
 {
  "voice": "am_michael",
  "text": "Doug buy new car. Four thousand four hundred fish.",
  "start": 9.56,
  "end": 12.25
 },
 {
  "voice": "am_michael",
  "text": "Doug no have four thousand four hundred fish.",
  "start": 12.35,
  "end": 14.67
 },
 {
  "voice": "am_michael",
  "text": "So Doug get loan.",
  "start": 14.77,
  "end": 15.85
 },
 {
  "voice": "am_michael",
  "text": "Sixty-five fish every month. Seven years.",
  "start": 15.91,
  "end": 18.26
 },
 {
  "voice": "am_michael",
  "text": "Doug happy.",
  "start": 18.36,
  "end": 19.07
 },
 {
  "voice": "am_michael",
  "text": "Ricky buy old car. One thousand fish. Cash.",
  "start": 19.37,
  "end": 22.04
 },
 {
  "voice": "am_michael",
  "text": "Doug laugh at Ricky car.",
  "start": 22.14,
  "end": 23.35
 },
 {
  "voice": "am_michael",
  "text": "But Ricky also take sixty-five fish every month.",
  "start": 23.45,
  "end": 26.08
 },
 {
  "voice": "am_michael",
  "text": "Ricky no give fish to bank.",
  "start": 26.16,
  "end": 27.59
 },
 {
  "voice": "am_michael",
  "text": "Ricky put fish in stock market.",
  "start": 27.65,
  "end": 29.35
 },
 {
  "voice": "am_michael",
  "text": "Doug fish go to bank.",
  "start": 29.45,
  "end": 30.57
 },
 {
  "voice": "am_michael",
  "text": "Ricky fish go to work.",
  "start": 30.64,
  "end": 31.88
 },
 {
  "voice": "am_michael",
  "text": "Every year, Doug car worth less.",
  "start": 31.98,
  "end": 33.69
 },
 {
  "voice": "am_michael",
  "text": "Every year, Ricky fish make baby fish.",
  "start": 33.77,
  "end": 35.92
 },
 {
  "voice": "am_michael",
  "text": "Baby fish make more fish.",
  "start": 35.98,
  "end": 37.47
 },
 {
  "voice": "am_michael",
  "text": "This is called compound interest.",
  "start": 37.59,
  "end": 39.26
 },
 {
  "voice": "am_michael",
  "text": "Doug poor.",
  "start": 39.41,
  "end": 40.05
 },
 {
  "voice": "am_michael",
  "text": "In real life, a forty-four thousand dollar car loan for seven years,",
  "start": 40.4,
  "end": 44.24
 },
 {
  "voice": "am_michael",
  "text": "is about six hundred fifty dollars a month.",
  "start": 44.28,
  "end": 46.26
 },
 {
  "voice": "am_michael",
  "text": "Invest that in stocks, about seven percent a year.",
  "start": 46.36,
  "end": 48.97
 },
 {
  "voice": "am_michael",
  "text": "Seven years: seventy thousand dollars.",
  "start": 49.07,
  "end": 51.19
 },
 {
  "voice": "am_michael",
  "text": "Thirty-five years: one point one million.",
  "start": 51.27,
  "end": 53.44
 },
 {
  "voice": "am_michael",
  "text": "Year seven. Doug make last payment.",
  "start": 53.59,
  "end": 55.44
 },
 {
  "voice": "am_michael",
  "text": "Doug car break.",
  "start": 55.5,
  "end": 56.46
 },
 {
  "voice": "am_michael",
  "text": "Ricky buy new car. Cash. With baby fish.",
  "start": 56.58,
  "end": 58.84
 },
 {
  "voice": "am_michael",
  "text": "Doug buy new car. With new loan.",
  "start": 58.94,
  "end": 60.6
 },
 {
  "voice": "am_michael",
  "text": "Team Doug, or team Ricky?",
  "start": 60.75,
  "end": 62.08
 }
]