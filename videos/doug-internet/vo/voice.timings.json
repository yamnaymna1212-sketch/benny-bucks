[
 {
  "voice": "am_liam",
  "text": "Why Doug pay twenty-five dollars for one month of data in America...",
  "start": 0.0,
  "end": 3.33
 },
 {
  "voice": "am_liam",
  "text": "but two dollars in India?",
  "start": 3.38,
  "end": 4.93
 },
 {
  "voice": "am_liam",
  "text": "Same phone.",
  "start": 4.98,
  "end": 5.9
 },
 {
  "voice": "am_liam",
  "text": "Same Doug.",
  "start": 5.93,
  "end": 6.81
 },
 {
  "voice": "am_liam",
  "text": "This is Doug. Doug have phone.",
  "start": 6.86,
  "end": 8.51
 },
 {
  "voice": "am_liam",
  "text": "Doug watch video. Every day.",
  "start": 8.54,
  "end": 10.2
 },
 {
  "voice": "am_liam",
  "text": "Data come from tower.",
  "start": 10.23,
  "end": 11.64
 },
 {
  "voice": "am_liam",
  "text": "Larry own tower.",
  "start": 11.67,
  "end": 12.89
 },
 {
  "voice": "am_liam",
  "text": "Doug pay Larry. Every month.",
  "start": 12.92,
  "end": 14.56
 },
 {
  "voice": "am_liam",
  "text": "In America, Larry say price.",
  "start": 14.59,
  "end": 16.41
 },
 {
  "voice": "am_liam",
  "text": "Price high. Doug pay.",
  "start": 16.44,
  "end": 17.79
 },
 {
  "voice": "am_liam",
  "text": "Then Jio Larry come to India.",
  "start": 17.82,
  "end": 19.7
 },
 {
  "voice": "am_liam",
  "text": "Jio Larry give data free. Free!",
  "start": 19.73,
  "end": 21.69
 },
 {
  "voice": "am_liam",
  "text": "Everybody run to Jio Larry.",
  "start": 21.72,
  "end": 23.58
 },
 {
  "voice": "am_liam",
  "text": "Airtel Larry panic.",
  "start": 23.61,
  "end": 24.88
 },
 {
  "voice": "am_liam",
  "text": "Airtel Larry cut price.",
  "start": 24.91,
  "end": 26.42
 },
 {
  "voice": "am_liam",
  "text": "Or Airtel Larry lose every Doug.",
  "start": 26.45,
  "end": 28.37
 },
 {
  "voice": "am_liam",
  "text": "All Larry cut price.",
  "start": 28.4,
  "end": 29.81
 },
 {
  "voice": "am_liam",
  "text": "Price go down. Down. Down.",
  "start": 29.84,
  "end": 31.54
 },
 {
  "voice": "am_liam",
  "text": "This is called price war.",
  "start": 31.57,
  "end": 33.16
 },
 {
  "voice": "am_liam",
  "text": "India have one billion phones.",
  "start": 33.21,
  "end": 35.06
 },
 {
  "voice": "am_liam",
  "text": "Larry sell small. Sell to everybody.",
  "start": 35.09,
  "end": 37.16
 },
 {
  "voice": "am_liam",
  "text": "Small price. Many Doug. Big money.",
  "start": 37.19,
  "end": 39.02
 },
 {
  "voice": "am_liam",
  "text": "This is called scale.",
  "start": 39.05,
  "end": 40.35
 },
 {
  "voice": "am_liam",
  "text": "Doug angry.",
  "start": 40.4,
  "end": 41.37
 },
 {
  "voice": "am_liam",
  "text": "India data is one of the cheapest in the world.",
  "start": 41.67,
  "end": 44.13
 },
 {
  "voice": "am_liam",
  "text": "In real life, Visible cost twenty-five dollars. Unlimited data.",
  "start": 44.18,
  "end": 47.72
 },
 {
  "voice": "am_liam",
  "text": "Jio cost one hundred eighty-nine rupees. About two dollars.",
  "start": 47.75,
  "end": 51.01
 },
 {
  "voice": "am_liam",
  "text": "But only two gigabytes.",
  "start": 51.04,
  "end": 52.46
 },
 {
  "voice": "am_liam",
  "text": "Doug move to India.",
  "start": 52.51,
  "end": 53.84
 },
 {
  "voice": "am_liam",
  "text": "Doug happy. Life is good.",
  "start": 53.87,
  "end": 55.39
 },
 {
  "voice": "am_liam",
  "text": "Doug watch one video.",
  "start": 55.42,
  "end": 56.86
 },
 {
  "voice": "am_liam",
  "text": "Data gone.",
  "start": 56.89,
  "end": 57.79
 },
 {
  "voice": "am_liam",
  "text": "Doug pay Larry again.",
  "start": 57.84,
  "end": 59.19
 },
 {
  "voice": "am_liam",
  "text": "Life is not good.",
  "start": 59.22,
  "end": 60.48
 },
 {
  "voice": "am_liam",
  "text": "Would you pay less for less data?",
  "start": 60.53,
  "end": 62.14
 },
 {
  "voice": "am_liam",
  "text": "Tell Doug in the comments.",
  "start": 62.17,
  "end": 63.6
 }
]