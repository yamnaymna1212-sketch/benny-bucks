[
 {
  "voice": "am_puck",
  "text": "Why do rich countries keep lending trillions to broke countries that will never pay it back?",
  "start": 0.0,
  "end": 4.71
 },
 {
  "voice": "am_puck",
  "text": "This is Doug.",
  "start": 4.96,
  "end": 5.71
 },
 {
  "voice": "am_puck",
  "text": "Doug live on Broke Island.",
  "start": 5.78,
  "end": 7.09
 },
 {
  "voice": "am_puck",
  "text": "Broke Island have zero fish.",
  "start": 7.19,
  "end": 8.73
 },
 {
  "voice": "am_puck",
  "text": "Rich Island have mountain of fish.",
  "start": 8.83,
  "end": 10.38
 },
 {
  "voice": "am_puck",
  "text": "Doug want one sled.",
  "start": 10.48,
  "end": 11.52
 },
 {
  "voice": "am_puck",
  "text": "Sled cost 100 fish.",
  "start": 11.59,
  "end": 13.04
 },
 {
  "voice": "am_puck",
  "text": "So Walrus lend Doug 100 fish.",
  "start": 13.14,
  "end": 15.09
 },
 {
  "voice": "am_puck",
  "text": "But Doug must pay back 110 fish.",
  "start": 15.19,
  "end": 17.38
 },
 {
  "voice": "am_puck",
  "text": "Extra 10 fish.",
  "start": 17.48,
  "end": 18.5
 },
 {
  "voice": "am_puck",
  "text": "This is called interest.",
  "start": 18.57,
  "end": 19.73
 },
 {
  "voice": "am_puck",
  "text": "Doug cannot pay.",
  "start": 19.88,
  "end": 20.82
 },
 {
  "voice": "am_puck",
  "text": "Doug poor.",
  "start": 20.89,
  "end": 21.54
 },
 {
  "voice": "am_puck",
  "text": "So Walrus lend Doug 110 more fish.",
  "start": 21.89,
  "end": 24.41
 },
 {
  "voice": "am_puck",
  "text": "Doug pay Walrus with Walrus fish.",
  "start": 24.51,
  "end": 26.27
 },
 {
  "voice": "am_puck",
  "text": "Debt never end.",
  "start": 26.37,
  "end": 27.25
 },
 {
  "voice": "am_puck",
  "text": "Interest never end.",
  "start": 27.32,
  "end": 28.35
 },
 {
  "voice": "am_puck",
  "text": "This is called rollover.",
  "start": 28.45,
  "end": 29.6
 },
 {
  "voice": "am_puck",
  "text": "So why Walrus keep lending?",
  "start": 29.75,
  "end": 31.23
 },
 {
  "voice": "am_puck",
  "text": "Three reasons.",
  "start": 31.3,
  "end": 32.12
 },
 {
  "voice": "am_puck",
  "text": "One. If Broke Island sink, Walrus lose all fish.",
  "start": 32.27,
  "end": 34.91
 },
 {
  "voice": "am_puck",
  "text": "Two. Doug buy nets and boats from Walrus.",
  "start": 35.03,
  "end": 37.03
 },
 {
  "voice": "am_puck",
  "text": "Fish come back.",
  "start": 37.1,
  "end": 37.92
 },
 {
  "voice": "am_puck",
  "text": "Three. Doug owe Walrus.",
  "start": 38.04,
  "end": 39.14
 },
 {
  "voice": "am_puck",
  "text": "So Doug listen to Walrus.",
  "start": 39.21,
  "end": 40.49
 },
 {
  "voice": "am_puck",
  "text": "This is called power.",
  "start": 40.59,
  "end": 41.64
 },
 {
  "voice": "am_puck",
  "text": "Doug owned.",
  "start": 41.74,
  "end": 42.39
 },
 {
  "voice": "am_puck",
  "text": "Real life.",
  "start": 42.74,
  "end": 43.5
 },
 {
  "voice": "am_puck",
  "text": "In 2018, the IMF lent Argentina 44 billion dollars.",
  "start": 43.57,
  "end": 48.54
 },
 {
  "voice": "am_puck",
  "text": "Biggest loan in IMF history.",
  "start": 48.64,
  "end": 50.29
 },
 {
  "voice": "am_puck",
  "text": "In 2025, Argentina borrow again.",
  "start": 50.39,
  "end": 53.23
 },
 {
  "voice": "am_puck",
  "text": "Rich countries do not lose money.",
  "start": 53.35,
  "end": 54.92
 },
 {
  "voice": "am_puck",
  "text": "Rich countries win control.",
  "start": 54.99,
  "end": 56.35
 },
 {
  "voice": "am_puck",
  "text": "Doug finally get sled.",
  "start": 56.5,
  "end": 57.67
 },
 {
  "voice": "am_puck",
  "text": "Life is good.",
  "start": 57.74,
  "end": 58.56
 },
 {
  "voice": "am_puck",
  "text": "Life is not good.",
  "start": 58.81,
  "end": 59.79
 },
 {
  "voice": "am_puck",
  "text": "Sled belong to Walrus.",
  "start": 59.86,
  "end": 61.03
 },
 {
  "voice": "am_puck",
  "text": "Would you lend money to a friend who never pays back?",
  "start": 61.23,
  "end": 63.69
 }
]