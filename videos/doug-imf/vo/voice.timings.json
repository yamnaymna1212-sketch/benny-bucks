[
 {
  "voice": "am_puck",
  "text": "Why do rich countries keep lending trillions to broke countries that will never pay it back?",
  "start": 0.0,
  "end": 4.34
 },
 {
  "voice": "am_puck",
  "text": "This is Doug.",
  "start": 4.37,
  "end": 5.08
 },
 {
  "voice": "am_puck",
  "text": "Doug live on Broke Island. Broke Island is broke country.",
  "start": 5.11,
  "end": 7.97
 },
 {
  "voice": "am_puck",
  "text": "Broke Island have zero fish.",
  "start": 8.0,
  "end": 9.4
 },
 {
  "voice": "am_puck",
  "text": "Rich Island have mountain of fish. Rich Island is rich country.",
  "start": 9.43,
  "end": 12.74
 },
 {
  "voice": "am_puck",
  "text": "Doug want one sled.",
  "start": 12.77,
  "end": 13.68
 },
 {
  "voice": "am_puck",
  "text": "Sled cost 100 fish.",
  "start": 13.71,
  "end": 15.01
 },
 {
  "voice": "am_puck",
  "text": "So Walrus lend Doug 100 fish.",
  "start": 15.04,
  "end": 16.88
 },
 {
  "voice": "am_puck",
  "text": "But Doug must pay back 110 fish.",
  "start": 16.91,
  "end": 18.93
 },
 {
  "voice": "am_puck",
  "text": "Extra 10 fish.",
  "start": 18.96,
  "end": 19.89
 },
 {
  "voice": "am_puck",
  "text": "This is called interest.",
  "start": 19.92,
  "end": 20.98
 },
 {
  "voice": "am_puck",
  "text": "Doug cannot pay.",
  "start": 21.01,
  "end": 21.86
 },
 {
  "voice": "am_puck",
  "text": "Doug poor.",
  "start": 21.89,
  "end": 22.49
 },
 {
  "voice": "am_puck",
  "text": "So Walrus lend Doug 110 more fish.",
  "start": 22.64,
  "end": 24.92
 },
 {
  "voice": "am_puck",
  "text": "Doug pay Walrus with Walrus fish.",
  "start": 24.95,
  "end": 26.57
 },
 {
  "voice": "am_puck",
  "text": "Debt never end.",
  "start": 26.6,
  "end": 27.39
 },
 {
  "voice": "am_puck",
  "text": "Interest never end. Walrus smile.",
  "start": 27.42,
  "end": 29.1
 },
 {
  "voice": "am_puck",
  "text": "This is called rollover.",
  "start": 29.13,
  "end": 30.13
 },
 {
  "voice": "am_puck",
  "text": "So why Walrus keep lending?",
  "start": 30.16,
  "end": 31.48
 },
 {
  "voice": "am_puck",
  "text": "Three reasons.",
  "start": 31.51,
  "end": 32.22
 },
 {
  "voice": "am_puck",
  "text": "One. If Broke Island sink, Walrus lose all fish.",
  "start": 32.25,
  "end": 34.65
 },
 {
  "voice": "am_puck",
  "text": "Two. Doug buy nets and boats from Walrus.",
  "start": 34.68,
  "end": 36.53
 },
 {
  "voice": "am_puck",
  "text": "Fish come back.",
  "start": 36.56,
  "end": 37.31
 },
 {
  "voice": "am_puck",
  "text": "Three. Doug owe Walrus.",
  "start": 37.34,
  "end": 38.36
 },
 {
  "voice": "am_puck",
  "text": "So Doug listen to Walrus.",
  "start": 38.39,
  "end": 39.58
 },
 {
  "voice": "am_puck",
  "text": "This is called power.",
  "start": 39.61,
  "end": 40.56
 },
 {
  "voice": "am_puck",
  "text": "Doug owned.",
  "start": 40.59,
  "end": 41.18
 },
 {
  "voice": "am_puck",
  "text": "Real life.",
  "start": 41.33,
  "end": 41.99
 },
 {
  "voice": "am_puck",
  "text": "In 2018, the IMF lent Argentina 44 billion dollars.",
  "start": 42.02,
  "end": 46.47
 },
 {
  "voice": "am_puck",
  "text": "Biggest loan in IMF history.",
  "start": 46.5,
  "end": 48.03
 },
 {
  "voice": "am_puck",
  "text": "In 2025, Argentina borrow again. Same Doug. Same Walrus.",
  "start": 48.06,
  "end": 52.36
 },
 {
  "voice": "am_puck",
  "text": "Rich countries do not lose money.",
  "start": 52.39,
  "end": 53.76
 },
 {
  "voice": "am_puck",
  "text": "Rich countries win control. Control better than fish.",
  "start": 53.79,
  "end": 56.26
 },
 {
  "voice": "am_puck",
  "text": "Doug finally get sled.",
  "start": 56.29,
  "end": 57.34
 },
 {
  "voice": "am_puck",
  "text": "Life is good.",
  "start": 57.37,
  "end": 58.15
 },
 {
  "voice": "am_puck",
  "text": "Life is not good.",
  "start": 58.18,
  "end": 59.06
 },
 {
  "voice": "am_puck",
  "text": "Sled belong to Walrus.",
  "start": 59.09,
  "end": 60.13
 },
 {
  "voice": "am_puck",
  "text": "Would you lend money to a friend who never pays back?",
  "start": 60.16,
  "end": 62.41
 }
]