[
 {
  "line": 0,
  "text": "Why Doug pay one million dollars for a four hundred thousand dollar house?",
  "start": 0.0,
  "end": 3.66
 },
 {
  "line": 1,
  "text": "Same house.",
  "start": 3.73,
  "end": 4.46
 },
 {
  "line": 2,
  "text": "This is Doug.",
  "start": 4.54,
  "end": 5.29
 },
 {
  "line": 3,
  "text": "Doug want igloo.",
  "start": 5.36,
  "end": 6.1
 },
 {
  "line": 4,
  "text": "Big igloo.",
  "start": 6.17,
  "end": 6.86
 },
 {
  "line": 5,
  "text": "With garage.",
  "start": 6.93,
  "end": 7.61
 },
 {
  "line": 6,
  "text": "Igloo cost four hundred thousand dollars.",
  "start": 7.68,
  "end": 10.03
 },
 {
  "line": 7,
  "text": "That is forty thousand fish.",
  "start": 10.1,
  "end": 11.57
 },
 {
  "line": 8,
  "text": "Doug have zero.",
  "start": 11.64,
  "end": 12.43
 },
 {
  "line": 9,
  "text": "So Doug go to bank.",
  "start": 12.5,
  "end": 13.54
 },
 {
  "line": 10,
  "text": "Fox lend Doug the fish.",
  "start": 13.61,
  "end": 14.87
 },
 {
  "line": 11,
  "text": "But Fox want something back.",
  "start": 14.94,
  "end": 16.19
 },
 {
  "line": 12,
  "text": "Fox want interest.",
  "start": 16.26,
  "end": 17.15
 },
 {
  "line": 13,
  "text": "Interest is rent for money.",
  "start": 17.22,
  "end": 18.61
 },
 {
  "line": 14,
  "text": "Doug rent the fish.",
  "start": 18.68,
  "end": 19.66
 },
 {
  "line": 15,
  "text": "Every year, Fox take seven point four percent.",
  "start": 19.73,
  "end": 22.47
 },
 {
  "line": 16,
  "text": "Doug pay every month.",
  "start": 22.54,
  "end": 23.64
 },
 {
  "line": 17,
  "text": "For thirty years.",
  "start": 23.71,
  "end": 24.54
 },
 {
  "line": 18,
  "text": "Three hundred sixty payments.",
  "start": 24.61,
  "end": 25.97
 },
 {
  "line": 19,
  "text": "First payment:",
  "start": 26.04,
  "end": 26.66
 },
 {
  "line": 20,
  "text": "two thousand four hundred go to Fox.",
  "start": 26.73,
  "end": 28.74
 },
 {
  "line": 21,
  "text": "Only three hundred go to igloo.",
  "start": 28.81,
  "end": 30.39
 },
 {
  "line": 22,
  "text": "Ten years later, Doug still owe three hundred forty six thousand.",
  "start": 30.46,
  "end": 34.21
 },
 {
  "line": 23,
  "text": "This is called a mortgage.",
  "start": 34.28,
  "end": 35.35
 },
 {
  "line": 24,
  "text": "In old French, mortgage mean death pledge.",
  "start": 35.42,
  "end": 37.97
 },
 {
  "line": 25,
  "text": "Doug poor.",
  "start": 38.04,
  "end": 38.62
 },
 {
  "line": 26,
  "text": "In real life, at seven point four percent, Doug pay two thousand seven hundred seventy dollars a month.",
  "start": 38.97,
  "end": 44.72
 },
 {
  "line": 27,
  "text": "Thirty years later:",
  "start": 44.79,
  "end": 45.72
 },
 {
  "line": 28,
  "text": "almost one million dollars.",
  "start": 45.79,
  "end": 47.4
 },
 {
  "line": 29,
  "text": "Six hundred thousand is just interest.",
  "start": 47.47,
  "end": 49.55
 },
 {
  "line": 30,
  "text": "All interest go to Larry's bank.",
  "start": 49.62,
  "end": 51.39
 },
 {
  "line": 31,
  "text": "Larry laugh.",
  "start": 51.46,
  "end": 52.13
 },
 {
  "line": 32,
  "text": "Doug make last payment.",
  "start": 52.2,
  "end": 53.3
 },
 {
  "line": 33,
  "text": "Doug is old.",
  "start": 53.37,
  "end": 54.03
 },
 {
  "line": 34,
  "text": "Igloo is Doug's.",
  "start": 54.1,
  "end": 55.1
 },
 {
  "line": 35,
  "text": "Life is good.",
  "start": 55.17,
  "end": 55.85
 },
 {
  "line": 36,
  "text": "Then Tax Gull come.",
  "start": 55.92,
  "end": 56.88
 },
 {
  "line": 37,
  "text": "Property tax.",
  "start": 56.95,
  "end": 57.8
 },
 {
  "line": 38,
  "text": "Every year.",
  "start": 57.87,
  "end": 58.47
 },
 {
  "line": 39,
  "text": "Forever.",
  "start": 58.54,
  "end": 59.02
 },
 {
  "line": 40,
  "text": "Doug own igloo.",
  "start": 59.09,
  "end": 59.88
 },
 {
  "line": 41,
  "text": "Igloo own Doug.",
  "start": 59.95,
  "end": 60.79
 },
 {
  "line": 42,
  "text": "Would you rent or buy at seven point four percent?",
  "start": 60.86,
  "end": 63.35
 },
 {
  "line": 43,
  "text": "Tell Doug in the comments.",
  "start": 63.42,
  "end": 64.69
 }
]