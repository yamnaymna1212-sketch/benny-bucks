[
 {
  "voice": "am_michael",
  "text": "Why do rich countries fight wars over cars?",
  "start": 0.0,
  "end": 2.54
 },
 {
  "voice": "am_michael",
  "text": "This is Doug.",
  "start": 2.69,
  "end": 3.57
 },
 {
  "voice": "am_michael",
  "text": "Doug want truck.",
  "start": 3.64,
  "end": 4.58
 },
 {
  "voice": "am_michael",
  "text": "Toyota make tough truck.",
  "start": 4.7,
  "end": 6.06
 },
 {
  "voice": "am_michael",
  "text": "Name: Hilux.",
  "start": 6.13,
  "end": 7.1
 },
 {
  "voice": "am_michael",
  "text": "Whole world drive Hilux.",
  "start": 7.22,
  "end": 8.71
 },
 {
  "voice": "am_michael",
  "text": "But in America, Doug can't buy Hilux.",
  "start": 8.83,
  "end": 10.97
 },
 {
  "voice": "am_michael",
  "text": "Why?",
  "start": 11.09,
  "end": 11.56
 },
 {
  "voice": "am_michael",
  "text": "Chicken.",
  "start": 11.63,
  "end": 12.26
 },
 {
  "voice": "am_michael",
  "text": "In nineteen sixty-four, Europe put tax on American chicken.",
  "start": 12.41,
  "end": 15.94
 },
 {
  "voice": "am_michael",
  "text": "America angry.",
  "start": 16.06,
  "end": 17.08
 },
 {
  "voice": "am_michael",
  "text": "America put tax on foreign trucks.",
  "start": 17.15,
  "end": 19.18
 },
 {
  "voice": "am_michael",
  "text": "Twenty-five percent tax.",
  "start": 19.3,
  "end": 20.73
 },
 {
  "voice": "am_michael",
  "text": "This is called Chicken Tax.",
  "start": 20.88,
  "end": 22.45
 },
 {
  "voice": "am_michael",
  "text": "Doug confused.",
  "start": 22.65,
  "end": 23.72
 },
 {
  "voice": "am_michael",
  "text": "Chicken war is over. Tax is not.",
  "start": 24.07,
  "end": 26.12
 },
 {
  "voice": "am_michael",
  "text": "Sixty years later, tax still here.",
  "start": 26.24,
  "end": 28.19
 },
 {
  "voice": "am_michael",
  "text": "Why?",
  "start": 28.34,
  "end": 28.81
 },
 {
  "voice": "am_michael",
  "text": "Because car is not car.",
  "start": 28.88,
  "end": 30.39
 },
 {
  "voice": "am_michael",
  "text": "Car is jobs.",
  "start": 30.46,
  "end": 31.55
 },
 {
  "voice": "am_michael",
  "text": "One car factory. Thousand workers.",
  "start": 31.7,
  "end": 33.91
 },
 {
  "voice": "am_michael",
  "text": "Thousand workers buy fish, igloo, snow cone.",
  "start": 34.03,
  "end": 36.7
 },
 {
  "voice": "am_michael",
  "text": "Factory close, whole town cry.",
  "start": 36.82,
  "end": 38.66
 },
 {
  "voice": "am_michael",
  "text": "In real life, Toyota alone has almost four hundred thousand workers.",
  "start": 38.86,
  "end": 43.12
 },
 {
  "voice": "am_michael",
  "text": "And car is also war.",
  "start": 43.32,
  "end": 44.82
 },
 {
  "voice": "am_michael",
  "text": "In World War Two, American car factories built tanks and bombers.",
  "start": 44.94,
  "end": 48.85
 },
 {
  "voice": "am_michael",
  "text": "No car factory, no tanks.",
  "start": 48.97,
  "end": 50.82
 },
 {
  "voice": "am_michael",
  "text": "So rich countries fight.",
  "start": 51.02,
  "end": 52.28
 },
 {
  "voice": "am_michael",
  "text": "America protect Tesla.",
  "start": 52.4,
  "end": 53.85
 },
 {
  "voice": "am_michael",
  "text": "Everyone protect their own car.",
  "start": 53.92,
  "end": 55.71
 },
 {
  "voice": "am_michael",
  "text": "Doug understand now.",
  "start": 55.91,
  "end": 57.14
 },
 {
  "voice": "am_michael",
  "text": "Doug still want Hilux.",
  "start": 57.29,
  "end": 58.56
 },
 {
  "voice": "am_michael",
  "text": "Hilux still not here.",
  "start": 58.63,
  "end": 59.88
 },
 {
  "voice": "am_michael",
  "text": "Would you pay twenty-five percent more for a Hilux?",
  "start": 60.08,
  "end": 62.68
 }
]