[
 {
  "voice": "am_puck",
  "text": "Why do rich countries fight wars over cars?",
  "start": 0.0,
  "end": 2.27
 },
 {
  "voice": "am_puck",
  "text": "This is Doug.",
  "start": 2.58,
  "end": 3.33
 },
 {
  "voice": "am_puck",
  "text": "Doug want truck.",
  "start": 3.56,
  "end": 4.41
 },
 {
  "voice": "am_puck",
  "text": "Toyota make tough truck.",
  "start": 4.69,
  "end": 5.94
 },
 {
  "voice": "am_puck",
  "text": "Name: Hilux.",
  "start": 6.17,
  "end": 7.03
 },
 {
  "voice": "am_puck",
  "text": "Whole world drive Hilux.",
  "start": 7.31,
  "end": 8.57
 },
 {
  "voice": "am_puck",
  "text": "But in America, Doug can't buy Hilux.",
  "start": 8.85,
  "end": 10.77
 },
 {
  "voice": "am_puck",
  "text": "Why?",
  "start": 11.05,
  "end": 11.51
 },
 {
  "voice": "am_puck",
  "text": "Chicken.",
  "start": 11.74,
  "end": 12.36
 },
 {
  "voice": "am_puck",
  "text": "In nineteen sixty-four, Europe put tax on American chicken.",
  "start": 12.67,
  "end": 15.98
 },
 {
  "voice": "am_puck",
  "text": "America angry.",
  "start": 16.26,
  "end": 17.17
 },
 {
  "voice": "am_puck",
  "text": "America put tax on foreign trucks.",
  "start": 17.4,
  "end": 19.18
 },
 {
  "voice": "am_puck",
  "text": "Twenty-five percent tax.",
  "start": 19.46,
  "end": 20.84
 },
 {
  "voice": "am_puck",
  "text": "This is called Chicken Tax.",
  "start": 21.15,
  "end": 22.56
 },
 {
  "voice": "am_puck",
  "text": "Doug confused.",
  "start": 22.92,
  "end": 23.84
 },
 {
  "voice": "am_puck",
  "text": "Chicken war is over. Tax is not.",
  "start": 24.35,
  "end": 26.15
 },
 {
  "voice": "am_puck",
  "text": "Sixty years later, tax still here.",
  "start": 26.43,
  "end": 28.13
 },
 {
  "voice": "am_puck",
  "text": "Why?",
  "start": 28.44,
  "end": 28.91
 },
 {
  "voice": "am_puck",
  "text": "Because car is not car.",
  "start": 29.14,
  "end": 30.33
 },
 {
  "voice": "am_puck",
  "text": "Car is jobs.",
  "start": 30.56,
  "end": 31.49
 },
 {
  "voice": "am_puck",
  "text": "One car factory. Thousand workers.",
  "start": 31.8,
  "end": 33.89
 },
 {
  "voice": "am_puck",
  "text": "Thousand workers buy fish, igloo, snow cone.",
  "start": 34.17,
  "end": 36.67
 },
 {
  "voice": "am_puck",
  "text": "Factory close, whole town cry.",
  "start": 36.95,
  "end": 38.63
 },
 {
  "voice": "am_puck",
  "text": "In real life, Toyota alone has almost four hundred thousand workers.",
  "start": 38.99,
  "end": 43.03
 },
 {
  "voice": "am_puck",
  "text": "And car is also war.",
  "start": 43.39,
  "end": 44.54
 },
 {
  "voice": "am_puck",
  "text": "In World War Two, American car factories built tanks and bombers.",
  "start": 44.82,
  "end": 48.66
 },
 {
  "voice": "am_puck",
  "text": "No car factory, no tanks.",
  "start": 48.94,
  "end": 50.4
 },
 {
  "voice": "am_puck",
  "text": "So rich countries fight.",
  "start": 50.76,
  "end": 51.96
 },
 {
  "voice": "am_puck",
  "text": "America protect Tesla.",
  "start": 52.24,
  "end": 53.59
 },
 {
  "voice": "am_puck",
  "text": "Everyone protect their own car.",
  "start": 53.82,
  "end": 55.23
 },
 {
  "voice": "am_puck",
  "text": "Doug understand now.",
  "start": 55.59,
  "end": 56.65
 },
 {
  "voice": "am_puck",
  "text": "Doug still want Hilux.",
  "start": 56.96,
  "end": 58.1
 },
 {
  "voice": "am_puck",
  "text": "Hilux still not here.",
  "start": 58.33,
  "end": 59.37
 },
 {
  "voice": "am_puck",
  "text": "Would you pay twenty-five percent more for a Hilux?",
  "start": 59.73,
  "end": 62.1
 }
]