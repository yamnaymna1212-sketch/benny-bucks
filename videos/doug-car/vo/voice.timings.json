[
 {
  "voice": "am_michael",
  "text": "How poor Doug buy car?",
  "start": 0.0,
  "end": 1.48
 },
 {
  "voice": "am_michael",
  "text": "Two hundred fifty thousand dollars.",
  "start": 1.6,
  "end": 3.63
 },
 {
  "voice": "am_michael",
  "text": "How rich Doug buy car?",
  "start": 3.83,
  "end": 5.39
 },
 {
  "voice": "am_michael",
  "text": "Five thousand dollars.",
  "start": 5.51,
  "end": 6.82
 },
 {
  "voice": "am_michael",
  "text": "Same Doug.",
  "start": 7.02,
  "end": 7.8
 },
 {
  "voice": "am_michael",
  "text": "This is Doug.",
  "start": 8.2,
  "end": 9.11
 },
 {
  "voice": "am_michael",
  "text": "Doug want shiny car.",
  "start": 9.18,
  "end": 10.53
 },
 {
  "voice": "am_michael",
  "text": "Poor Doug go to Larry car shop.",
  "start": 10.63,
  "end": 12.52
 },
 {
  "voice": "am_michael",
  "text": "Car cost two hundred fifty thousand.",
  "start": 12.59,
  "end": 14.74
 },
 {
  "voice": "am_michael",
  "text": "Doug have nothing.",
  "start": 14.81,
  "end": 15.81
 },
 {
  "voice": "am_michael",
  "text": "Fox the banker say, \"Fox lend.\"",
  "start": 15.91,
  "end": 18.04
 },
 {
  "voice": "am_michael",
  "text": "Doug say, \"Yes.\"",
  "start": 18.11,
  "end": 19.18
 },
 {
  "voice": "am_michael",
  "text": "If Doug borrow, Doug pay extra.",
  "start": 19.28,
  "end": 21.16
 },
 {
  "voice": "am_michael",
  "text": "Extra called interest.",
  "start": 21.23,
  "end": 22.63
 },
 {
  "voice": "am_michael",
  "text": "Every month, Doug pay over four thousand dollars.",
  "start": 22.73,
  "end": 25.49
 },
 {
  "voice": "am_michael",
  "text": "Then car leave the shop.",
  "start": 25.59,
  "end": 27.02
 },
 {
  "voice": "am_michael",
  "text": "Car lose value.",
  "start": 27.09,
  "end": 28.25
 },
 {
  "voice": "am_michael",
  "text": "Down. Down. Down.",
  "start": 28.32,
  "end": 29.53
 },
 {
  "voice": "am_michael",
  "text": "This called depreciation.",
  "start": 29.63,
  "end": 31.1
 },
 {
  "voice": "am_michael",
  "text": "Doug poor.",
  "start": 31.2,
  "end": 31.96
 },
 {
  "voice": "am_michael",
  "text": "Rich Doug go to old car lot.",
  "start": 32.36,
  "end": 34.17
 },
 {
  "voice": "am_michael",
  "text": "Car cost five thousand.",
  "start": 34.24,
  "end": 35.83
 },
 {
  "voice": "am_michael",
  "text": "Doug pay cash.",
  "start": 35.9,
  "end": 36.97
 },
 {
  "voice": "am_michael",
  "text": "No Fox. No interest.",
  "start": 37.04,
  "end": 38.62
 },
 {
  "voice": "am_michael",
  "text": "Old car already lose value.",
  "start": 38.72,
  "end": 40.58
 },
 {
  "voice": "am_michael",
  "text": "Old car lose very little.",
  "start": 40.65,
  "end": 42.28
 },
 {
  "voice": "am_michael",
  "text": "In real life, new car lose about sixty percent in five years.",
  "start": 42.38,
  "end": 46.33
 },
 {
  "voice": "am_michael",
  "text": "Poor Doug lose one hundred fifty thousand,",
  "start": 46.43,
  "end": 48.86
 },
 {
  "voice": "am_michael",
  "text": "plus fifty thousand interest.",
  "start": 48.93,
  "end": 50.63
 },
 {
  "voice": "am_michael",
  "text": "Rich Doug lose almost nothing.",
  "start": 50.73,
  "end": 52.53
 },
 {
  "voice": "am_michael",
  "text": "Rich Doug happy.",
  "start": 52.6,
  "end": 53.66
 },
 {
  "voice": "am_michael",
  "text": "Then Doug drive to work.",
  "start": 53.76,
  "end": 55.21
 },
 {
  "voice": "am_michael",
  "text": "Both car arrive at the same time.",
  "start": 55.28,
  "end": 57.26
 },
 {
  "voice": "am_michael",
  "text": "Would you buy new car or old car?",
  "start": 57.36,
  "end": 59.5
 },
 {
  "voice": "am_michael",
  "text": "Tell Doug in the comments.",
  "start": 59.57,
  "end": 60.92
 }
]