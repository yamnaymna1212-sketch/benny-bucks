  "end": 1.63,
  "text": "this happens."
 },
 {
  "start": 1.77,
  "end": 3.44,
  "text": "Rent is $1,600."
 },
 {
  "start": 3.79,
  "end": 4.8,
  "text": "Doug has $200."
 },
 {
  "start": 5.2,
  "end": 5.76,
  "text": "This is Doug."
 },
 {
  "start": 5.76,
  "end": 6.27,
  "text": "Car repair."
 },
 {
  "start": 6.27,
  "end": 6.76,
  "text": "Groceries."
 },
 {
  "start": 6.76,
  "end": 7.6,
  "text": "One night out."
 },
 {
  "start": 7.61,
  "end": 8.34,
  "text": "Paycheck gone."
 },
 {
  "start": 8.47,
  "end": 8.79,
  "text": "Ring ring."
 },
 {
  "start": 8.79,
  "end": 9.81,
  "text": "Larry the landlord."
 },
 {
  "start": 9.95,
  "end": 10.21,
  "text": "Rent."
 },
 {
  "start": 10.31,
  "end": 11.37,
  "text": "$1,600."
 },
 {
  "start": 11.37,
  "end": 11.93,
  "text": "Now."
 },
 {
  "start": 12.1,
  "end": 13.23,
  "text": "Doug think about baby son."
 },
 {
  "start": 13.36,
  "end": 13.9,
  "text": "Daughter in school."
 },
 {
  "start": 13.9,
  "end": 14.32,
  "text": "Wife."
 },
 {
  "start": 14.52,
  "end": 15.54,
  "text": "Doug try bank loan."
 },
 {
  "start": 15.66,
  "end": 17.0,
  "text": "Bank say: no steady job."
 },
 {
  "start": 17.0,
  "end": 17.35,
  "text": "No."
 },
 {
  "start": 17.45,
  "end": 18.23,
  "text": "Doug call friends."
 },
 {
  "start": 18.23,
  "end": 19.47,
  "text": "Friends more broke than Doug."
 },
 {
  "start": 19.54,
  "end": 20.45,
  "text": "Doug sell his stuff?"
 },
 {
  "start": 20.46,
  "end": 21.24,
  "text": "Doug own nothing."
 },
 {
  "start": 21.35,
  "end": 22.16,
  "text": "Doug rent everything."
 },
 {
  "start": 22.27,
  "end": 22.81,
  "text": "Doug cry."
 },
 {
  "start": 22.95,
  "end": 23.36,
  "text": "Larry again."
 },
 {
  "start": 23.36,
  "end": 23.82,
  "text": "Tonight."
 },
 {
  "start": 23.83,
  "end": 24.81,
  "text": "No money, I bring police."
 },
 {
  "start": 25.03,
  "end": 25.84,
  "text": "Doug want to be duck."
 },
 {
  "start": 25.84,
  "end": 26.71,
  "text": "Duck no pay rent."
 },
 {
  "start": 26.74,
  "end": 27.25,
  "text": "Doug scared."
 },
 {
  "start": 27.57,
  "end": 28.77,
  "text": "Doug find payday loan."
 },
 {
  "start": 28.78,
  "end": 29.84,
  "text": "Borrow $500."
 },
 {
  "start": 30.02,
  "end": 32.14,
  "text": "Two weeks later, pay back $575."
 },
 {
  "start": 33.06,
  "end": 33.84,
  "text": "Doug say no."
 },
 {
  "start": 33.98,
  "end": 34.73,
  "text": "One hour left."
 },
 {
  "start": 34.78,
  "end": 35.73,
  "text": "Doug call 211."
 },
 {
  "start": 36.14,
  "end": 36.78,
  "text": "Charity say yes."
 },
 {
  "start": 36.78,
  "end": 38.11,
  "text": "But money come in two weeks."
 },
 {
  "start": 38.46,
  "end": 39.42,
  "text": "Larry want money tonight."
 },
 {
  "start": 39.51,
  "end": 40.98,
  "text": "Police can't kick Doug out tonight."
 },
 {
  "start": 41.09,
  "end": 41.94,
  "text": "Larry need a judge."
 },
 {
  "start": 42.16,
  "end": 42.85,
  "text": "Court take weeks."
 },
 {
  "start": 42.99,
  "end": 44.12,
  "text": "Larry get zero fish."
 },
 {
  "start": 44.33,
  "end": 45.69,
  "text": "Doug say: $200 now."
 },
 {
  "start": 45.79,
  "end": 46.67,
  "text": "Rest in two weeks."
 },
 {
  "start": 46.85,
  "end": 47.25,
  "text": "Larry sign."
 },
 {
  "start": 47.25,
  "end": 47.97,
  "text": "Doug happy."
 },
 {
  "start": 48.12,
  "end": 48.84,
  "text": "Two weeks later."
 },
 {
  "start": 48.84,
  "end": 49.84,
  "text": "Charity money come."
 },
 {
  "start": 49.87,
  "end": 50.54,
  "text": "Doug pay Larry."
 },
 {
  "start": 50.54,
  "end": 51.66,
  "text": "160 fish."
 },
 {
  "start": 51.92,
  "end": 53.12,
  "text": "Larry count every fish."
 },
 {
  "start": 53.23,
  "end": 53.83,
  "text": "Larry happy."
 },
 {
  "start": 54.02,
  "end": 54.9,
  "text": "Larry buy new hat."
 },
 {
  "start": 54.93,
  "end": 56.16,
  "text": "Doug family sleep warm."
 },
 {
  "start": 56.28,
  "end": 56.65,
  "text": "Next month."
 },
 {
  "start": 56.65,
  "end": 57.16,
  "text": "Ring ring."
 },
 {
  "start": 57.16,
  "end": 58.11,
  "text": "Larry: Rent."
 },
 {
  "start": 58.29,
  "end": 58.54,
  "text": "Now."
 },
 {
  "start": 58.39,
  "end": 59.32,
  "text": "Doug has $200."
 },
 {
  "start": 59.32,
  "end": 59.85,
  "text": "Again."
 },
 {
  "start": 59.85,
  "end": 60.79,
  "text": "What Doug do next?"
 }
