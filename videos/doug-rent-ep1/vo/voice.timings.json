[
 {
  "voice": "am_puck",
  "text": "If you don't pay rent...",
  "start": 0.0,
  "end": 0.96
 },
 {
  "voice": "am_puck",
  "text": "this happens.",
  "start": 1.02,
  "end": 1.66
 },
 {
  "voice": "am_puck",
  "text": "Rent is $1,600.",
  "start": 1.78,
  "end": 3.5
 },
 {
  "voice": "am_puck",
  "text": "Doug has $200.",
  "start": 3.56,
  "end": 4.68
 },
 {
  "voice": "am_puck",
  "text": "This is Doug.",
  "start": 4.8,
  "end": 5.47
 },
 {
  "voice": "am_puck",
  "text": "Car repair. Groceries. One night out.",
  "start": 5.53,
  "end": 7.05
 },
 {
  "voice": "am_puck",
  "text": "Paycheck gone.",
  "start": 7.11,
  "end": 7.81
 },
 {
  "voice": "am_puck",
  "text": "Ring ring.",
  "start": 7.91,
  "end": 8.48
 },
 {
  "voice": "am_puck",
  "text": "Larry the landlord.",
  "start": 8.53,
  "end": 9.35
 },
 {
  "voice": "am_puck",
  "text": "Rent. $1,600. Now.",
  "start": 9.41,
  "end": 11.45
 },
 {
  "voice": "am_puck",
  "text": "Doug think about baby son.",
  "start": 11.55,
  "end": 12.67
 },
 {
  "voice": "am_puck",
  "text": "Daughter in school. Wife.",
  "start": 12.72,
  "end": 13.75
 },
 {
  "voice": "am_puck",
  "text": "Doug try bank loan.",
  "start": 13.85,
  "end": 14.73
 },
 {
  "voice": "am_puck",
  "text": "Bank say: no steady job. No.",
  "start": 14.78,
  "end": 16.13
 },
 {
  "voice": "am_puck",
  "text": "Doug call friends.",
  "start": 16.21,
  "end": 17.02
 },
 {
  "voice": "am_puck",
  "text": "Friends more broke than Doug.",
  "start": 17.07,
  "end": 18.11
 },
 {
  "voice": "am_puck",
  "text": "Doug sell his stuff?",
  "start": 18.19,
  "end": 19.03
 },
 {
  "voice": "am_puck",
  "text": "Doug own nothing. Doug rent everything.",
  "start": 19.08,
  "end": 20.51
 },
 {
  "voice": "am_puck",
  "text": "Doug cry.",
  "start": 20.58,
  "end": 21.21
 },
 {
  "voice": "am_puck",
  "text": "Ring ring. Larry again.",
  "start": 21.33,
  "end": 22.31
 },
 {
  "voice": "am_puck",
  "text": "Tonight. No money, I bring police.",
  "start": 22.37,
  "end": 23.71
 },
 {
  "voice": "am_puck",
  "text": "Doug want to be duck.",
  "start": 23.81,
  "end": 24.7
 },
 {
  "voice": "am_puck",
  "text": "Duck no pay rent.",
  "start": 24.75,
  "end": 25.59
 },
 {
  "voice": "am_puck",
  "text": "Doug scared.",
  "start": 25.71,
  "end": 26.35
 },
 {
  "voice": "am_puck",
  "text": "Doug find payday loan.",
  "start": 26.7,
  "end": 27.76
 },
 {
  "voice": "am_puck",
  "text": "Borrow $500.",
  "start": 27.81,
  "end": 28.97
 },
 {
  "voice": "am_puck",
  "text": "Two weeks later, pay back $575.",
  "start": 29.03,
  "end": 31.6
 },
 {
  "voice": "am_puck",
  "text": "That is almost 400% a year.",
  "start": 31.66,
  "end": 33.28
 },
 {
  "voice": "am_puck",
  "text": "Doug say no.",
  "start": 33.33,
  "end": 33.98
 },
 {
  "voice": "am_puck",
  "text": "One hour left.",
  "start": 34.1,
  "end": 34.78
 },
 {
  "voice": "am_puck",
  "text": "Doug call two one one.",
  "start": 34.88,
  "end": 35.86
 },
 {
  "voice": "am_puck",
  "text": "Two one one find rent help.",
  "start": 35.92,
  "end": 37.14
 },
 {
  "voice": "am_puck",
  "text": "Charity say yes.",
  "start": 37.19,
  "end": 37.99
 },
 {
  "voice": "am_puck",
  "text": "But money come in two weeks.",
  "start": 38.07,
  "end": 39.14
 },
 {
  "voice": "am_puck",
  "text": "Larry want money tonight.",
  "start": 39.19,
  "end": 40.16
 },
 {
  "voice": "am_puck",
  "text": "So Doug do math for Larry.",
  "start": 40.26,
  "end": 41.34
 },
 {
  "voice": "am_puck",
  "text": "Police can't kick Doug out tonight.",
  "start": 41.41,
  "end": 42.76
 },
 {
  "voice": "am_puck",
  "text": "Larry need a judge.",
  "start": 42.81,
  "end": 43.68
 },
 {
  "voice": "am_puck",
  "text": "Court take weeks.",
  "start": 43.75,
  "end": 44.51
 },
 {
  "voice": "am_puck",
  "text": "Larry pay.",
  "start": 44.56,
  "end": 45.13
 },
 {
  "voice": "am_puck",
  "text": "Larry get zero fish.",
  "start": 45.18,
  "end": 46.15
 },
 {
  "voice": "am_puck",
  "text": "Doug say: $200 now.",
  "start": 46.25,
  "end": 47.55
 },
 {
  "voice": "am_puck",
  "text": "Rest in two weeks. In writing.",
  "start": 47.6,
  "end": 49.02
 },
 {
  "voice": "am_puck",
  "text": "Larry sign.",
  "start": 49.1,
  "end": 49.72
 },
 {
  "voice": "am_puck",
  "text": "Doug happy.",
  "start": 49.84,
  "end": 50.49
 },
 {
  "voice": "am_puck",
  "text": "In real life, a landlord can't throw you out without a court order.",
  "start": 50.84,
  "end": 53.75
 },
 {
  "voice": "am_puck",
  "text": "One eviction costs a landlord $2,500 to $8,000.",
  "start": 53.83,
  "end": 57.93
 },
 {
  "voice": "am_puck",
  "text": "Behind on rent? Call two one one.",
  "start": 58.03,
  "end": 59.74
 },
 {
  "voice": "am_puck",
  "text": "Ask for a payment plan. In writing.",
  "start": 59.79,
  "end": 61.28
 },
 {
  "voice": "am_puck",
  "text": "Next episode: Larry raise rent 20%.",
  "start": 61.38,
  "end": 63.33
 },
 {
  "voice": "am_puck",
  "text": "Can Larry do that?",
  "start": 63.39,
  "end": 64.19
 }
]