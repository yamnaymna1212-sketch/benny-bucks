[
 {
  "voice": "am_michael",
  "text": "Why poor country give its oil to rich country...",
  "start": 0.0,
  "end": 2.62
 },
 {
  "voice": "am_michael",
  "text": "for free?",
  "start": 2.67,
  "end": 3.4
 },
 {
  "voice": "am_michael",
  "text": "Poor country: Venezuela.",
  "start": 3.65,
  "end": 5.35
 },
 {
  "voice": "am_michael",
  "text": "Rich country: America.",
  "start": 5.42,
  "end": 7.03
 },
 {
  "voice": "am_michael",
  "text": "America gas: four thirty-three.",
  "start": 7.15,
  "end": 9.18
 },
 {
  "voice": "am_michael",
  "text": "Venezuela gas: thirteen cents.",
  "start": 9.25,
  "end": 11.38
 },
 {
  "voice": "am_michael",
  "text": "This is Doug.",
  "start": 11.5,
  "end": 12.41
 },
 {
  "voice": "am_michael",
  "text": "Doug live in Venezuela.",
  "start": 12.48,
  "end": 14.02
 },
 {
  "voice": "am_michael",
  "text": "Venezuela have the most oil in the world.",
  "start": 14.12,
  "end": 16.44
 },
 {
  "voice": "am_michael",
  "text": "More than Saudi. More than America.",
  "start": 16.51,
  "end": 18.47
 },
 {
  "voice": "am_michael",
  "text": "Doug have oil.",
  "start": 18.59,
  "end": 19.53
 },
 {
  "voice": "am_michael",
  "text": "Doug have no money.",
  "start": 19.6,
  "end": 20.7
 },
 {
  "voice": "am_michael",
  "text": "Oil come out. Oil go in pipe.",
  "start": 20.85,
  "end": 22.65
 },
 {
  "voice": "am_michael",
  "text": "Pipe go to America.",
  "start": 22.72,
  "end": 23.98
 },
 {
  "voice": "am_michael",
  "text": "America man say: \"Thank you, Doug.\"",
  "start": 24.08,
  "end": 26.12
 },
 {
  "voice": "am_michael",
  "text": "America sell the oil.",
  "start": 26.42,
  "end": 27.75
 },
 {
  "voice": "am_michael",
  "text": "Money go to American bank account.",
  "start": 27.82,
  "end": 29.84
 },
 {
  "voice": "am_michael",
  "text": "Doug ask: \"Where my money?\"",
  "start": 29.96,
  "end": 31.53
 },
 {
  "voice": "am_michael",
  "text": "Bank say: \"Later.\"",
  "start": 31.65,
  "end": 32.82
 },
 {
  "voice": "am_michael",
  "text": "In real life, Venezuela sold eighteen billion dollars of oil last year.",
  "start": 33.07,
  "end": 37.61
 },
 {
  "voice": "am_michael",
  "text": "This year, Venezuela got back five hundred million.",
  "start": 37.71,
  "end": 40.71
 },
 {
  "voice": "am_michael",
  "text": "Doug do math.",
  "start": 40.86,
  "end": 41.83
 },
 {
  "voice": "am_michael",
  "text": "Doug poor.",
  "start": 42.13,
  "end": 42.88
 },
 {
  "voice": "am_michael",
  "text": "America man fill big truck.",
  "start": 43.33,
  "end": 45.12
 },
 {
  "voice": "am_michael",
  "text": "Thirty gallons. One hundred thirty dollars.",
  "start": 45.19,
  "end": 47.71
 },
 {
  "voice": "am_michael",
  "text": "Doug fill tiny scooter. Four cents.",
  "start": 47.83,
  "end": 49.96
 },
 {
  "voice": "am_michael",
  "text": "So why poor country give oil?",
  "start": 50.21,
  "end": 51.9
 },
 {
  "voice": "am_michael",
  "text": "Venezuela owe one hundred fifty billion dollars.",
  "start": 52.05,
  "end": 55.2
 },
 {
  "voice": "am_michael",
  "text": "To China. To banks. To everyone.",
  "start": 55.27,
  "end": 57.32
 },
 {
  "voice": "am_michael",
  "text": "And America hold the wallet.",
  "start": 57.47,
  "end": 59.08
 },
 {
  "voice": "am_michael",
  "text": "Doug must pay back.",
  "start": 59.23,
  "end": 60.41
 },
 {
  "voice": "am_michael",
  "text": "Is this fair? Tell Doug.",
  "start": 60.53,
  "end": 61.96
 }
]