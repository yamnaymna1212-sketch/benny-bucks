[
 {
  "voice": "am_michael",
  "text": "Why poor Doug pay forty-one dollars for a six-dollar coffee?",
  "start": 0.0,
  "end": 3.44
 },
 {
  "voice": "am_michael",
  "text": "Rich Doug pay six dollars. Same coffee.",
  "start": 3.56,
  "end": 6.07
 },
 {
  "voice": "am_michael",
  "text": "This is Doug.",
  "start": 6.19,
  "end": 7.06
 },
 {
  "voice": "am_michael",
  "text": "Doug have five dollars.",
  "start": 7.13,
  "end": 8.51
 },
 {
  "voice": "am_michael",
  "text": "Doug want coffee.",
  "start": 8.58,
  "end": 9.57
 },
 {
  "voice": "am_michael",
  "text": "Coffee cost six dollars.",
  "start": 9.64,
  "end": 11.12
 },
 {
  "voice": "am_michael",
  "text": "Doug tap card. Beep.",
  "start": 11.19,
  "end": 12.65
 },
 {
  "voice": "am_michael",
  "text": "Bank say yes. Bank is nice.",
  "start": 12.72,
  "end": 14.51
 },
 {
  "voice": "am_michael",
  "text": "Bank is not nice.",
  "start": 14.81,
  "end": 16.05
 },
 {
  "voice": "am_michael",
  "text": "Next day, letter from Fox the Banker.",
  "start": 16.17,
  "end": 18.3
 },
 {
  "voice": "am_michael",
  "text": "Coffee: six dollars.",
  "start": 18.37,
  "end": 19.61
 },
 {
  "voice": "am_michael",
  "text": "Fee: thirty-five dollars.",
  "start": 19.68,
  "end": 21.15
 },
 {
  "voice": "am_michael",
  "text": "If Doug spend money Doug don't have,",
  "start": 21.22,
  "end": 23.08
 },
 {
  "voice": "am_michael",
  "text": "bank take more money.",
  "start": 23.15,
  "end": 24.32
 },
 {
  "voice": "am_michael",
  "text": "This is called overdraft fee.",
  "start": 24.39,
  "end": 26.11
 },
 {
  "voice": "am_michael",
  "text": "Doug poor.",
  "start": 26.23,
  "end": 26.95
 },
 {
  "voice": "am_michael",
  "text": "Now Doug have minus thirty-six dollars.",
  "start": 27.3,
  "end": 29.49
 },
 {
  "voice": "am_michael",
  "text": "Doug buy gum.",
  "start": 29.56,
  "end": 30.51
 },
 {
  "voice": "am_michael",
  "text": "Another fee. Thirty-five dollars.",
  "start": 30.58,
  "end": 32.59
 },
 {
  "voice": "am_michael",
  "text": "Small gum. Big fee.",
  "start": 32.66,
  "end": 34.03
 },
 {
  "voice": "am_michael",
  "text": "Now rich Doug.",
  "start": 34.15,
  "end": 35.09
 },
 {
  "voice": "am_michael",
  "text": "Rich Doug have big money in bank.",
  "start": 35.16,
  "end": 36.97
 },
 {
  "voice": "am_michael",
  "text": "Rich Doug buy same coffee.",
  "start": 37.04,
  "end": 38.63
 },
 {
  "voice": "am_michael",
  "text": "Card give money back.",
  "start": 38.7,
  "end": 39.91
 },
 {
  "voice": "am_michael",
  "text": "This is called cashback.",
  "start": 39.98,
  "end": 41.29
 },
 {
  "voice": "am_michael",
  "text": "Poor Doug pay more. Rich Doug pay less.",
  "start": 41.36,
  "end": 43.71
 },
 {
  "voice": "am_michael",
  "text": "In real life, big banks still charge up to thirty-five dollars for one overdraft.",
  "start": 43.83,
  "end": 48.63
 },
 {
  "voice": "am_michael",
  "text": "Being poor is expensive.",
  "start": 48.75,
  "end": 50.14
 },
 {
  "voice": "am_michael",
  "text": "Doug go home.",
  "start": 50.26,
  "end": 51.15
 },
 {
  "voice": "am_michael",
  "text": "Doug make coffee at home.",
  "start": 51.22,
  "end": 52.57
 },
 {
  "voice": "am_michael",
  "text": "Home coffee cost thirty cents.",
  "start": 52.64,
  "end": 54.38
 },
 {
  "voice": "am_michael",
  "text": "Doug happy.",
  "start": 54.45,
  "end": 55.25
 },
 {
  "voice": "am_michael",
  "text": "Then Doug check bank.",
  "start": 55.6,
  "end": 56.79
 },
 {
  "voice": "am_michael",
  "text": "Coffee maker. Ninety-nine dollars.",
  "start": 56.86,
  "end": 59.03
 },
 {
  "voice": "am_michael",
  "text": "Doug have five.",
  "start": 59.1,
  "end": 60.11
 },
 {
  "voice": "am_michael",
  "text": "Doug poor again.",
  "start": 60.23,
  "end": 61.16
 },
 {
  "voice": "am_michael",
  "text": "What's the worst fee your bank ever charged you?",
  "start": 61.51,
  "end": 63.67
 }
]