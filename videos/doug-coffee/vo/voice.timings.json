[
 {
  "voice": "am_michael",
  "text": "Why poor Doug pay forty-one dollars for a six-dollar coffee?",
  "start": 0.0,
  "end": 3.31
 },
 {
  "voice": "am_michael",
  "text": "Rich Doug pay six dollars. Same coffee.",
  "start": 3.44,
  "end": 5.91
 },
 {
  "voice": "am_michael",
  "text": "This is Doug.",
  "start": 6.03,
  "end": 6.83
 },
 {
  "voice": "am_michael",
  "text": "Doug have five dollars.",
  "start": 6.9,
  "end": 8.19
 },
 {
  "voice": "am_michael",
  "text": "Doug want coffee.",
  "start": 8.26,
  "end": 9.24
 },
 {
  "voice": "am_michael",
  "text": "Coffee cost six dollars.",
  "start": 9.31,
  "end": 10.77
 },
 {
  "voice": "am_michael",
  "text": "Doug tap card. Beep.",
  "start": 10.84,
  "end": 12.26
 },
 {
  "voice": "am_michael",
  "text": "Bank say yes. Bank is nice.",
  "start": 12.33,
  "end": 14.06
 },
 {
  "voice": "am_michael",
  "text": "Bank is not nice.",
  "start": 14.36,
  "end": 15.48
 },
 {
  "voice": "am_michael",
  "text": "Next day, letter from Fox the Banker.",
  "start": 15.6,
  "end": 17.65
 },
 {
  "voice": "am_michael",
  "text": "Coffee: six dollars.",
  "start": 17.72,
  "end": 18.92
 },
 {
  "voice": "am_michael",
  "text": "Fee: thirty-five dollars.",
  "start": 18.99,
  "end": 20.45
 },
 {
  "voice": "am_michael",
  "text": "If Doug spend money Doug don't have,",
  "start": 20.52,
  "end": 22.28
 },
 {
  "voice": "am_michael",
  "text": "bank take more money.",
  "start": 22.35,
  "end": 23.48
 },
 {
  "voice": "am_michael",
  "text": "This is called overdraft fee.",
  "start": 23.55,
  "end": 25.16
 },
 {
  "voice": "am_michael",
  "text": "Doug poor.",
  "start": 25.28,
  "end": 25.99
 },
 {
  "voice": "am_michael",
  "text": "Now Doug have minus thirty-six dollars.",
  "start": 26.34,
  "end": 28.47
 },
 {
  "voice": "am_michael",
  "text": "Doug buy gum.",
  "start": 28.54,
  "end": 29.43
 },
 {
  "voice": "am_michael",
  "text": "Another fee. Thirty-five dollars.",
  "start": 29.5,
  "end": 31.42
 },
 {
  "voice": "am_michael",
  "text": "Small gum. Big fee.",
  "start": 31.49,
  "end": 32.85
 },
 {
  "voice": "am_michael",
  "text": "Now rich Doug.",
  "start": 32.97,
  "end": 33.85
 },
 {
  "voice": "am_michael",
  "text": "Rich Doug have big money in bank.",
  "start": 33.92,
  "end": 35.65
 },
 {
  "voice": "am_michael",
  "text": "Rich Doug buy same coffee.",
  "start": 35.72,
  "end": 37.3
 },
 {
  "voice": "am_michael",
  "text": "Card give money back.",
  "start": 37.37,
  "end": 38.53
 },
 {
  "voice": "am_michael",
  "text": "This is called cashback.",
  "start": 38.6,
  "end": 39.8
 },
 {
  "voice": "am_michael",
  "text": "Poor Doug pay more. Rich Doug pay less.",
  "start": 39.87,
  "end": 42.18
 },
 {
  "voice": "am_michael",
  "text": "In real life, big banks still charge up to thirty-five dollars for one overdraft.",
  "start": 42.3,
  "end": 46.92
 },
 {
  "voice": "am_michael",
  "text": "Being poor is expensive.",
  "start": 47.04,
  "end": 48.39
 },
 {
  "voice": "am_michael",
  "text": "Doug go home.",
  "start": 48.51,
  "end": 49.38
 },
 {
  "voice": "am_michael",
  "text": "Doug make coffee at home.",
  "start": 49.45,
  "end": 50.74
 },
 {
  "voice": "am_michael",
  "text": "Home coffee cost thirty cents.",
  "start": 50.81,
  "end": 52.52
 },
 {
  "voice": "am_michael",
  "text": "Doug happy.",
  "start": 52.59,
  "end": 53.35
 },
 {
  "voice": "am_michael",
  "text": "Then Doug check bank.",
  "start": 53.7,
  "end": 54.88
 },
 {
  "voice": "am_michael",
  "text": "Coffee maker. Ninety-nine dollars.",
  "start": 54.95,
  "end": 57.07
 },
 {
  "voice": "am_michael",
  "text": "Doug have five.",
  "start": 57.14,
  "end": 58.11
 },
 {
  "voice": "am_michael",
  "text": "Doug poor again.",
  "start": 58.23,
  "end": 59.13
 },
 {
  "voice": "am_michael",
  "text": "What's the worst fee your bank ever charged you?",
  "start": 59.48,
  "end": 61.57
 }
]