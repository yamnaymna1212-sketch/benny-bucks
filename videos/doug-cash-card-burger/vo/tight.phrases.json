[
 {
  "line": 1,
  "text": "What the difference between paying fifteen dollars with cash... and fifteen dollars with card?",
  "start": 0.04,
  "end": 4.64
 },
 {
  "line": 2,
  "text": "Same burger.",
  "start": 5.01,
  "end": 5.67
 },
 {
  "line": 3,
  "text": "Same soda.",
  "start": 5.82,
  "end": 6.43
 },
 {
  "line": 4,
  "text": "Same fifteen dollars.",
  "start": 6.58,
  "end": 7.71
 },
 {
  "line": 5,
  "text": "This is Doug.",
  "start": 7.86,
  "end": 8.49
 },
 {
  "line": 6,
  "text": "Doug is hungry.",
  "start": 8.64,
  "end": 9.32
 },
 {
  "line": 7,
  "text": "Doug go to Puffin Burger.",
  "start": 9.47,
  "end": 10.46
 },
 {
  "line": 8,
  "text": "One burger.",
  "start": 10.61,
  "end": 11.17
 },
 {
  "line": 9,
  "text": "One soda.",
  "start": 11.32,
  "end": 11.84
 },
 {
  "line": 10,
  "text": "Fifteen dollars.",
  "start": 11.99,
  "end": 12.77
 },
 {
  "line": 11,
  "text": "Doug pay cash.",
  "start": 12.92,
  "end": 13.72
 },
 {
  "line": 12,
  "text": "Puffin put fifteen dollars in the box.",
  "start": 13.87,
  "end": 15.84
 },
 {
  "line": 13,
  "text": "All of it.",
  "start": 15.99,
  "end": 16.37
 },
 {
  "line": 14,
  "text": "Next day.",
  "start": 16.52,
  "end": 16.98
 },
 {
  "line": 15,
  "text": "Same burger.",
  "start": 17.13,
  "end": 17.79
 },
 {
  "line": 16,
  "text": "Same soda.",
  "start": 17.94,
  "end": 18.55
 },
 {
  "line": 17,
  "text": "This time, Doug pay with card.",
  "start": 18.7,
  "end": 20.36
 },
 {
  "line": 18,
  "text": "Beep.",
  "start": 20.51,
  "end": 20.75
 },
 {
  "line": 19,
  "text": "Puffin get a little less than fifteen dollars.",
  "start": 20.9,
  "end": 23.04
 },
 {
  "line": 20,
  "text": "Where is the rest?",
  "start": 23.19,
  "end": 23.92
 },
 {
  "line": 21,
  "text": "It pay for the beep.",
  "start": 24.07,
  "end": 24.93
 },
 {
  "line": 22,
  "text": "The card machine.",
  "start": 25.08,
  "end": 25.73
 },
 {
  "line": 23,
  "text": "The card company.",
  "start": 25.88,
  "end": 26.58
 },
 {
  "line": 24,
  "text": "Keeping Doug money safe.",
  "start": 26.73,
  "end": 27.95
 },
 {
  "line": 25,
  "text": "Puffin do not mind.",
  "start": 28.1,
  "end": 29.05
 },
 {
  "line": 26,
  "text": "Card is fast.",
  "start": 29.2,
  "end": 29.96
 },
 {
  "line": 27,
  "text": "Customers love it.",
  "start": 30.11,
  "end": 30.83
 },
 {
  "line": 28,
  "text": "But every beep cost Puffin a few cents.",
  "start": 30.98,
  "end": 33.17
 },
 {
  "line": 29,
  "text": "Puffin Burger is busy.",
  "start": 33.32,
  "end": 34.45
 },
 {
  "line": 30,
  "text": "One hundred customers a day.",
  "start": 34.6,
  "end": 35.78
 },
 {
  "line": 31,
  "text": "Most of them pay with card.",
  "start": 35.93,
  "end": 37.17
 },
 {
  "line": 32,
  "text": "Beep.",
  "start": 37.32,
  "end": 37.56
 },
 {
  "line": 33,
  "text": "Beep.",
  "start": 37.71,
  "end": 37.95
 },
 {
  "line": 34,
  "text": "Beep.",
  "start": 38.1,
  "end": 38.34
 },
 {
  "line": 35,
  "text": "A few cents... times one hundred beeps... every day.",
  "start": 38.49,
  "end": 41.52
 },
 {
  "line": 36,
  "text": "That is real money for a small shop.",
  "start": 41.67,
  "end": 43.18
 },
 {
  "line": 37,
  "text": "So one day... the burger price go up.",
  "start": 43.33,
  "end": 45.35
 },
 {
  "line": 38,
  "text": "A little.",
  "start": 45.5,
  "end": 45.86
 },
 {
  "line": 39,
  "text": "For everybody.",
  "start": 46.01,
  "end": 46.59
 },
 {
  "line": 40,
  "text": "Card people.",
  "start": 46.74,
  "end": 47.27
 },
 {
  "line": 41,
  "text": "Cash people.",
  "start": 47.42,
  "end": 47.97
 },
 {
  "line": 42,
  "text": "Doug.",
  "start": 48.12,
  "end": 48.37
 },
 {
  "line": 43,
  "text": "Card people get points back.",
  "start": 48.84,
  "end": 50.1
 },
 {
  "line": 44,
  "text": "Cash people get... nothing extra.",
  "start": 50.25,
  "end": 52.0
 },
 {
  "line": 45,
  "text": "Some shops say: pay cash, small discount.",
  "start": 52.15,
  "end": 54.95
 },
 {
  "line": 46,
  "text": "Some shops say: pay card, small extra fee.",
  "start": 55.1,
  "end": 58.04
 },
 {
  "line": 47,
  "text": "Now Doug look at the sign before he pay.",
  "start": 58.19,
  "end": 59.94
 },
 {
  "line": 48,
  "text": "Card: fast, safe, points.",
  "start": 60.09,
  "end": 62.51
 },
 {
  "line": 49,
  "text": "Cash: no beep, no extra cost for Puffin.",
  "start": 62.66,
  "end": 65.6
 },
 {
  "line": 50,
  "text": "Cash or card?",
  "start": 65.75,
  "end": 66.58
 },
 {
  "line": 51,
  "text": "Which one you use?",
  "start": 66.73,
  "end": 67.46
 },
 {
  "line": 52,
  "text": "Tell Doug in the comments.",
  "start": 67.61,
  "end": 68.8
 }
