  "end": 35.38
 },
 {
  "line": 30,
  "text": "A little.",
  "start": 35.46,
  "end": 35.89
 },
 {
  "line": 31,
  "text": "For everybody.",
  "start": 35.97,
  "end": 36.61
 },
 {
