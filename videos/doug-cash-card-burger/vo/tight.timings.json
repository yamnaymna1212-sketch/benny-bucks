 },
 {
  "line": 18,
  "text": "Beep.",
  "start": 20.48,
  "end": 20.78
 },
 {
  "line": 19,
  "text": "Puffin get a little less than fifteen dollars.",
  "start": 20.86,
  "end": 23.07
 },
 {
  "line": 20,
  "text": "Where is the rest?",
  "start": 23.15,
  "end": 23.95
 },
 {
  "line": 21,
  "text": "It pay for the beep.",
  "start": 24.03,
  "end": 24.96
 },
 {
