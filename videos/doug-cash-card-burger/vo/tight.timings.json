[
 {
  "line": 1,
  "text": "What the difference between paying fifteen dollars with cash... and fifteen dollars with card?",
  "start": 0.0,
  "end": 4.67
 },
 {
  "line": 2,
  "text": "Same burger.",
  "start": 4.97,
  "end": 5.71
 },
 {
  "line": 3,
  "text": "Same soda.",
  "start": 5.79,
  "end": 6.46
 },
 {
  "line": 4,
  "text": "Same fifteen dollars.",
  "start": 6.54,
  "end": 7.74
 },
 {
  "line": 5,
  "text": "This is Doug.",
  "start": 7.82,
  "end": 8.52
 },
 {
  "line": 6,
  "text": "Doug is hungry.",
  "start": 8.6,
  "end": 9.36
 },
 {
  "line": 7,
  "text": "Doug go to Puffin Burger.",
  "start": 9.44,
  "end": 10.49
 },
 {
  "line": 8,
  "text": "One burger.",
