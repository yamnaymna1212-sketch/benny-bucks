[
 {
  "line": 1,
  "text": "What the difference between paying fifteen dollars with cash... and fifteen dollars with card?",
  "start": 0.0,
  "end": 4.67
 },
 {
  "line": 2,
  "text": "Same burger.",
  "start": 4.97,
  "end": 5.71
 },
 {
  "line": 3,
  "text": "Same soda.",
  "start": 5.79,
  "end": 6.47
 },
 {
  "line": 4,
  "text": "Same fifteen dollars.",
  "start": 6.55,
  "end": 7.74
 },
 {
  "line": 5,
  "text": "This is Doug.",
  "start": 7.82,
  "end": 8.52
 },
 {
  "line": 6,
  "text": "Doug is hungry.",
  "start": 8.6,
  "end": 9.36
 },
 {
  "line": 7,
  "text": "Doug go to Puffin Burger.",
  "start": 9.44,
  "end": 10.49
 },
 {
  "line": 8,
  "text": "One burger.",
  "start": 10.57,
  "end": 11.2
 },
 {
  "line": 9,
  "text": "One soda.",
  "start": 11.28,
  "end": 11.87
 },
 {
  "line": 10,
  "text": "Fifteen dollars.",
  "start": 11.95,
  "end": 12.81
 },
 {
  "line": 11,
  "text": "Doug pay cash.",
  "start": 12.89,
  "end": 13.75
 },
 {
  "line": 12,
  "text": "Puffin put fifteen dollars in the box.",
  "start": 13.83,
  "end": 15.88
 },
 {
  "line": 13,
  "text": "All of it.",
  "start": 15.96,
  "end": 16.4
 },
 {
  "line": 14,
  "text": "Next day.",
  "start": 16.48,
  "end": 17.02
 },
 {
  "line": 15,
  "text": "Same burger.",
  "start": 17.1,
  "end": 17.83
 },
 {
  "line": 16,
  "text": "Same soda.",
  "start": 17.91,
  "end": 18.58
 },
 {
  "line": 17,
  "text": "This time, Doug pay with card.",
  "start": 18.66,
  "end": 20.4
 },
 {
  "line": 18,
  "text": "Beep.",
  "start": 20.48,
  "end": 20.79
 },
 {
  "line": 19,
  "text": "Puffin get a little less than fifteen dollars.",
  "start": 20.87,
  "end": 23.07
 },
 {
  "line": 20,
  "text": "Where is the rest?",
  "start": 23.15,
  "end": 23.96
 },
 {
  "line": 21,
  "text": "It pay for the beep.",
  "start": 24.04,
  "end": 24.97
 },
 {
  "line": 22,
  "text": "The card machine.",
  "start": 25.05,
  "end": 25.76
 },
 {
  "line": 23,
  "text": "The card company.",
  "start": 25.84,
  "end": 26.61
 },
 {
  "line": 24,
  "text": "Keeping Doug money safe.",
  "start": 26.69,
  "end": 27.99
 },
 {
  "line": 25,
  "text": "Puffin do not mind.",
  "start": 28.07,
  "end": 29.08
 },
 {
  "line": 26,
  "text": "Card is fast.",
  "start": 29.16,
  "end": 29.99
 },
 {
  "line": 27,
  "text": "Customers love it.",
  "start": 30.07,
  "end": 30.87
 },
 {
  "line": 28,
  "text": "But every beep cost Puffin a few cents.",
  "start": 30.95,
  "end": 33.21
 },
 {
  "line": 29,
  "text": "Puffin Burger is busy.",
  "start": 33.29,
  "end": 34.48
 },
 {
  "line": 30,
  "text": "One hundred customers a day.",
  "start": 34.56,
  "end": 35.81
 },
 {
  "line": 31,
  "text": "Most of them pay with card.",
  "start": 35.89,
  "end": 37.21
 },
 {
  "line": 32,
  "text": "Beep.",
  "start": 37.29,
  "end": 37.6
 },
 {
  "line": 33,
  "text": "Beep.",
  "start": 37.68,
  "end": 37.98
 },
 {
  "line": 34,
  "text": "Beep.",
  "start": 38.06,
  "end": 38.37
 },
 {
  "line": 35,
  "text": "A few cents... times one hundred beeps... every day.",
  "start": 38.45,
  "end": 41.55
 },
 {
  "line": 36,
  "text": "That is real money for a small shop.",
  "start": 41.63,
  "end": 43.21
 },
 {
  "line": 37,
  "text": "So one day... the burger price go up.",
  "start": 43.29,
  "end": 45.39
 },
 {
  "line": 38,
  "text": "A little.",
  "start": 45.47,
  "end": 45.89
 },
 {
  "line": 39,
  "text": "For everybody.",
  "start": 45.97,
  "end": 46.62
 },
 {
  "line": 40,
  "text": "Card people.",
  "start": 46.7,
  "end": 47.31
 },
 {
  "line": 41,
  "text": "Cash people.",
  "start": 47.39,
  "end": 48.0
 },
 {
  "line": 42,
  "text": "Doug.",
  "start": 48.08,
  "end": 48.4
 },
 {
  "line": 43,
  "text": "Card people get points back.",
  "start": 48.8,
  "end": 50.14
 },
 {
  "line": 44,
  "text": "Cash people get... nothing extra.",
  "start": 50.22,
  "end": 52.03
 },
 {
  "line": 45,
  "text": "Some shops say: pay cash, small discount.",
  "start": 52.11,
  "end": 54.98
 },
 {
  "line": 46,
  "text": "Some shops say: pay card, small extra fee.",
  "start": 55.06,
  "end": 58.07
 },
 {
  "line": 47,
  "text": "Now Doug look at the sign before he pay.",
  "start": 58.15,
  "end": 59.98
 },
 {
  "line": 48,
  "text": "Card: fast, safe, points.",
  "start": 60.06,
  "end": 62.54
 },
 {
  "line": 49,
  "text": "Cash: no beep, no extra cost for Puffin.",
  "start": 62.62,
  "end": 65.63
 },
 {
  "line": 50,
  "text": "Cash or card?",
  "start": 65.71,
  "end": 66.62
 },
 {
  "line": 51,
  "text": "Which one you use?",
  "start": 66.7,
  "end": 67.49
 },
 {
  "line": 52,
  "text": "Tell Doug in the comments.",
  "start": 67.57,
  "end": 68.83
 }
