[
 {
  "start": 0.04,
  "end": 4.07,
  "text": "What the difference between paying fifty dollars with debit... and fifty dollars with credit?"
 },
 {
  "start": 4.43,
  "end": 5.46,
  "text": "Same fifty dollars."
 },
 {
  "start": 5.6,
  "end": 5.91,
  "text": "Today."
 },
 {
  "start": 6.06,
  "end": 6.68,
  "text": "This is Doug."
 },
 {
  "start": 6.82,
  "end": 7.8,
  "text": "Doug need new jacket."
 },
 {
  "start": 7.94,
  "end": 8.88,
  "text": "Puffin sell jacket."
 },
 {
  "start": 9.02,
  "end": 9.68,
  "text": "Fifty dollars."
 },
 {
  "start": 9.83,
  "end": 10.93,
  "text": "Doug pay with debit card."
 },
 {
  "start": 11.07,
  "end": 11.3,
  "text": "Beep."
 },
 {
  "start": 11.45,
  "end": 13.4,
  "text": "Fifty dollars leave Doug bank account."
 },
 {
  "start": 13.55,
  "end": 13.94,
  "text": "Right now."
 },
 {
  "start": 14.09,
  "end": 14.32,
  "text": "Done."
 },
 {
  "start": 14.46,
  "end": 14.8,
  "text": "Simple."
 },
 {
  "start": 14.95,
  "end": 16.9,
  "text": "Next winter, Doug pay with credit card."
 },
 {
  "start": 17.04,
  "end": 17.28,
  "text": "Beep."
 },
 {
  "start": 17.42,
  "end": 17.91,
  "text": "Doug account?"
 },
 {
  "start": 18.06,
  "end": 18.6,
  "text": "Still full."
 },
 {
  "start": 18.74,
  "end": 20.54,
  "text": "Fox the Banker pay Puffin for Doug."
 },
 {
  "start": 20.69,
  "end": 22.32,
  "text": "Now Doug owe Fox fifty dollars."
 },
 {
  "start": 22.46,
  "end": 23.86,
  "text": "One month later, the bill come."
 },
 {
  "start": 24.01,
  "end": 27.48,
  "text": "If Doug pay all fifty dollars on time... interest: zero."
 },
 {
  "start": 27.62,
  "end": 28.6,
  "text": "Doug even get points."
 },
 {
  "start": 28.74,
  "end": 30.02,
  "text": "And his credit score can go up."
 },
 {
  "start": 30.16,
  "end": 30.66,
  "text": "Doug smart."
 },
 {
  "start": 31.11,
  "end": 32.38,
  "text": "But if Doug pay only a little..."
 },
 {
  "start": 32.52,
  "end": 33.28,
  "text": "Fox add interest."
 },
 {
  "start": 33.42,
  "end": 33.97,
  "text": "Every month."
 },
 {
  "start": 34.12,
  "end": 37.89,
  "text": "In real life, average credit card interest is about twenty-two percent a year."
 },
 {
  "start": 38.04,
  "end": 39.28,
  "text": "That is Federal Reserve data."
 },
 {
  "start": 39.42,
  "end": 40.51,
  "text": "Fifty dollars for one year?"
 },
 {
  "start": 40.66,
  "end": 42.37,
  "text": "Doug pay more than ten dollars extra."
 },
 {
  "start": 42.51,
  "end": 44.3,
  "text": "One night, Stoat steal Doug card."
 },
 {
  "start": 44.44,
  "end": 44.83,
  "text": "With debit?"
 },
 {
  "start": 44.98,
  "end": 45.82,
  "text": "Doug own money gone."
 },
 {
  "start": 45.96,
  "end": 46.88,
  "text": "Doug wait for the bank."
 },
 {
  "start": 47.02,
  "end": 47.44,
  "text": "With credit?"
 },
 {
  "start": 47.58,
  "end": 48.32,
  "text": "It is Fox money."
 },
 {
  "start": 48.46,
  "end": 51.31,
  "text": "By law, Doug pay fifty dollars max. Usually zero."
 },
 {
  "start": 51.46,
  "end": 53.45,
  "text": "Debit: you spend only money you have."
 },
 {
  "start": 53.59,
  "end": 54.49,
  "text": "Credit: you borrow."
 },
 {
  "start": 54.64,
  "end": 56.81,
  "text": "Points and protection, but pay back in full."
 },
 {
  "start": 56.96,
  "end": 57.46,
  "text": "Same beep."
 },
 {
  "start": 57.6,
  "end": 58.34,
  "text": "Very different bill."
 },
 {
  "start": 58.48,
  "end": 59.14,
  "text": "Debit or credit?"
 },
 {
  "start": 59.29,
  "end": 59.98,
  "text": "Which one you use?"
 },
 {
  "start": 60.13,
  "end": 61.28,
  "text": "Tell Doug in the comments."
 }
]