[
 {
  "start": 0.0,
  "end": 2.38,
  "text": "Why poor country give its oil to rich country..."
 },
 {
  "start": 2.43,
  "end": 3.21,
  "text": "for free?"
 },
 {
  "start": 3.41,
  "end": 5.16,
  "text": "America gas: four thirty-three."
 },
 {
  "start": 5.22,
  "end": 7.08,
  "text": "Venezuela gas: thirteen cents."
 },
 {
  "start": 7.18,
  "end": 8.22,
  "text": "This is Doug."
 },
 {
  "start": 8.28,
  "end": 9.8,
  "text": "Doug live in Venezuela."
 },
 {
  "start": 9.88,
  "end": 11.98,
  "text": "Venezuela have the most oil in the world."
 },
 {
  "start": 12.04,
  "end": 13.77,
  "text": "More than Saudi. More than America."
 },
 {
  "start": 13.87,
  "end": 14.94,
  "text": "Doug have oil."
 },
 {
  "start": 15.0,
  "end": 16.17,
  "text": "Doug have no money."
 },
 {
  "start": 16.27,
  "end": 18.86,
  "text": "Doug sell ice. Nobody buy. Everyone have ice."
 },
 {
  "start": 19.01,
  "end": 20.7,
  "text": "Oil come out. Oil go in pipe."
 },
 {
  "start": 20.76,
  "end": 22.09,
  "text": "Pipe go to America."
 },
 {
  "start": 22.17,
  "end": 23.98,
  "text": "America man say: \"Thank you, Doug.\""
 },
 {
  "start": 24.23,
  "end": 25.62,
  "text": "America sell the oil."
 },
 {
  "start": 25.68,
  "end": 27.64,
  "text": "Money go to American bank account."
 },
 {
  "start": 27.74,
  "end": 29.14,
  "text": "Doug ask: \"Where my money?\""
 },
 {
  "start": 29.24,
  "end": 30.4,
  "text": "Bank say: \"Later.\""
 },
 {
  "start": 30.6,
  "end": 33.07,
  "text": "Doug wait one month. Two months. Doug still waiting."
 },
 {
  "start": 33.22,
  "end": 36.95,
  "text": "In real life, Venezuela sold eighteen billion dollars of oil last year."
 },
 {
  "start": 37.03,
  "end": 39.58,
  "text": "This year, Venezuela got back five hundred million."
 },
 {
  "start": 39.7,
  "end": 40.73,
  "text": "Doug do math."
 },
 {
  "start": 40.98,
  "end": 41.79,
  "text": "Doug poor."
 },
 {
  "start": 42.19,
  "end": 43.91,
  "text": "America man fill big truck."
 },
 {
  "start": 43.97,
  "end": 46.12,
  "text": "Thirty gallons. One hundred thirty dollars."
 },
 {
  "start": 46.22,
  "end": 48.19,
  "text": "Doug fill tiny scooter. Four cents."
 },
 {
  "start": 48.39,
  "end": 50.05,
  "text": "So why poor country give oil?"
 },
 {
  "start": 50.17,
  "end": 52.76,
  "text": "Venezuela owe one hundred fifty billion dollars."
 },
 {
  "start": 52.82,
  "end": 54.67,
  "text": "To China. To banks. To everyone."
 },
 {
  "start": 54.79,
  "end": 56.33,
  "text": "And America hold the wallet."
 },
 {
  "start": 56.41,
  "end": 58.15,
  "text": "Big wallet. Doug wallet empty."
 },
 {
  "start": 58.27,
  "end": 59.5,
  "text": "Doug must pay back."
 },
 {
  "start": 59.6,
  "end": 61.03,
  "text": "Is this fair? Tell Doug."
 }
]