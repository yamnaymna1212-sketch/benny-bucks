[
 {
  "start": 0.0,
  "end": 1.28,
  "text": "Doug fill tank in America."
 },
 {
  "start": 1.4,
  "end": 2.48,
  "text": "Sixty-six dollars."
 },
 {
  "start": 2.78,
  "end": 4.45,
  "text": "Doug friend fill tank in Venezuela."
 },
 {
  "start": 4.57,
  "end": 5.28,
  "text": "Two dollars."
 },
 {
  "start": 5.58,
  "end": 6.68,
  "text": "So what the real difference?"
 },
 {
  "start": 6.88,
  "end": 7.63,
  "text": "Three reasons."
 },
 {
  "start": 7.98,
  "end": 8.69,
  "text": "Reason one."
 },
 {
  "start": 8.84,
  "end": 10.72,
  "text": "Gas come from oil. Oil come from ground."
 },
 {
  "start": 10.87,
  "end": 13.3,
  "text": "Venezuela sit on biggest oil pile in the world."
 },
 {
  "start": 13.4,
  "end": 14.32,
  "text": "Bigger than America."
 },
 {
  "start": 14.47,
  "end": 16.63,
  "text": "Lot of oil. Close to home. Gas cheap to get."
 },
 {
  "start": 16.93,
  "end": 17.74,
  "text": "Reason two."
 },
 {
  "start": 17.89,
  "end": 19.14,
  "text": "Boss Bear run Venezuela."
 },
 {
  "start": 19.26,
  "end": 20.36,
  "text": "Gas cost real money."
 },
 {
  "start": 20.46,
  "end": 22.84,
  "text": "Boss Bear say: pay two dollars. I pay rest."
 },
 {
  "start": 22.99,
  "end": 24.14,
  "text": "This is called subsidy."
 },
 {
  "start": 24.44,
  "end": 25.19,
  "text": "Doug jealous."
 },
 {
  "start": 25.64,
  "end": 26.43,
  "text": "Reason three."
 },
 {
  "start": 26.58,
  "end": 29.11,
  "text": "In America, no Boss Bear. Doug pay full price."
 },
 {
  "start": 29.23,
  "end": 31.35,
  "text": "Larry own refinery. Larry want profit."
 },
 {
  "start": 31.47,
  "end": 33.75,
  "text": "Doug pay for oil, refinery, truck, and tax."
 },
 {
  "start": 33.9,
  "end": 35.8,
  "text": "Tax Gull take a piece. Every gallon."
 },
 {
  "start": 36.0,
  "end": 36.61,
  "text": "Doug poor."
 },
 {
  "start": 37.06,
  "end": 40.11,
  "text": "In real life, America gas is about four forty a gallon."
 },
 {
  "start": 40.21,
  "end": 41.98,
  "text": "Venezuela is around thirteen cents."
 },
 {
  "start": 42.28,
  "end": 43.51,
  "text": "Over thirty times cheaper."
 },
 {
  "start": 43.81,
  "end": 45.51,
  "text": "Friend happy. Then friend see the line."
 },
 {
  "start": 45.66,
  "end": 48.42,
  "text": "Boss Bear pay for everyone. Boss Bear run out of fish."
 },
 {
  "start": 48.57,
  "end": 50.56,
  "text": "No fish. No fix. Refinery break."
 },
 {
  "start": 50.76,
  "end": 51.82,
  "text": "Cheap gas. No gas."
 },
 {
  "start": 52.12,
  "end": 52.85,
  "text": "Friend angry."
 },
 {
  "start": 53.25,
  "end": 55.14,
  "text": "Doug pay sixty-six. But no line."
 },
 {
  "start": 55.44,
  "end": 56.14,
  "text": "Doug happy."
 },
 {
  "start": 56.54,
  "end": 57.82,
  "text": "Same tank. Different world."
 },
 {
  "start": 58.12,
  "end": 61.41,
  "text": "Would you take cheap gas with a line, or pay more and go? Tell Doug."
 }
]