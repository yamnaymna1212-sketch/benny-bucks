[
 {
  "start": 0.0,
  "end": 1.88,
  "text": "Why two penguins make same salary,"
 },
 {
  "start": 1.92,
  "end": 3.65,
  "text": "but only one buy his dream car?"
 },
 {
  "start": 3.85,
  "end": 5.83,
  "text": "This is Doug. This is Ricky. Brothers."
 },
 {
  "start": 5.93,
  "end": 7.44,
  "text": "Same job. Same salary."
 },
 {
  "start": 7.5,
  "end": 9.17,
  "text": "Seventy thousand dollars a year."
 },
 {
  "start": 9.27,
  "end": 10.21,
  "text": "Both need a car."
 },
 {
  "start": 10.31,
  "end": 12.99,
  "text": "Doug buy new car. Forty-four thousand dollars."
 },
 {
  "start": 13.05,
  "end": 13.74,
  "text": "With a loan."
 },
 {
  "start": 13.84,
  "end": 16.4,
  "text": "Loan is six hundred fifty dollars every month."
 },
 {
  "start": 16.46,
  "end": 17.41,
  "text": "For seven years."
 },
 {
  "start": 17.51,
  "end": 19.56,
  "text": "New car have warranty. Few repairs."
 },
 {
  "start": 19.66,
  "end": 20.41,
  "text": "Doug happy."
 },
 {
  "start": 20.71,
  "end": 23.54,
  "text": "Ricky buy used car. Ten thousand dollars. Cash."
 },
 {
  "start": 23.64,
  "end": 24.83,
  "text": "Used car cost less."
 },
 {
  "start": 24.89,
  "end": 26.38,
  "text": "But used car can break more."
 },
 {
  "start": 26.44,
  "end": 27.51,
  "text": "Repairs cost money."
 },
 {
  "start": 27.61,
  "end": 30.17,
  "text": "Ricky put his extra money in stocks every month."
 },
 {
  "start": 30.27,
  "end": 31.3,
  "text": "Stocks can go up."
 },
 {
  "start": 31.36,
  "end": 32.78,
  "text": "Stocks can also go down."
 },
 {
  "start": 32.88,
  "end": 33.74,
  "text": "Ricky nervous."
 },
 {
  "start": 34.04,
  "end": 35.58,
  "text": "Money that grow on its own money,"
 },
 {
  "start": 35.62,
  "end": 37.04,
  "text": "is called compound interest."
 },
 {
  "start": 37.16,
  "end": 38.81,
  "text": "Every year, cars lose value."
 },
 {
  "start": 38.87,
  "end": 40.36,
  "text": "This is called depreciation."
 },
 {
  "start": 40.48,
  "end": 44.99,
  "text": "In real life, average new car loan is about forty-four thousand dollars,"
 },
 {
  "start": 45.03,
  "end": 46.18,
  "text": "at about six percent."
 },
 {
  "start": 46.28,
  "end": 48.55,
  "text": "After seven years, Doug car is paid off."
 },
 {
  "start": 48.61,
  "end": 49.49,
  "text": "Doug own the car."
 },
 {
  "start": 49.59,
  "end": 51.51,
  "text": "If stocks grow seven percent a year,"
 },
 {
  "start": 51.55,
  "end": 53.69,
  "text": "Ricky have about seventy thousand dollars,"
 },
 {
  "start": 53.73,
  "end": 54.84,
  "text": "minus his repairs."
 },
 {
  "start": 54.94,
  "end": 56.56,
  "text": "If stocks fall, Ricky have less."
 },
 {
  "start": 56.71,
  "end": 57.56,
  "text": "Same salary."
 },
 {
  "start": 57.62,
  "end": 58.57,
  "text": "Different choices."
 },
 {
  "start": 58.63,
  "end": 59.52,
  "text": "Different numbers."
 }
]