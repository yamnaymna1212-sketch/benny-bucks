[
{
"start": 0.04,
"end": 2.58,
"text": "Why Doug pay four dollars for gas in America..."
},
{
"start": 2.82,
"end": 4.66,
"text": "but thirteen cents in Venezuela?"
},
{
"start": 4.9,
"end": 5.71,
"text": "Same gas."
},
{
"start": 6.18,
"end": 7.06,
"text": "This is Doug."
},
{
"start": 7.3,
"end": 8.51,
"text": "Doug drive snowmobile."
},
{
"start": 8.75,
"end": 10.4,
"text": "Snowmobile drink gas."
},
{
"start": 10.64,
"end": 11.08,
"text": "Every day."
},
{
"start": 11.32,
"end": 12.36,
"text": "Gas come from oil."
},
{
"start": 12.6,
"end": 13.73,
"text": "Oil come from ground."
},
{
"start": 13.97,
"end": 17.07,
"text": "Venezuela sit on biggest oil pile in the world."
},
{
"start": 17.31,
"end": 18.13,
"text": "Bigger than America."
},
{
"start": 18.37,
"end": 20.36,
"text": "But Venezuela do one more trick."
},
{
"start": 20.6,
"end": 21.88,
"text": "Gas cost a lot to make."
},
{
"start": 22.12,
"end": 24.12,
"text": "Boss Bear sell it for almost nothing."
},
{
"start": 24.36,
"end": 25.55,
"text": "Boss Bear pay the rest."
},
{
"start": 25.79,
"end": 26.86,
"text": "This is called subsidy."
},
{
"start": 27.33,
"end": 27.9,
"text": "In America,"
},
{
"start": 28.14,
"end": 28.85,
"text": "no Boss Bear."
},
{
"start": 29.09,
"end": 30.2,
"text": "Larry own refinery."
},
{
"start": 30.44,
"end": 31.36,
"text": "Larry want profit."
},
{
"start": 31.6,
"end": 32.89,
"text": "And Tax Gull take a piece."
},
{
"start": 33.13,
"end": 33.8,
"text": "Every gallon."
},
{
"start": 34.04,
"end": 34.58,
"text": "Doug poor."
},
{
"start": 35.1,
"end": 38.19,
"text": "In real life, American gas is about four forty."
},
{
"start": 38.43,
"end": 39.46,
"text": "Venezuela is thirteen cents."
},
{
"start": 39.7,
"end": 41.0,
"text": "Doug move to Venezuela."
},
{
"start": 41.24,
"end": 43.29,
"text": "Doug fill whole tank for two dollars."
},
{
"start": 43.53,
"end": 44.05,
"text": "Doug happy."
},
{
"start": 44.57,
"end": 45.69,
"text": "Then Doug see the line."
},
{
"start": 45.93,
"end": 47.72,
"text": "Boss Bear pay for everyone's gas."
},
{
"start": 47.96,
"end": 49.04,
"text": "Boss Bear run out of money."
},
{
"start": 49.28,
"end": 50.09,
"text": "Refinery break."
},
{
"start": 50.33,
"end": 50.98,
"text": "Cheap gas."
},
{
"start": 51.22,
"end": 51.83,
"text": "No gas."
},
{
"start": 52.07,
"end": 52.74,
"text": "Doug angry."
},
{
"start": 53.26,
"end": 53.98,
"text": "Three days later,"
},
{
"start": 54.22,
"end": 55.14,
"text": "Doug get gas."
},
{
"start": 55.38,
"end": 56.24,
"text": "Then Doug remember."
},
{
"start": 56.48,
"end": 58.02,
"text": "Venezuela have no snow."
},
{
"start": 58.26,
"end": 60.3,
"text": "Would you wait in line for thirteen-cent gas?"
},
{
"start": 60.54,
"end": 61.66,
"text": "Tell Doug in the comments."
}
]