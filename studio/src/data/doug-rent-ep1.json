[
 {
  "start": 0.0,
  "end": 0.96,
  "text": "If you don't pay rent..."
 },
 {
  "start": 1.02,
  "end": 1.66,
  "text": "this happens."
 },
 {
  "start": 1.78,
  "end": 3.5,
  "text": "Rent is $1,600."
 },
 {
  "start": 3.56,
  "end": 4.68,
  "text": "Doug has $200."
 },
 {
  "start": 4.8,
  "end": 5.47,
  "text": "This is Doug."
 },
 {
  "start": 5.53,
  "end": 7.05,
  "text": "Car repair. Groceries. One night out."
 },
 {
  "start": 7.11,
  "end": 7.81,
  "text": "Paycheck gone."
 },
 {
  "start": 7.91,
  "end": 8.48,
  "text": "Ring ring."
 },
 {
  "start": 8.53,
  "end": 9.35,
  "text": "Larry the landlord."
 },
 {
  "start": 9.41,
  "end": 11.45,
  "text": "Rent. $1,600. Now."
 },
 {
  "start": 11.55,
  "end": 12.67,
  "text": "Doug think about baby son."
 },
 {
  "start": 12.72,
  "end": 13.75,
  "text": "Daughter in school. Wife."
 },
 {
  "start": 13.85,
  "end": 14.73,
  "text": "Doug try bank loan."
 },
 {
  "start": 14.78,
  "end": 16.13,
  "text": "Bank say: no steady job. No."
 },
 {
  "start": 16.21,
  "end": 17.02,
  "text": "Doug call friends."
 },
 {
  "start": 17.07,
  "end": 18.11,
  "text": "Friends more broke than Doug."
 },
 {
  "start": 18.19,
  "end": 19.03,
  "text": "Doug sell his stuff?"
 },
 {
  "start": 19.08,
  "end": 20.51,
  "text": "Doug own nothing. Doug rent everything."
 },
 {
  "start": 20.58,
  "end": 21.21,
  "text": "Doug cry."
 },
 {
  "start": 21.33,
  "end": 22.31,
  "text": "Ring ring. Larry again."
 },
 {
  "start": 22.37,
  "end": 23.71,
  "text": "Tonight. No money, I bring police."
 },
 {
  "start": 23.81,
  "end": 24.7,
  "text": "Doug want to be duck."
 },
 {
  "start": 24.75,
  "end": 25.59,
  "text": "Duck no pay rent."
 },
 {
  "start": 25.71,
  "end": 26.35,
  "text": "Doug scared."
 },
 {
  "start": 26.7,
  "end": 27.76,
  "text": "Doug find payday loan."
 },
 {
  "start": 27.81,
  "end": 28.97,
  "text": "Borrow $500."
 },
 {
  "start": 29.03,
  "end": 31.6,
  "text": "Two weeks later, pay back $575."
 },
 {
  "start": 31.66,
  "end": 33.28,
  "text": "That is almost 400% a year."
 },
 {
  "start": 33.33,
  "end": 33.98,
  "text": "Doug say no."
 },
 {
  "start": 34.1,
  "end": 34.78,
  "text": "One hour left."
 },
 {
  "start": 34.88,
  "end": 35.86,
  "text": "Doug call two one one."
 },
 {
  "start": 35.92,
  "end": 37.14,
  "text": "Two one one find rent help."
 },
 {
  "start": 37.19,
  "end": 37.99,
  "text": "Charity say yes."
 },
 {
  "start": 38.07,
  "end": 39.14,
  "text": "But money come in two weeks."
 },
 {
  "start": 39.19,
  "end": 40.16,
  "text": "Larry want money tonight."
 },
 {
  "start": 40.26,
  "end": 41.34,
  "text": "So Doug do math for Larry."
 },
 {
  "start": 41.41,
  "end": 42.76,
  "text": "Police can't kick Doug out tonight."
 },
 {
  "start": 42.81,
  "end": 43.68,
  "text": "Larry need a judge."
 },
 {
  "start": 43.75,
  "end": 44.51,
  "text": "Court take weeks."
 },
 {
  "start": 44.56,
  "end": 45.13,
  "text": "Larry pay."
 },
 {
  "start": 45.18,
  "end": 46.15,
  "text": "Larry get zero fish."
 },
 {
  "start": 46.25,
  "end": 47.55,
  "text": "Doug say: $200 now."
 },
 {
  "start": 47.6,
  "end": 49.02,
  "text": "Rest in two weeks. In writing."
 },
 {
  "start": 49.1,
  "end": 49.72,
  "text": "Larry sign."
 },
 {
  "start": 49.84,
  "end": 50.49,
  "text": "Doug happy."
 },
 {
  "start": 50.84,
  "end": 53.75,
  "text": "In real life, a landlord can't throw you out without a court order."
 },
 {
  "start": 53.83,
  "end": 57.93,
  "text": "One eviction costs a landlord $2,500 to $8,000."
 },
 {
  "start": 58.03,
  "end": 59.74,
  "text": "Behind on rent? Call two one one."
 },
 {
  "start": 59.79,
  "end": 61.28,
  "text": "Ask for a payment plan. In writing."
 },
 {
  "start": 61.38,
  "end": 63.33,
  "text": "Next episode: Larry raise rent 20%."
 },
 {
  "start": 63.39,
  "end": 64.19,
  "text": "Can Larry do that?"
 }
]