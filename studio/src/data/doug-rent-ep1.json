 {
  "start": 29.04,
  "end": 31.28,
  "text": "Cheaper igloo is far away. Gas cost more."
 },
 {
  "start": 31.35,
  "end": 32.08,
  "text": "Doug eat snow."
 },
 {
  "start": 32.13,
