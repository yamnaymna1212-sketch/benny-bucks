[
 {
  "start": 0,
  "end": 0.94,
  "text": "If you don't pay rent..."
 },
 {
  "start": 0.97,
  "end": 1.63,
  "text": "this happens."
 },
 {
  "start": 1.77,
  "end": 3.39,
  "text": "Rent is $1,600."
 },
 {
  "start": 3.79,
  "end": 4.8,
  "text": "Doug has $200."
 },
 {
  "start": 5.2,
  "end": 5.76,
  "text": "This is Doug."
 },
 {
  "start": 5.76,
  "end": 6.27,
  "text": "Car repair."
 },
 {
  "start": 6.27,
  "end": 6.76,
  "text": "Groceries."
 },
 {
  "start": 6.76,
  "end": 7.6,
  "text": "One night out."
 },
 {
  "start": 7.61,
  "end": 8.34,
  "text": "Paycheck gone."
 },
 {
  "start": 8.47,
  "end": 8.8,
  "text": "Ring ring."
 },
 {
  "start": 8.8,
  "end": 9.81,
  "text": "Larry the landlord."
 },
 {
  "start": 9.95,
  "end": 10.21,
  "text": "Rent."
 },
 {
  "start": 10.31,
  "end": 11.37,
  "text": "$1,600."
 },
 {
  "start": 11.37,
  "end": 11.93,
  "text": "Now."
 },
 {
  "start": 12.1,
  "end": 13.23,
  "text": "Doug think about baby son."
 },
 {
  "start": 13.36,
  "end": 13.9,
  "text": "Daughter in school."
 },
 {
  "start": 13.9,
  "end": 14.32,
  "text": "Wife."
 },
 {
  "start": 14.51,
  "end": 15.54,
  "text": "Doug try bank loan."
 },
 {
  "start": 15.66,
  "end": 17.06,
  "text": "Bank say: no steady job."
 },
 {
  "start": 17.14,
  "end": 17.41,
  "text": "No."
 },
 {
  "start": 17.47,
  "end": 18.19,
  "text": "Doug call friends."
 },
 {
  "start": 18.19,
  "end": 19.47,
  "text": "Friends more broke than Doug."
 },
 {
  "start": 19.5,
  "end": 20.44,
  "text": "Doug sell his stuff?"
 },
 {
  "start": 20.46,
  "end": 21.22,
  "text": "Doug own nothing."
 },
 {
  "start": 21.33,
  "end": 22.14,
  "text": "Doug rent everything."
 },
 {
  "start": 22.27,
  "end": 22.81,
  "text": "Doug cry."
 },
 {
  "start": 22.93,
  "end": 23.36,
  "text": "Larry again."
 },
 {
  "start": 23.36,
  "end": 23.82,
  "text": "Tonight."
 },
 {
  "start": 23.82,
  "end": 24.8,
  "text": "No money, I bring police."
 },
 {
  "start": 24.99,
  "end": 25.83,
  "text": "Doug want to be duck."
 },
 {
  "start": 25.83,
  "end": 26.69,
  "text": "Duck no pay rent."
 },
 {
  "start": 26.71,
  "end": 27.25,
  "text": "Doug scared."
 },
 {
  "start": 27.48,
  "end": 28.77,
  "text": "Doug find payday loan."
 },
 {
  "start": 28.98,
  "end": 29.81,
  "text": "Borrow $500."
 },
 {
  "start": 29.98,
  "end": 32.28,
  "text": "Two weeks later, pay back $575."
 },
 {
  "start": 32.97,
  "end": 34.91,
  "text": "That is almost 400% a year."
 },
 {
  "start": 35.05,
  "end": 35.77,
  "text": "Doug say no."
 },
 {
  "start": 35.9,
  "end": 36.65,
  "text": "One hour left."
 },
 {
  "start": 36.7,
  "end": 37.19,
  "text": "Doug call 211."
 },
 {
  "start": 37.97,
  "end": 38.72,
  "text": "Charity say yes."
 },
 {
  "start": 38.72,
  "end": 40.05,
  "text": "But money come in two weeks."
 },
 {
  "start": 40.42,
  "end": 41.36,
  "text": "Larry want money tonight."
 },
 {
  "start": 41.52,
  "end": 42.92,
  "text": "Police can't kick Doug out tonight."
 },
 {
  "start": 43.0,
  "end": 43.86,
  "text": "Larry need a judge."
 },
 {
  "start": 44.08,
  "end": 44.77,
  "text": "Court take weeks."
 },
 {
  "start": 44.97,
  "end": 46.04,
  "text": "Larry get zero fish."
 },
 {
  "start": 46.27,
  "end": 47.61,
  "text": "Doug say: $200 now."
 },
 {
  "start": 47.69,
  "end": 48.63,
  "text": "Rest in two weeks."
 },
 {
  "start": 48.77,
  "end": 49.19,
  "text": "Larry sign."
 },
 {
  "start": 49.19,
  "end": 49.91,
  "text": "Doug happy."
 },
 {
  "start": 50.11,
  "end": 53.35,
  "text": "In real life, a landlord can't throw you out without a court order."
 },
 {
  "start": 53.52,
  "end": 57.83,
  "text": "One eviction costs a landlord $2,500 to $8,000."
 },
 {
  "start": 57.83,
  "end": 58.66,
  "text": "Behind on rent?"
 },
 {
  "start": 58.66,
  "end": 59.08,
  "text": "Call 211."
 },
 {
  "start": 59.98,
  "end": 61.05,
  "text": "Ask for a payment plan."
 },
 {
  "start": 61.05,
  "end": 61.76,
  "text": "In writing."
 },
 {
  "start": 62.02,
  "end": 63.85,
  "text": "Next episode: Larry raise rent 20%."
 },
 {
  "start": 64.06,
  "end": 65.06,
  "text": "Can Larry do that?"
 }
]