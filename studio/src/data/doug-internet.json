 {
  "start": 17.73,
  "end": 19.13,
  "text": "Price high. Doug pay."
 },
 {
  "start": 19.2,
  "end": 21.22,
  "text": "Then Jio Larry come to India."
 },
 {
  "start": 21.29,
  "end": 23.43,
  "text": "Jio Larry give data free. Free!"
 },
 {
  "start": 23.5,
  "end": 24.77,
  "text": "Airtel Larry panic."
 },
 {
  "start": 24.84,
  "end": 26.35,
  "text": "Airtel Larry cut price."
 },
 {
  "start": 26.42,
  "end": 27.81,
  "text": "All Larry cut price."
 },
 {
  "start": 27.88,
  "end": 29.68,
  "text": "Price go down. Down. Down."
 },
 {
  "start": 29.75,
  "end": 31.3,
  "text": "This is called price war."
 },
 {
  "start": 31.42,
  "end": 33.41,
  "text": "India have one billion phones."
 },
 {
  "start": 33.48,
  "end": 35.89,
  "text": "Larry sell small. Sell to everybody."
 },
 {
  "start": 35.96,
  "end": 38.15,
  "text": "Small price. Many Doug. Big money."
 },
 {
  "start": 38.22,
  "end": 39.49,
  "text": "This is called scale."
 },
 {
  "start": 39.61,
  "end": 40.51,
  "text": "Doug angry."
 },
 {
  "start": 40.86,
  "end": 44.88,
  "text": "In real life, Visible cost twenty-five dollars. Unlimited data."
 },
 {
  "start": 44.95,
  "end": 48.88,
  "text": "Jio cost one hundred eighty-nine rupees. About two dollars."
 },
 {
  "start": 48.95,
  "end": 50.46,
  "text": "But only two gigabytes."
 },
 {
  "start": 50.58,
  "end": 51.91,
  "text": "Doug move to India."
 },
 {
  "start": 51.98,
  "end": 53.73,
  "text": "Doug happy. Life is good."
 },
 {
  "start": 53.8,
  "end": 55.28,
  "text": "Doug watch one video."
 },
 {
  "start": 55.35,
  "end": 56.21,
  "text": "Data gone."
 },
 {
  "start": 56.33,
  "end": 57.59,
  "text": "Doug pay Larry again."
 },
 {
  "start": 57.66,
  "end": 58.92,
  "text": "Life is not good."
 },
 {
  "start": 59.04,
  "end": 60.69,
  "text": "Would you pay less for less data?"
 },
 {
  "start": 60.76,
  "end": 62.12,
  "text": "Tell Doug in the comments."
