[
 {
  "start": 0.0,
  "end": 3.44,
  "text": "Why poor Doug pay forty-one dollars for a six-dollar coffee?"
 },
 {
  "start": 3.56,
  "end": 6.07,
  "text": "Rich Doug pay six dollars. Same coffee."
 },
 {
  "start": 6.19,
  "end": 7.06,
  "text": "This is Doug."
 },
 {
  "start": 7.13,
  "end": 8.51,
  "text": "Doug have five dollars."
 },
 {
  "start": 8.58,
  "end": 9.57,
  "text": "Doug want coffee."
 },
 {
  "start": 9.64,
  "end": 11.12,
  "text": "Coffee cost six dollars."
 },
 {
  "start": 11.19,
  "end": 12.65,
  "text": "Doug tap card. Beep."
 },
 {
  "start": 12.72,
  "end": 14.51,
  "text": "Bank say yes. Bank is nice."
 },
 {
  "start": 14.81,
  "end": 16.05,
  "text": "Bank is not nice."
 },
 {
  "start": 16.17,
  "end": 18.3,
  "text": "Next day, letter from Fox the Banker."
 },
 {
  "start": 18.37,
  "end": 19.61,
  "text": "Coffee: six dollars."
 },
 {
  "start": 19.68,
  "end": 21.15,
  "text": "Fee: thirty-five dollars."
 },
 {
  "start": 21.22,
  "end": 23.08,
  "text": "If Doug spend money Doug don't have,"
 },
 {
  "start": 23.15,
  "end": 24.32,
  "text": "bank take more money."
 },
 {
  "start": 24.39,
  "end": 26.11,
  "text": "This is called overdraft fee."
 },
 {
  "start": 26.23,
  "end": 26.95,
  "text": "Doug poor."
 },
 {
  "start": 27.3,
  "end": 29.49,
  "text": "Now Doug have minus thirty-six dollars."
 },
 {
  "start": 29.56,
  "end": 30.51,
  "text": "Doug buy gum."
 },
 {
  "start": 30.58,
  "end": 32.59,
  "text": "Another fee. Thirty-five dollars."
 },
 {
  "start": 32.66,
  "end": 34.03,
  "text": "Small gum. Big fee."
 },
 {
  "start": 34.15,
  "end": 35.09,
  "text": "Now rich Doug."
 },
 {
  "start": 35.16,
  "end": 36.97,
  "text": "Rich Doug have big money in bank."
 },
 {
  "start": 37.04,
  "end": 38.63,
  "text": "Rich Doug buy same coffee."
 },
 {
  "start": 38.7,
  "end": 39.91,
  "text": "Card give money back."
 },
 {
  "start": 39.98,
  "end": 41.29,
  "text": "This is called cashback."
 },
 {
  "start": 41.36,
  "end": 43.71,
  "text": "Poor Doug pay more. Rich Doug pay less."
 },
 {
  "start": 43.83,
  "end": 48.63,
  "text": "In real life, big banks still charge up to thirty-five dollars for one overdraft."
 },
 {
  "start": 48.75,
  "end": 50.14,
  "text": "Being poor is expensive."
 },
 {
  "start": 50.26,
  "end": 51.15,
  "text": "Doug go home."
 },
 {
  "start": 51.22,
  "end": 52.57,
  "text": "Doug make coffee at home."
 },
 {
  "start": 52.64,
  "end": 54.38,
  "text": "Home coffee cost thirty cents."
 },
 {
  "start": 54.45,
  "end": 55.25,
  "text": "Doug happy."
 },
 {
  "start": 55.6,
  "end": 56.79,
  "text": "Then Doug check bank."
 },
 {
  "start": 56.86,
  "end": 59.03,
  "text": "Coffee maker. Ninety-nine dollars."
 },
 {
  "start": 59.1,
  "end": 60.11,
  "text": "Doug have five."
 },
 {
  "start": 60.23,
  "end": 61.16,
  "text": "Doug poor again."
 },
 {
  "start": 61.51,
  "end": 63.67,
  "text": "What's the worst fee your bank ever charged you?"
 }
]