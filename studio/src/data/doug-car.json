 },
 {
  "start": 22.73,
  "end": 25.49,
  "text": "Every month, Doug pay over four thousand dollars."
 },
 {
  "start": 25.59,
  "end": 27.02,
  "text": "Then car leave the shop."
 },
 {
  "start": 27.09,
  "end": 28.25,
