[
 {
  "start": 0.0,
  "end": 2.13,
  "text": "Why do rich countries fight wars over cars?"
 },
 {
  "start": 2.17,
  "end": 2.88,
  "text": "This is Doug."
 },
 {
  "start": 2.92,
  "end": 3.71,
  "text": "Doug want truck."
 },
 {
  "start": 3.75,
  "end": 4.67,
  "text": "Big, strong truck."
 },
 {
  "start": 4.71,
  "end": 5.92,
  "text": "Toyota make tough truck."
 },
 {
  "start": 5.96,
  "end": 6.72,
  "text": "Name: Hilux."
 },
 {
  "start": 6.76,
  "end": 7.84,
  "text": "Whole world drive Hilux."
 },
 {
  "start": 7.88,
  "end": 8.93,
  "text": "Hilux climb mountain."
 },
 {
  "start": 8.97,
  "end": 9.97,
  "text": "Hilux cross desert."
 },
 {
  "start": 10.01,
  "end": 10.9,
  "text": "Hilux never die."
 },
 {
  "start": 10.94,
  "end": 12.7,
  "text": "But in America, Doug can't buy Hilux."
 },
 {
  "start": 12.74,
  "end": 13.15,
  "text": "Why?"
 },
 {
  "start": 13.19,
  "end": 13.73,
  "text": "Chicken."
 },
 {
  "start": 13.77,
  "end": 16.79,
  "text": "In 1964, Europe put tax on American chicken."
 },
 {
  "start": 16.83,
  "end": 17.67,
  "text": "America angry."
 },
 {
  "start": 17.71,
  "end": 18.81,
  "text": "America want revenge."
 },
 {
  "start": 18.85,
  "end": 20.54,
  "text": "America put tax on foreign trucks."
 },
 {
  "start": 20.58,
  "end": 21.77,
  "text": "25% tax."
 },
 {
  "start": 21.81,
  "end": 24.46,
  "text": "Truck cost $40,000. Tax cost $10,000."
 },
 {
  "start": 24.5,
  "end": 25.74,
  "text": "This is called Chicken Tax."
 },
 {
  "start": 25.78,
  "end": 26.63,
  "text": "Doug confused."
 },
 {
  "start": 26.67,
  "end": 28.35,
  "text": "Chicken war is over. Tax is not."
 },
 {
  "start": 28.39,
  "end": 29.95,
  "text": "60 years later, tax still here."
 },
 {
  "start": 29.99,
  "end": 31.96,
  "text": "So Toyota build truck factory in Texas."
 },
 {
  "start": 32.0,
  "end": 32.86,
  "text": "Made in America."
 },
 {
  "start": 32.9,
  "end": 33.87,
  "text": "No chicken tax."
 },
 {
  "start": 33.91,
  "end": 34.32,
  "text": "Why?"
 },
 {
  "start": 34.36,
  "end": 35.48,
  "text": "Because car is not car."
 },
 {
  "start": 35.52,
  "end": 36.34,
  "text": "Car is jobs."
 },
 {
  "start": 36.38,
  "end": 38.29,
  "text": "One car factory. Thousand workers."
 },
 {
  "start": 38.33,
  "end": 40.52,
  "text": "Thousand workers buy fish, igloo, snow cone."
 },
 {
  "start": 40.56,
  "end": 42.12,
  "text": "Factory close, whole town cry."
 },
 {
  "start": 42.16,
  "end": 45.8,
  "text": "In real life, Toyota alone has almost 400,000 workers."
 },
 {
  "start": 45.84,
  "end": 47.32,
  "text": "Almost like whole city of Miami."
 },
 {
  "start": 47.36,
  "end": 48.42,
  "text": "And car is also war."
 },
 {
  "start": 48.46,
  "end": 52.04,
  "text": "In World War 2, American car factories built tanks and bombers."
 },
 {
  "start": 52.08,
  "end": 53.43,
  "text": "No car factory, no tanks."
 },
 {
  "start": 53.47,
  "end": 54.55,
  "text": "Car factory is power."
 },
 {
  "start": 54.59,
  "end": 55.64,
  "text": "So rich countries fight."
 },
 {
  "start": 55.68,
  "end": 56.86,
  "text": "America protect Tesla."
 },
 {
  "start": 56.9,
  "end": 58.2,
  "text": "Everyone protect their own car."
 },
 {
  "start": 58.24,
  "end": 59.21,
  "text": "Doug understand now."
 },
 {
  "start": 59.25,
  "end": 60.24,
  "text": "Doug still want Hilux."
 },
 {
  "start": 60.28,
  "end": 61.22,
  "text": "Hilux still not here."
 },
 {
  "start": 61.26,
  "end": 63.5,
  "text": "Would you pay 25% more for a Hilux?"
 }
]