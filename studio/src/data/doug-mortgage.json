[
 {
  "start": 0.1,
  "end": 3.67,
  "text": "Why Doug pay one million dollars for a four hundred thousand dollar house?"
 },
 {
  "start": 4.08,
  "end": 4.71,
  "text": "Same house."
 },
 {
  "start": 5.12,
  "end": 5.76,
  "text": "This is Doug."
 },
 {
  "start": 6.17,
  "end": 6.84,
  "text": "Doug want igloo."
 },
 {
  "start": 7.25,
  "end": 9.56,
  "text": "Igloo cost four hundred thousand dollars."
 },
 {
  "start": 9.97,
  "end": 10.7,
  "text": "Doug have zero."
 },
 {
  "start": 11.11,
  "end": 12.05,
  "text": "So Doug go to bank."
 },
 {
  "start": 12.5,
  "end": 13.72,
  "text": "Fox lend Doug the fish."
 },
 {
  "start": 14.15,
  "end": 15.35,
  "text": "But Fox want something back."
 },
 {
  "start": 15.8,
  "end": 16.65,
  "text": "Fox want interest."
 },
 {
  "start": 17.06,
  "end": 19.76,
  "text": "Every year, Fox take seven point four percent."
 },
 {
  "start": 20.18,
  "end": 21.23,
  "text": "Doug pay every month."
 },
 {
  "start": 21.66,
  "end": 22.45,
  "text": "For thirty years."
 },
 {
  "start": 22.93,
  "end": 23.49,
  "text": "First payment:"
 },
 {
  "start": 23.8,
  "end": 25.73,
  "text": "two thousand four hundred go to Fox."
 },
 {
  "start": 26.14,
  "end": 27.6,
  "text": "Only three hundred go to igloo."
 },
 {
  "start": 28.02,
  "end": 29.04,
  "text": "This is called a mortgage."
 },
 {
  "start": 29.45,
  "end": 31.96,
  "text": "In old French, mortgage mean death pledge."
 },
 {
  "start": 32.38,
  "end": 32.86,
  "text": "Doug poor."
 },
 {
  "start": 33.27,
  "end": 39.0,
  "text": "In real life, at seven point four percent, Doug pay two thousand seven hundred seventy dollars a month."
 },
 {
  "start": 39.48,
  "end": 40.33,
  "text": "Thirty years later:"
 },
 {
  "start": 40.79,
  "end": 42.34,
  "text": "almost one million dollars."
 },
 {
  "start": 42.76,
  "end": 44.8,
  "text": "Six hundred thousand is just interest."
 },
 {
  "start": 45.21,
  "end": 46.23,
  "text": "Doug make last payment."
 },
 {
  "start": 46.64,
  "end": 47.25,
  "text": "Doug is old."
 },
 {
  "start": 47.66,
  "end": 48.61,
  "text": "Igloo is Doug's."
 },
 {
  "start": 49.02,
  "end": 49.65,
  "text": "Life is good."
 },
 {
  "start": 50.08,
  "end": 50.96,
  "text": "Then Tax Gull come."
 },
 {
  "start": 51.39,
  "end": 52.19,
  "text": "Property tax."
 },
 {
  "start": 52.6,
  "end": 53.14,
  "text": "Every year."
 },
 {
  "start": 53.58,
  "end": 54.0,
  "text": "Forever."
 },
 {
  "start": 54.41,
  "end": 55.09,
  "text": "Doug own igloo."
 },
 {
  "start": 55.5,
  "end": 56.27,
  "text": "Igloo own Doug."
 },
 {
  "start": 56.69,
  "end": 59.09,
  "text": "Would you rent or buy at seven point four percent?"
 },
 {
  "start": 59.51,
  "end": 60.74,
  "text": "Tell Doug in the comments."
 }
]