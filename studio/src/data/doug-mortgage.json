[
 {
  "start": 0.0,
  "end": 3.49,
  "text": "Why Doug pay one million dollars for a four hundred thousand dollar house?"
 },
 {
  "start": 3.55,
  "end": 4.25,
  "text": "Same house."
 },
 {
  "start": 4.29,
  "end": 4.99,
  "text": "This is Doug."
 },
 {
  "start": 5.05,
  "end": 5.76,
  "text": "Doug want igloo."
 },
 {
  "start": 5.83,
  "end": 6.48,
  "text": "Big igloo."
 },
 {
  "start": 6.55,
  "end": 7.2,
  "text": "With garage."
 },
 {
  "start": 7.26,
  "end": 9.5,
  "text": "Igloo cost four hundred thousand dollars."
 },
 {
  "start": 9.57,
  "end": 10.97,
  "text": "That is forty thousand fish."
 },
 {
  "start": 11.04,
  "end": 11.79,
  "text": "Doug have zero."
 },
 {
  "start": 11.85,
  "end": 12.85,
  "text": "So Doug go to bank."
 },
 {
  "start": 12.91,
  "end": 14.11,
  "text": "Fox lend Doug the fish."
 },
 {
  "start": 14.18,
  "end": 15.37,
  "text": "But Fox want something back."
 },
 {
  "start": 15.44,
  "end": 16.28,
  "text": "Fox want interest."
 },
 {
  "start": 16.35,
  "end": 17.67,
  "text": "Interest is rent for money."
 },
 {
  "start": 17.74,
  "end": 18.67,
  "text": "Doug rent the fish."
 },
 {
  "start": 18.74,
  "end": 21.07,
  "text": "Every year, Fox take seven point four percent."
 },
 {
  "start": 21.14,
  "end": 22.18,
  "text": "Doug pay every month."
 },
 {
  "start": 22.25,
  "end": 23.04,
  "text": "For thirty years."
 },
 {
  "start": 23.11,
  "end": 24.4,
  "text": "Three hundred sixty payments."
 },
 {
  "start": 24.47,
  "end": 25.06,
  "text": "First payment:"
 },
 {
  "start": 25.1,
  "end": 26.94,
  "text": "two thousand four hundred go to Fox."
 },
 {
  "start": 27.01,
  "end": 28.51,
  "text": "Only three hundred go to igloo."
 },
 {
  "start": 28.58,
  "end": 31.95,
  "text": "Ten years later, Doug still owe three hundred forty six thousand."
 },
 {
  "start": 32.02,
  "end": 33.04,
  "text": "This is called a mortgage."
 },
 {
  "start": 33.1,
  "end": 35.35,
  "text": "In old French, mortgage mean death pledge."
 },
 {
  "start": 35.38,
  "end": 35.91,
  "text": "Doug poor."
 },
 {
  "start": 36.24,
  "end": 41.46,
  "text": "In real life, at seven point four percent, Doug pay two thousand seven hundred seventy dollars a month."
 },
 {
  "start": 41.53,
  "end": 42.41,
  "text": "Thirty years later:"
 },
 {
  "start": 42.48,
  "end": 44.01,
  "text": "almost one million dollars."
 },
 {
  "start": 44.08,
  "end": 46.06,
  "text": "Six hundred thousand is just interest."
 },
 {
  "start": 46.08,
  "end": 47.74,
  "text": "All interest go to Larry's bank."
 },
 {
  "start": 47.81,
  "end": 48.45,
  "text": "Larry laugh."
 },
 {
  "start": 48.51,
  "end": 49.56,
  "text": "Doug make last payment."
 },
 {
  "start": 49.63,
  "end": 50.26,
  "text": "Doug is old."
 },
 {
  "start": 50.32,
  "end": 51.28,
  "text": "Igloo is Doug's."
 },
 {
  "start": 51.34,
  "end": 51.99,
  "text": "Life is good."
 },
 {
  "start": 52.06,
  "end": 52.97,
  "text": "Then Tax Gull come."
 },
 {
  "start": 53.04,
  "end": 53.85,
  "text": "Property tax."
 },
 {
  "start": 53.91,
  "end": 54.49,
  "text": "Every year."
 },
 {
  "start": 54.55,
  "end": 55.01,
  "text": "Forever."
 },
 {
  "start": 55.04,
  "end": 55.78,
  "text": "Doug own igloo."
 },
 {
  "start": 55.85,
  "end": 56.65,
  "text": "Igloo own Doug."
 },
 {
  "start": 56.68,
  "end": 58.95,
  "text": "Would you rent or buy at seven point four percent?"
 },
 {
  "start": 59.02,
  "end": 60.23,
  "text": "Tell Doug in the comments."
 }
]