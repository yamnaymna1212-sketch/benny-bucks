[
 {
  "start": 0.0,
  "end": 4.34,
  "text": "Why do rich countries keep lending trillions to broke countries that will never pay it back?"
 },
 {
  "start": 4.37,
  "end": 5.08,
  "text": "This is Doug."
 },
 {
  "start": 5.11,
  "end": 7.97,
  "text": "Doug live on Broke Island. Broke Island is broke country."
 },
 {
  "start": 8.0,
  "end": 9.4,
  "text": "Broke Island have zero fish."
 },
 {
  "start": 9.43,
  "end": 12.74,
  "text": "Rich Island have mountain of fish. Rich Island is rich country."
 },
 {
  "start": 12.77,
  "end": 13.68,
  "text": "Doug want one sled."
 },
 {
  "start": 13.71,
  "end": 15.01,
  "text": "Sled cost 100 fish."
 },
 {
  "start": 15.04,
  "end": 16.88,
  "text": "So Walrus lend Doug 100 fish."
 },
 {
  "start": 16.91,
  "end": 18.93,
  "text": "But Doug must pay back 110 fish."
 },
 {
  "start": 18.96,
  "end": 19.89,
  "text": "Extra 10 fish."
 },
 {
  "start": 19.92,
  "end": 20.98,
  "text": "This is called interest."
 },
 {
  "start": 21.01,
  "end": 21.86,
  "text": "Doug cannot pay."
 },
 {
  "start": 21.89,
  "end": 22.49,
  "text": "Doug poor."
 },
 {
  "start": 22.64,
  "end": 24.92,
  "text": "So Walrus lend Doug 110 more fish."
 },
 {
  "start": 24.95,
  "end": 26.57,
  "text": "Doug pay Walrus with Walrus fish."
 },
 {
  "start": 26.6,
  "end": 27.39,
  "text": "Debt never end."
 },
 {
  "start": 27.42,
  "end": 29.1,
  "text": "Interest never end. Walrus smile."
 },
 {
  "start": 29.13,
  "end": 30.13,
  "text": "This is called rollover."
 },
 {
  "start": 30.16,
  "end": 31.48,
  "text": "So why Walrus keep lending?"
 },
 {
  "start": 31.51,
  "end": 32.22,
  "text": "Three reasons."
 },
 {
  "start": 32.25,
  "end": 34.65,
  "text": "One. If Broke Island sink, Walrus lose all fish."
 },
 {
  "start": 34.68,
  "end": 36.53,
  "text": "Two. Doug buy nets and boats from Walrus."
 },
 {
  "start": 36.56,
  "end": 37.31,
  "text": "Fish come back."
 },
 {
  "start": 37.34,
  "end": 38.36,
  "text": "Three. Doug owe Walrus."
 },
 {
  "start": 38.39,
  "end": 39.58,
  "text": "So Doug listen to Walrus."
 },
 {
  "start": 39.61,
  "end": 40.56,
  "text": "This is called power."
 },
 {
  "start": 40.59,
  "end": 41.18,
  "text": "Doug owned."
 },
 {
  "start": 41.33,
  "end": 41.99,
  "text": "Real life."
 },
 {
  "start": 42.02,
  "end": 46.47,
  "text": "In 2018, the IMF lent Argentina 44 billion dollars."
 },
 {
  "start": 46.5,
  "end": 48.03,
  "text": "Biggest loan in IMF history."
 },
 {
  "start": 48.06,
  "end": 52.36,
  "text": "In 2025, Argentina borrow again. Same Doug. Same Walrus."
 },
 {
  "start": 52.39,
  "end": 53.76,
  "text": "Rich countries do not lose money."
 },
 {
  "start": 53.79,
  "end": 56.26,
  "text": "Rich countries win control. Control better than fish."
 },
 {
  "start": 56.29,
  "end": 57.34,
  "text": "Doug finally get sled."
 },
 {
  "start": 57.37,
  "end": 58.15,
  "text": "Life is good."
 },
 {
  "start": 58.18,
  "end": 59.06,
  "text": "Life is not good."
 },
 {
  "start": 59.09,
  "end": 60.13,
  "text": "Sled belong to Walrus."
 },
 {
  "start": 60.16,
  "end": 62.41,
  "text": "Would you lend money to a friend who never pays back?"
 }
]