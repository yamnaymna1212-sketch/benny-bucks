  "text": "One hundred customers a day."
 },
 {
  "start": 31.94,
  "end": 33.04,
  "text": "Most of them pay with card."
 },
 {
  "start": 33.17,
  "end": 33.39,
  "text": "Beep."
 },
 {
  "start": 33.52,
  "end": 33.73,
  "text": "Beep."
 },
 {
  "start": 33.87,
  "end": 34.08,
  "text": "Beep."
 },
 {
  "start": 34.21,
  "end": 36.91,
  "text": "A few cents... times one hundred beeps... every day."
 },
 {
  "start": 37.04,
  "end": 38.38,
  "text": "That is real money for a small shop."
 },
 {
  "start": 38.52,
  "end": 40.31,
  "text": "So one day... the burger price go up."
 },
 {
  "start": 40.44,
  "end": 40.76,
  "text": "A little."
